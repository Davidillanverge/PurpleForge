#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand (regenerated on every
# `forge generate`). RESTARTS every lab VM in {{ lab_name }} on Proxmox — the
# unstick button for a hung/blocked machine (WinRM wedged, a stuck update, a
# frozen DC promotion). Uses a HARD reset (status/reset), the right action for a
# VM that no longer responds to a graceful reboot. It does NOT roll back state:
# for a pristine lab use `forge reset {{ spec_rel }}` (restores pf-clean).
#
#   PROXMOX_VE_ENDPOINT=... PROXMOX_VE_API_TOKEN=... ./restart.sh
#
# A reset only works on a RUNNING VM; a stopped one is skipped with a warning
# (resume the lab with `forge deploy {{ spec_rel }}`). Needs the same
# PROXMOX_VE_* the deploy used.
# =============================================================================
set -uo pipefail

LAB="{{ lab_name }}"
cd "$(dirname "$0")"
LAB_DIR="$PWD"
ENV_FILE="$LAB_DIR/.pf-proxmox-env"

log()  { printf '\n\033[1;35m== %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mFAIL:\033[0m %s\n' "$*" >&2; exit 1; }

command -v curl >/dev/null 2>&1 || die "missing prerequisite: curl"
# Reuse the credentials deploy.sh persisted (or an exported env). Sourced inside
# this bash script so the token's `!` never triggers zsh history expansion.
if [ -z "${PROXMOX_VE_ENDPOINT:-}" ] && [ -f "$ENV_FILE" ]; then
  set -a; . "$ENV_FILE"; set +a
fi
[ -n "${PROXMOX_VE_ENDPOINT:-}" ] || die "PROXMOX_VE_ENDPOINT not set (export it or fill $ENV_FILE)"
[ -n "${PROXMOX_VE_API_TOKEN:-}" ] || die "PROXMOX_VE_API_TOKEN not set (export it or fill $ENV_FILE)"

K=""; [ "${PROXMOX_VE_INSECURE:-false}" = "true" ] && K="-k"
BASE="${PROXMOX_VE_ENDPOINT%/}"
AUTH="Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN"

members="$(curl -s $K -H "$AUTH" "$BASE/api2/json/pools/$LAB" \
  | python3 -c 'import json,sys
try: d=json.load(sys.stdin).get("data",{})
except Exception: d={}
for m in d.get("members",[]):
    if m.get("type")=="qemu": print(m["node"], m["vmid"])' 2>/dev/null || true)"
[ -n "$members" ] || die "no VMs found in Proxmox pool '$LAB' — is the lab deployed?"

log "Hard-resetting every lab VM"
while read -r node vmid; do
  [ -n "$node" ] && [ -n "$vmid" ] || continue
  # status/reset is a hard reset and fails on a stopped VM — warn and move on.
  status="$(curl -s $K -H "$AUTH" "$BASE/api2/json/nodes/$node/qemu/$vmid/status/current" \
    | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("data",{}).get("status",""))
except Exception: pass' 2>/dev/null || true)"
  if [ "$status" != "running" ]; then
    warn "vm $vmid is not running ($status) — skipping (resume with 'forge deploy {{ spec_rel }}')"; continue
  fi
  echo "  reset vm $vmid"
  curl -s $K -H "$AUTH" -X POST "$BASE/api2/json/nodes/$node/qemu/$vmid/status/reset" >/dev/null 2>&1 \
    || warn "could not reset vm $vmid — reset it manually"
done <<< "$members"
log "RESTART complete — $LAB VMs reset. Give WinRM/SSH ~1-2 min to come back."
