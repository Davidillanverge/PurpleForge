#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand. Tears {{ lab_name }} down to
# COST ZERO (CLAUDE.md invariant #4), without AI, and verifies nothing billable
# is left behind. Handles the one AWS teardown gotcha: the clean-state AMIs (and
# their backing EBS snapshots) are created out of band by deploy.sh, so they are
# NOT in Terraform state and `terraform destroy` leaves them — this script
# deregisters them explicitly.
#
#   ./teardown.sh          # destroy + verify + sweep AMIs + local cleanup
# =============================================================================
set -uo pipefail

LAB="{{ lab_name }}"
REGION="${PF_REGION:-{{ region }}}"
SPEC_REL="{{ spec_rel }}"
STATE_TABLE="purpleforge-tfstate-lock"

cd "$(dirname "$0")"
LAB_DIR="$PWD"
TF_DIR="$LAB_DIR/terraform/aws"
REPO="$(cd "$LAB_DIR/../.." && pwd)"

export AWS_DEFAULT_REGION="$REGION"

log()  { printf '\n\033[1;35m== %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mFAIL:\033[0m %s\n' "$*" >&2; exit 1; }

command -v aws >/dev/null 2>&1 || die "missing prerequisite: aws"
ACCOUNT="$(aws sts get-caller-identity --query Account --output text 2>/dev/null)" \
  || die "AWS credentials not usable (configure env / AWS_PROFILE / 'aws sso login')"
[ -n "$ACCOUNT" ] && [ "$ACCOUNT" != "None" ] \
  || die "AWS credentials not usable (configure env / AWS_PROFILE / 'aws sso login')"

# ---- 0b. re-point backend.hcl at the REAL remote state ---------------------
# `forge generate` rewrites backend.hcl back to a PLACEHOLDER bucket
# (purpleforge-tfstate / us-east-1), so a lab regenerated after deploy would send
# `terraform init` at a bucket that does not exist and `terraform destroy` would
# silently destroy NOTHING (resources keep billing). Re-derive the backend the
# same way deploy.sh mints it (account id + region) so destroy always targets the
# bucket the lab's state actually lives in. We only REWRITE the pointer; the
# bucket/table must already exist from deploy (we never create them here).
ensure_backend() {
  log "0b. Re-point backend.hcl at the real remote state (guard vs generate clobber)"
  local bucket="${PF_STATE_BUCKET:-pf-tfstate-${ACCOUNT}-${REGION}}"
  printf 'bucket         = "%s"\nkey            = "%s.tfstate"\nregion         = "%s"\ndynamodb_table = "%s"\nencrypt        = true\n' \
    "$bucket" "$LAB" "$REGION" "$STATE_TABLE" > "$TF_DIR/backend.hcl"
  echo "  backend.hcl -> bucket=$bucket key=$LAB.tfstate table=$STATE_TABLE"
}

# ---- 1. destroy + verify cost-zero (reuses `forge destroy`) ----------------
# EC2 terminates regardless of power state, so (unlike Azure) no VM-start step is
# needed first. `forge destroy` runs terraform destroy then verify_aws_teardown
# (no resource tagged lab=$LAB remains in $REGION). Returns non-zero if destroy
# never verified clean, so the caller does NOT falsely claim COMPLETE.
destroy() {
  log "1. terraform destroy + cost-zero verification"
  local tries=0
  while true; do
    if PYTHONPATH="$REPO/scripts" python3 -m forge destroy "$REPO/$SPEC_REL" --yes; then
      return 0
    fi
    tries=$((tries+1))
    [ "$tries" -ge 3 ] && return 1
    warn "destroy failed (attempt $tries) — retrying in 15s"
    sleep 15
  done
}

# ---- 2. sweep clean-state AMIs (not in Terraform state) --------------------
# deploy.sh's snapshot_clean registers one AMI per VM (tagged lab=$LAB) out of
# band; deregister each + delete its backing EBS snapshots so they bear no cost.
sweep_amis() {
  log "2. Sweeping clean-state AMIs + their snapshots"
  local amis
  amis="$(aws ec2 describe-images --owners self \
          --filters "Name=tag:lab,Values=$LAB" --query 'Images[].ImageId' --output text 2>/dev/null || true)"
  if [ -z "$amis" ]; then echo "  no clean-state AMIs tagged lab=$LAB — nothing to sweep"; return; fi
  for ami in $amis; do
    local snaps
    snaps="$(aws ec2 describe-images --image-ids "$ami" \
            --query 'Images[].BlockDeviceMappings[].Ebs.SnapshotId' --output text 2>/dev/null || true)"
    echo "  deregister $ami"
    aws ec2 deregister-image --image-id "$ami" >/dev/null 2>&1 || warn "could not deregister $ami"
    for s in $snaps; do
      [ -n "$s" ] && aws ec2 delete-snapshot --snapshot-id "$s" >/dev/null 2>&1 || true
    done
  done
}

# ---- 3. local session state (nothing billable, but left dangling) ----------
local_cleanup() {
  log "3. Local session cleanup"
  docker rm -f pf-ansible >/dev/null 2>&1 || true
  sudo wg-quick down "$LAB_DIR/terraform/aws/ssh_keys/pf-lab.conf" 2>/dev/null \
    || sudo ip link delete pf-lab 2>/dev/null || true
  echo "  removed pf-ansible container + pf-lab WireGuard interface"
}

ensure_backend
if destroy; then destroy_ok=1; else destroy_ok=0; fi
sweep_amis
local_cleanup
if [ "$destroy_ok" != 1 ]; then
  die "terraform destroy did NOT verify cost-zero — resources may STILL BE BILLING.
  Check AWS creds and that the state bucket exists, then re-run ./teardown.sh.
  Verify by hand: aws ec2 describe-instances --filters Name=tag:lab,Values=$LAB --region $REGION"
fi
log "TEARDOWN COMPLETE — $LAB"
echo "verify: aws ec2 describe-instances --filters Name=tag:lab,Values=$LAB --region $REGION  (should list none running)"
echo "NOTE: the shared state bucket + DynamoDB lock table are per-deployer and intentionally kept"
echo "      (they cost ~nothing and are reused by other labs). Remove them by hand if this was your last lab."
