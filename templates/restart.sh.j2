#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand (regenerated on every
# `forge generate`). RESTARTS (reboots) every VM in {{ lab_name }} on
# {{ provider }}/{{ region }} — the unstick button for a hung/blocked machine
# (WinRM wedged, a stuck update, a frozen DC promotion). It does a POWER reboot,
# NOT a snapshot rollback: no disk/AD state is lost. If you want a pristine lab
# instead, use `forge reset {{ spec_rel }}` (restores the clean-state snapshot).
#
#   ./restart.sh            # reboot every VM in the lab
#
# A reboot only works on a RUNNING VM. If a VM is deallocated/stopped, resume the
# lab with `forge deploy {{ spec_rel }}` (deploy.sh starts stopped VMs) instead.
#
# Credentials/subscription resolve exactly like deploy.sh (ARM_SUBSCRIPTION_ID
# or the current `az login`); this script bakes nothing account-specific.
# =============================================================================
set -uo pipefail

LAB="{{ lab_name }}"
REGION="${PF_REGION:-{{ region }}}"

cd "$(dirname "$0")"

log()  { printf '\n\033[1;35m== %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mFAIL:\033[0m %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing prerequisite: $1"; }

preflight() {
  log "0. Preflight"
  for b in az python3; do need "$b"; done
  if [ -z "${ARM_CLIENT_ID:-}" ]; then
    az account show >/dev/null 2>&1 || die "not logged in: run 'az login', or export ARM_CLIENT_ID/ARM_CLIENT_SECRET/ARM_TENANT_ID/ARM_SUBSCRIPTION_ID"
  fi
  SUB="${ARM_SUBSCRIPTION_ID:-$(az account show --query id -o tsv 2>/dev/null)}"
  [ -n "$SUB" ] || die "could not resolve the subscription id (set ARM_SUBSCRIPTION_ID)"
  export ARM_SUBSCRIPTION_ID="$SUB"
  echo "  subscription: $SUB   region: $REGION"
}

# ---- reboot every VM (az-rest /restart; a deallocated VM is skipped with a
#      warning — restart it by resuming the lab via deploy.sh) ----------------
restart_vms() {
  log "1. Rebooting every VM in $LAB"
  local ids
  ids="$(az rest --method get --url "https://management.azure.com/subscriptions/$SUB/resourceGroups/$LAB/providers/Microsoft.Compute/virtualMachines?api-version=2023-07-01" 2>/dev/null \
        | python3 -c 'import json,sys;
try: d=json.load(sys.stdin)
except Exception: d={}
[print(v["id"]) for v in d.get("value",[])]' || true)"
  [ -z "$ids" ] && die "no VMs found in resource group $LAB — is the lab deployed? (nothing to restart)"
  local n=0
  for id in $ids; do
    echo "  restart: ${id##*/}"
    az rest --method post --url "https://management.azure.com${id}/restart?api-version=2023-07-01" >/dev/null 2>&1 \
      || warn "could not restart ${id##*/} (deallocated? resume with 'forge deploy {{ spec_rel }}')"
    n=$((n+1))
  done
  echo "  requested restart on $n VM(s)"
}

preflight
restart_vms
log "RESTART complete — $LAB VMs rebooted. Give WinRM/SSH ~1-2 min to come back."
