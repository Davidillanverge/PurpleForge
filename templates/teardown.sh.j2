#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand. Tears {{ lab_name }} down
# to COST ZERO (CLAUDE.md invariant #4), without AI, and verifies nothing
# billable is left behind. Handles the two teardown gotchas from a real deploy:
# VMs already deallocated by auto_shutdown (block terraform destroy) and
# out-of-band snapshots (block the resource-group delete).
#
#   ./teardown.sh          # destroy + verify + local cleanup
# =============================================================================
set -uo pipefail

LAB="{{ lab_name }}"
# Account/subscription independent: the subscription is resolved below from
# ARM_SUBSCRIPTION_ID or the current `az` login, and the region honours the same
# PF_REGION override deploy.sh uses (default: the spec's region).
REGION="${PF_REGION:-{{ region }}}"
SPEC_REL="{{ spec_rel }}"
BASTION_VM="${LAB}-bastion"

cd "$(dirname "$0")"
LAB_DIR="$PWD"
REPO="$(cd "$LAB_DIR/../.." && pwd)"

log()  { printf '\n\033[1;35m== %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mFAIL:\033[0m %s\n' "$*" >&2; exit 1; }

command -v az >/dev/null 2>&1 || die "missing prerequisite: az"
SUB="${ARM_SUBSCRIPTION_ID:-$(az account show --query id -o tsv 2>/dev/null)}"
[ -n "$SUB" ] || die "could not resolve the subscription id (az login / ARM_SUBSCRIPTION_ID)"
export ARM_SUBSCRIPTION_ID="$SUB"

# ---- 1. start VMs so destroy can delete their extensions -------------------
# auto_shutdown may have deallocated them; terraform destroy deletes each VM
# extension (needs the VM running) and powers off the bastion (needs it not
# already deallocated) — both fail on a deallocated VM. `az rest` avoids the
# broken `az vm` command-loading path some environments hit.
start_vms() {
  log "1. Starting any deallocated VMs (so destroy can proceed)"
  local ids
  ids="$(az rest --method get --url "https://management.azure.com/subscriptions/$SUB/resourceGroups/$LAB/providers/Microsoft.Compute/virtualMachines?api-version=2023-07-01" 2>/dev/null \
        | python3 -c 'import json,sys;
try: d=json.load(sys.stdin)
except Exception: d={}
[print(v["id"]) for v in d.get("value",[])]' || true)"
  [ -z "$ids" ] && { echo "  no VMs found (already destroyed?) — continuing"; return; }
  for id in $ids; do
    az rest --method post --url "https://management.azure.com${id}/start?api-version=2023-07-01" >/dev/null 2>&1 || true
  done
  # brief settle; destroy retries anyway if one is still 'starting'
  sleep 30
}

# ---- 2. destroy + verify cost-zero (reuses `forge destroy`) ----------------
destroy() {
  log "2. terraform destroy + cost-zero verification"
  local tries=0
  until PYTHONPATH="$REPO/scripts" python3 -m forge destroy "$REPO/$SPEC_REL" --yes; do
    tries=$((tries+1))
    [ "$tries" -ge 3 ] && break
    warn "destroy failed (attempt $tries) — starting VMs again and retrying"
    start_vms
  done
}

# ---- 3. clear anything blocking the RG delete (out-of-band snapshots) -------
sweep_rg() {
  log "3. Sweeping stray resources (snapshots not in Terraform state)"
  if az rest --method get --url "https://management.azure.com/subscriptions/$SUB/resourceGroups/$LAB?api-version=2021-04-01" >/dev/null 2>&1; then
    warn "resource group '$LAB' still present — deleting stray snapshots then the RG"
    local snaps
    snaps="$(az rest --method get --url "https://management.azure.com/subscriptions/$SUB/resourceGroups/$LAB/providers/Microsoft.Compute/snapshots?api-version=2023-04-02" 2>/dev/null \
          | python3 -c 'import json,sys;
try: d=json.load(sys.stdin)
except Exception: d={}
[print(v["id"]) for v in d.get("value",[])]' || true)"
    for id in $snaps; do az rest --method delete --url "https://management.azure.com${id}?api-version=2023-04-02" >/dev/null 2>&1 || true; done
    az group delete -n "$LAB" --yes 2>/dev/null || warn "could not delete RG '$LAB' automatically — delete it in the portal"
  else
    echo "  resource group '$LAB' is gone — cost zero confirmed"
  fi
}

# ---- 4. local session state (nothing billable, but left dangling) ----------
local_cleanup() {
  log "4. Local session cleanup"
  docker rm -f pf-ansible >/dev/null 2>&1 || true
  sudo wg-quick down "$LAB_DIR/terraform/azure/ssh_keys/pf-lab.conf" 2>/dev/null \
    || sudo ip link delete pf-lab 2>/dev/null || true
  echo "  removed pf-ansible container + pf-lab WireGuard interface"
}

start_vms
destroy
sweep_rg
local_cleanup
log "TEARDOWN COMPLETE — $LAB (verify: az resource list -g $LAB should 404)"
