#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand. Tears {{ lab_name }} down
# to COST ZERO (CLAUDE.md invariant #4), without AI, and verifies nothing
# billable is left behind. Handles the two teardown gotchas from a real deploy:
# VMs already deallocated by auto_shutdown (block terraform destroy) and
# out-of-band snapshots (block the resource-group delete).
#
#   ./teardown.sh [<generated-lab-dir>]           # asks you to type the lab name
#   ./teardown.sh [<generated-lab-dir>] --force   # no prompt (CI / scripted)
# After a verified destroy it also purges .terraform/, local tfstate, ssh_keys/,
# deploy overlays, terraform-outputs.json and Ansible caches.
# =============================================================================
set -uo pipefail

LAB="{{ lab_name }}"
# Account/subscription independent: the subscription is resolved below from
# ARM_SUBSCRIPTION_ID or the current `az` login, and the region honours the same
# PF_REGION override deploy.sh uses (default: the spec's region).
REGION="${PF_REGION:-{{ region }}}"
SPEC_REL="{{ spec_rel }}"
BASTION_VM="${LAB}-bastion"

{% include "_lifecycle-common.sh.j2" %}
# usage: teardown.sh [<generated-lab-dir>] [--force]
pf_resolve_lab_dir "$@"
TF_DIR="$LAB_DIR/terraform/azure"
# ---- confirmation (destructive, irreversible) -------------------------------
# Type the lab name at the prompt, or pass --force (required when stdin is not
# a terminal, e.g. CI / an agent — never destroys silently by default).
confirm_teardown() {
  if pf_has_flag --force; then
    warn "--force given — skipping confirmation"
    return 0
  fi
  [ -t 0 ] || die "refusing to destroy '$LAB' without confirmation: stdin is not a terminal — re-run with --force"
  printf '
[1;31mThis DESTROYS every resource of lab "%s" (irreversible).[0m
' "$LAB"
  local answer
  read -r -p "Type the lab name to confirm: " answer
  [ "$answer" = "$LAB" ] || die "confirmation did not match '$LAB' — nothing was destroyed"
}

# ---- local residue (only after a VERIFIED destroy) --------------------------
# Terraform plugin cache + lock, any local state files, the deploy-time
# overlays/keys/outputs, the tunnel config and Ansible's temp/cache files. The
# generated sources (*.tf, playbooks, inventory/hosts.yml, secrets) stay, so the
# lab can be redeployed with ./deploy.sh without regenerating.
purge_local() {
  log "Purging local caches, temp inventories and residual state files"
  rm -rf "$TF_DIR/.terraform" "$TF_DIR/.terraform.lock.hcl" \
         "$TF_DIR"/terraform.tfstate "$TF_DIR"/terraform.tfstate.* "$TF_DIR"/*.tfplan \
         "$TF_DIR/ssh_keys" \
         "$TF_DIR/sizes.auto.tfvars.json" "$TF_DIR/region.auto.tfvars.json" \
         "$TF_DIR/images.auto.tfvars.json" "$TF_DIR/template.auto.tfvars.json" \
         "$LAB_DIR/$OUTPUTS_JSON_NAME" "$LAB_DIR/connectivity.json" \
         "$LAB_DIR/ansible/.ansible" "$LAB_DIR/ansible/fact_cache" "$LAB_DIR/ansible/.cache"
  find "$LAB_DIR/ansible" \( -name '*.retry' -o -name '__pycache__' \) -prune -exec rm -rf {} + 2>/dev/null || true
  echo "  removed .terraform/, lock file, local tfstate*, ssh_keys/, deploy overlays, outputs + ansible caches"
}

command -v az >/dev/null 2>&1 || die "missing prerequisite: az"
SUB="${ARM_SUBSCRIPTION_ID:-$(az account show --query id -o tsv 2>/dev/null)}"
[ -n "$SUB" ] || die "could not resolve the subscription id (az login / ARM_SUBSCRIPTION_ID)"
export ARM_SUBSCRIPTION_ID="$SUB"

# ---- 1. start VMs so destroy can delete their extensions -------------------
# auto_shutdown may have deallocated them; terraform destroy deletes each VM
# extension (needs the VM running) and powers off the bastion (needs it not
# already deallocated) — both fail on a deallocated VM. `az rest` avoids the
# broken `az vm` command-loading path some environments hit.
start_vms() {
  log "1. Starting any deallocated VMs (so destroy can proceed)"
  local ids
  ids="$(az rest --method get --url "https://management.azure.com/subscriptions/$SUB/resourceGroups/$LAB/providers/Microsoft.Compute/virtualMachines?api-version=2023-07-01" 2>/dev/null \
        | python3 -c 'import json,sys;
try: d=json.load(sys.stdin)
except Exception: d={}
[print(v["id"]) for v in d.get("value",[])]' || true)"
  [ -z "$ids" ] && { echo "  no VMs found (already destroyed?) — continuing"; return; }
  for id in $ids; do
    az rest --method post --url "https://management.azure.com${id}/start?api-version=2023-07-01" >/dev/null 2>&1 || true
  done
  # brief settle; destroy retries anyway if one is still 'starting'
  sleep 30
}

# ---- 2. destroy + verify cost-zero (reuses `forge destroy`) ----------------
destroy() {
  log "2. terraform destroy + cost-zero verification"
  local tries=0
  while true; do
    if PYTHONPATH="$REPO/scripts" python3 -m forge destroy "$REPO/$SPEC_REL" --out-dir "$LAB_DIR" --yes; then
      return 0
    fi
    tries=$((tries+1))
    [ "$tries" -ge 3 ] && return 1
    warn "destroy failed (attempt $tries) — starting VMs again and retrying"
    start_vms
  done
}

# ---- 3. clear anything blocking the RG delete (out-of-band snapshots) -------
sweep_rg() {
  log "3. Sweeping stray resources (snapshots not in Terraform state)"
  if az rest --method get --url "https://management.azure.com/subscriptions/$SUB/resourceGroups/$LAB?api-version=2021-04-01" >/dev/null 2>&1; then
    warn "resource group '$LAB' still present — deleting stray snapshots then the RG"
    local snaps
    snaps="$(az rest --method get --url "https://management.azure.com/subscriptions/$SUB/resourceGroups/$LAB/providers/Microsoft.Compute/snapshots?api-version=2023-04-02" 2>/dev/null \
          | python3 -c 'import json,sys;
try: d=json.load(sys.stdin)
except Exception: d={}
[print(v["id"]) for v in d.get("value",[])]' || true)"
    for id in $snaps; do az rest --method delete --url "https://management.azure.com${id}?api-version=2023-04-02" >/dev/null 2>&1 || true; done
    az group delete -n "$LAB" --yes 2>/dev/null || warn "could not delete RG '$LAB' automatically — delete it in the portal"
  else
    echo "  resource group '$LAB' is gone — cost zero confirmed"
  fi
}

# ---- 4. local session state (nothing billable, but left dangling) ----------
local_cleanup() {
  log "4. Local session cleanup"
  pf_local_down
}

confirm_teardown
start_vms
destroy || warn "terraform destroy did not verify clean — relying on the resource-group sweep below"
sweep_rg
local_cleanup
# True cost-zero signal for Azure = the resource group no longer exists. Gate the
# COMPLETE banner on it so teardown never claims success while the RG (and its
# billable resources) is still there.
if az rest --method get --url "https://management.azure.com/subscriptions/$SUB/resourceGroups/$LAB?api-version=2021-04-01" >/dev/null 2>&1; then
  die "resource group '$LAB' still exists — teardown did NOT reach cost-zero; resources may be billing. Delete it in the portal or re-run ./teardown.sh"
fi
purge_local
log "TEARDOWN COMPLETE — $LAB (verify: az resource list -g $LAB should 404)"
