# WireGuard bastion — the ONLY host in the lab with a public IP. It exposes a
# single UDP port (WireGuard); no RDP/WinRM ever reaches a Windows host except
# through this tunnel into the VPC, matching CLAUDE.md invariant #1. It also
# doubles as the NAT instance for the private domain subnets (source/dest check
# disabled, cloud-init masquerades their egress) so the Windows hosts stay
# private-IP-only without a paid NAT Gateway — see network.tf.
#
# Shape mirrors the Azure bastion (Ubuntu 22.04, SSH keypair generated by
# Terraform, WireGuard server key generated on first boot so the private key
# never transits Terraform state).

resource "tls_private_key" "bastion_ssh" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "bastion" {
  key_name   = "${var.lab_name}-bastion"
  public_key = tls_private_key.bastion_ssh.public_key_openssh
}

# Canonical's official Ubuntu 22.04 (owner 099720109477), newest build. Resolved
# at plan/apply time so the AMI is always region-correct.
data "aws_ami" "ubuntu" {
  most_recent = true
  owners      = ["099720109477"]

  filter {
    name   = "name"
    values = ["ubuntu/images/hvm-ssd/ubuntu-jammy-22.04-amd64-server-*"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }
}

# Static-private-IP ENI in the management subnet with a public EIP. source/dest
# check is disabled so the instance can forward (NAT) the private subnets' egress
# — the domain route tables point their default route at this ENI (network.tf).
resource "aws_network_interface" "bastion" {
  subnet_id         = aws_subnet.management.id
  private_ips       = [var.jumpbox_private_ip]
  security_groups   = [aws_security_group.management.id]
  source_dest_check = false

  tags = { Name = "${var.lab_name}-bastion-eni" }
}

resource "aws_eip" "bastion" {
  domain = "vpc"
  tags   = { Name = "${var.lab_name}-bastion-ip" }
}

resource "aws_eip_association" "bastion" {
  network_interface_id = aws_network_interface.bastion.id
  allocation_id        = aws_eip.bastion.id
}

resource "aws_instance" "bastion" {
  ami           = data.aws_ami.ubuntu.id
  instance_type = var.bastion_instance_type
  key_name      = aws_key_pair.bastion.key_name

  network_interface {
    network_interface_id = aws_network_interface.bastion.id
    device_index         = 0
  }

  # WireGuard tunnel subnet (10.250.250.0/24) is fixed and deliberately outside
  # any lab's per-lab supernet (10.10-209.0.0/16, see scripts/forge.py
  # stable_octet) so it never collides with a lab's own addressing. The template
  # also sets up egress NAT for the whole VPC supernet so the private domain
  # subnets reach the internet through this host.
  user_data = templatefile("${path.module}/cloudinit/wireguard-bastion.yaml.tpl", {
    wireguard_port = var.wireguard_port
    tunnel_cidr    = "10.250.250.1/24"
    vpc_cidr       = var.supernet
  })

  # Writes next to this module (generated/<lab>/terraform/aws/ssh_keys/), not
  # several ../ up — depth-independent regardless of where forge.py copies the
  # template tree.
  provisioner "local-exec" {
    command = "mkdir -p ${path.module}/ssh_keys && echo '${tls_private_key.bastion_ssh.private_key_pem}' > ${path.module}/ssh_keys/bastion.pem && chmod 600 ${path.module}/ssh_keys/bastion.pem"
  }

  tags = { Name = "${var.lab_name}-bastion" }
}
