# WireGuard bastion — the ONLY host in the lab with a public IP. It exposes a
# single UDP port (WireGuard); no RDP/WinRM ever reaches a Windows host except
# through this tunnel into the management subnet, matching CLAUDE.md invariant #1.
# VM shape follows vendor/GOAD/template/provider/azure/jumpbox.tf (Ubuntu 22.04,
# SSH keypair generated by Terraform), but GOAD's version has no NSG and no
# VPN — here the NSG allows only the WireGuard UDP port (and, opt-in via
# bastion_ssh_allowed_cidrs, direct SSH for initial troubleshooting). The
# rules themselves are inline security_rule blocks on
# azurerm_network_security_group.management in network.tf, not separate
# azurerm_network_security_rule resources here — see that file's comment for
# why (mixing the two management styles on one NSG silently drops rules).

resource "tls_private_key" "bastion_ssh" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

# NOTE: WireGuard keys are raw Curve25519 values (`wg genkey`/`wg pubkey`),
# NOT PEM/OpenSSH keys — tls_private_key cannot generate them. The server
# keypair is instead generated locally on first boot by the cloud-init script
# below, so the private key never transits Terraform state.

resource "azurerm_public_ip" "bastion" {
  name                = "${var.lab_name}-bastion-ip"
  location            = azurerm_resource_group.rg.location
  resource_group_name = azurerm_resource_group.rg.name
  allocation_method   = "Static"
  sku                 = "Standard"
}

resource "azurerm_network_interface" "bastion" {
  name                = "${var.lab_name}-bastion-nic"
  location            = azurerm_resource_group.rg.location
  resource_group_name = azurerm_resource_group.rg.name

  ip_configuration {
    name                          = "internal"
    subnet_id                     = azurerm_subnet.management.id
    private_ip_address_allocation = "Static"
    private_ip_address            = var.jumpbox_private_ip
    public_ip_address_id          = azurerm_public_ip.bastion.id
  }
}

resource "azurerm_linux_virtual_machine" "bastion" {
  name                = "${var.lab_name}-bastion"
  resource_group_name = azurerm_resource_group.rg.name
  location            = azurerm_resource_group.rg.location
  size                = var.bastion_size
  admin_username      = var.jumpbox_username
  network_interface_ids = [
    azurerm_network_interface.bastion.id,
  ]

  disable_password_authentication = true

  admin_ssh_key {
    username   = var.jumpbox_username
    public_key = tls_private_key.bastion_ssh.public_key_openssh
  }

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "Standard_LRS"
  }

  source_image_reference {
    publisher = "Canonical"
    offer     = "0001-com-ubuntu-server-jammy"
    sku       = "22_04-lts-gen2"
    version   = "latest"
  }

  # WireGuard tunnel subnet (10.250.250.0/24) is fixed and deliberately outside
  # any lab's per-lab supernet (10.10-209.0.0/16, see scripts/forge.py
  # stable_octet) so it never collides with a lab's own addressing.
  custom_data = base64encode(templatefile("${path.module}/cloudinit/wireguard-bastion.yaml.tpl", {
    wireguard_port = var.wireguard_port
    tunnel_cidr    = "10.250.250.1/24"
    vnet_cidr      = var.supernet
  }))

  # Writes next to this module (generated/<lab>/terraform/azure/ssh_keys/),
  # not several ../ up — depth-independent regardless of where forge.py
  # generate copies this template tree.
  provisioner "local-exec" {
    command = "mkdir -p ${path.module}/ssh_keys && echo '${tls_private_key.bastion_ssh.private_key_pem}' > ${path.module}/ssh_keys/bastion.pem && chmod 600 ${path.module}/ssh_keys/bastion.pem"
  }
}
