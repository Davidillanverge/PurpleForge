#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand (regenerated on every
# `forge generate`). Deploys {{ lab_name }} on {{ provider }}/{{ region }}
# end-to-end, without AI. Idempotent and safe to re-run: every step checks for
# existing state first, and the terraform/ansible steps retry on transient
# failures (see AWS-DEPLOY-RUNBOOK.md).
#
#   ./deploy.sh                # full deploy
#   ./deploy.sh --sizes-only   # only (re)write the sizes/images auto.tfvars and exit
#
# Prereqs (once per machine): terraform aws docker wireguard-tools openssl curl.
#
# CHOOSE THE AWS ACCOUNT — this script bakes NO credentials; it deploys into
# whatever account you authenticate with here. Any standard credential source
# works (the AWS SDK default chain): an env block
#   export AWS_ACCESS_KEY_ID=... AWS_SECRET_ACCESS_KEY=... AWS_SESSION_TOKEN=...
# an `aws configure` profile (export AWS_PROFILE=<name>), or SSO
#   aws sso login --profile <name>
# Region/instance type are overridable via env so the SAME generated lab deploys
# on anyone's account/region without editing the spec:
#   PF_REGION=<aws-region>     override the region (default: the spec's region)
#   PF_VM_SIZE=<instance-type> force an EC2 instance type for every Windows VM
#   PF_STATE_BUCKET=<name>     override the remote-state S3 bucket name
#
# IMAGE OVERRIDES — redeploy the SAME lab on a different Windows image without
# regenerating. All apply to EVERY Windows VM:
#   PF_OS=<os>                 stock image key: windows-server-2016|2019|2022|2025
#                              (default: each host's os baked at generate time).
#                              Client Windows (windows-10/11) has no stock EC2
#                              AMI — use PF_IMAGE_ID with a BYOL AMI instead.
#   PF_IMAGE_ID=<ami-id>       use a custom AMI (e.g. a golden image with EDR
#                              pre-installed) for every VM; wins over PF_OS
#   PF_IMAGE_SSM=<ssm-path>    an SSM public-parameter path for a Windows image
#                              PurpleForge has no key for (PF_OS names the key)
# The hardening baseline still targets the os chosen at generate time — swap the
# backing image freely, but regenerate the spec to change the CIS/STIG baseline.
# =============================================================================
set -uo pipefail   # deliberately NOT -e: failures are handled explicitly (retries)

LAB="{{ lab_name }}"
REGION="${PF_REGION:-{{ region }}}"
SUPERNET="{{ supernet }}"
DOMAIN="{{ domain }}"
WG_PORT="{{ wireguard_port }}"
STATE_TABLE="purpleforge-tfstate-lock"

cd "$(dirname "$0")"
LAB_DIR="$PWD"
TF_DIR="$LAB_DIR/terraform/aws"
ANS_DIR="$LAB_DIR/ansible"
REPO="$(cd "$LAB_DIR/../.." && pwd)"

export AWS_DEFAULT_REGION="$REGION"

log()  { printf '\n\033[1;35m== %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mFAIL:\033[0m %s\n' "$*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing prerequisite: $1 (see AWS-DEPLOY-RUNBOOK.md step 0)"; }

preflight() {
  log "0. Preflight"
  for b in terraform aws docker wg openssl curl python3; do need "$b"; done
  aws sts get-caller-identity >/dev/null 2>&1 \
    || die "AWS credentials not usable: configure env vars / AWS_PROFILE / 'aws sso login' (AWS-DEPLOY-RUNBOOK.md step 0)"
  ACCOUNT="$(aws sts get-caller-identity --query Account --output text)"
  echo "  account: $ACCOUNT   region: $REGION"
}

# ---- infra secrets (verify present; NEVER minted here) ----------------------
# Every secret under generated/<lab>/ is deterministic from population.seed, so
# `forge generate {{ spec_rel }}` reproduces them all from the spec alone.
# deploy.sh mints NOTHING: it just confirms generate ran.
ensure_secrets() {
  log "0b. Infra secrets (verify generate produced them — never minted here)"
  local tf_secrets="$TF_DIR/secrets.auto.tfvars.json"
  local ans_secrets="$ANS_DIR/inventory/group_vars/all/secrets.yml"
  local pop_secrets="$ANS_DIR/inventory/group_vars/all/population-secrets.yml"
  for f in "$pop_secrets" "$tf_secrets" "$ans_secrets"; do
    [ -f "$f" ] || die "$(basename "$f") missing — every secret is seed-derived; run 'forge generate {{ spec_rel }}' first"
  done
  echo "  all secrets present (seed-derived by generate) — nothing to mint"
}

# ---- state backend (invariant #4: never local) -----------------------------
# One S3 bucket + one DynamoDB lock table per deployer (not per lab); each lab
# is a separate state key. The bucket name is derived from the account id +
# region so it is stable across re-runs and globally unique without a random
# churn. Minted here if absent, then patched into backend.hcl.
bootstrap_state() {
  log "1. Remote Terraform state backend (S3 + DynamoDB lock)"
  local bucket="${PF_STATE_BUCKET:-pf-tfstate-${ACCOUNT}-${REGION}}"

  if ! aws s3api head-bucket --bucket "$bucket" >/dev/null 2>&1; then
    echo "  creating state bucket $bucket"
    if [ "$REGION" = "us-east-1" ]; then
      aws s3api create-bucket --bucket "$bucket" --region "$REGION" >/dev/null \
        || die "could not create state bucket $bucket"
    else
      aws s3api create-bucket --bucket "$bucket" --region "$REGION" \
        --create-bucket-configuration LocationConstraint="$REGION" >/dev/null \
        || die "could not create state bucket $bucket"
    fi
    aws s3api put-bucket-versioning --bucket "$bucket" \
      --versioning-configuration Status=Enabled >/dev/null 2>&1 || true
    aws s3api put-public-access-block --bucket "$bucket" --public-access-block-configuration \
      BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true >/dev/null 2>&1 || true
  else
    echo "  reusing state bucket $bucket"
  fi

  if ! aws dynamodb describe-table --table-name "$STATE_TABLE" >/dev/null 2>&1; then
    echo "  creating lock table $STATE_TABLE"
    aws dynamodb create-table --table-name "$STATE_TABLE" \
      --attribute-definitions AttributeName=LockID,AttributeType=S \
      --key-schema AttributeName=LockID,KeyType=HASH \
      --billing-mode PAY_PER_REQUEST >/dev/null || die "could not create lock table"
    aws dynamodb wait table-exists --table-name "$STATE_TABLE"
  fi

  # Patch backend.hcl (gitignored; recreated here so a fresh clone works).
  printf 'bucket         = "%s"\nkey            = "%s.tfstate"\nregion         = "%s"\ndynamodb_table = "%s"\nencrypt        = true\n' \
    "$bucket" "$LAB" "$REGION" "$STATE_TABLE" > "$TF_DIR/backend.hcl"
  echo "  backend.hcl -> bucket=$bucket table=$STATE_TABLE"
}

# ---- instance sizing + open bastion SSH to just this host -------------------
pick_sizes() {
  log "2. Instance sizing + bastion SSH allow-list"
  local sizes_file="$TF_DIR/sizes.auto.tfvars.json"
  local MY_IP
  MY_IP="$(curl -s https://api.ipify.org || true)"
  [ -n "$MY_IP" ] || warn "could not detect your public IP; bastion SSH will be closed — the WireGuard key exchange needs it, set bastion_ssh_allowed_cidrs by hand or export it"

  SIZE="${PF_VM_SIZE:-}" MY_IP="$MY_IP" ROLES_JSON='{{ roles_json }}' python3 - "$sizes_file" <<'PY'
import json, os, sys
size = os.environ.get("SIZE", "").strip()
ip = os.environ.get("MY_IP", "").strip()
roles = json.loads(os.environ["ROLES_JSON"])
doc = {"bastion_ssh_allowed_cidrs": ([f"{ip}/32"] if ip else [])}
# PF_VM_SIZE (if exported) forces one instance type for every role; otherwise
# windows.tf's per-role local.instance_type_map defaults apply.
if size:
    doc["instance_type_overrides"] = {r: size for r in roles}
    doc["bastion_instance_type"] = "t3.micro"
open(sys.argv[1], "w").write(json.dumps(doc, indent=2) + "\n")
PY
  echo "  wrote $sizes_file (bastion SSH: ${MY_IP:-none}, instance type: ${PF_VM_SIZE:-per-role defaults})"

  # Make the (possibly PF_REGION-overridden) region flow into terraform,
  # overriding the region baked into terraform.tfvars.json at generate time.
  printf '{\n  "region": "%s"\n}\n' "$REGION" > "$TF_DIR/region.auto.tfvars.json"
  echo "  wrote region.auto.tfvars.json (region=$REGION)"
}

# ---- optional image override (PF_OS / PF_IMAGE_ID / PF_IMAGE_SSM) -----------
pick_images() {
  log "2b. Image override (PF_OS / PF_IMAGE_ID / PF_IMAGE_SSM)"
  local images_file="$TF_DIR/images.auto.tfvars.json"
  if [ -z "${PF_OS:-}" ] && [ -z "${PF_IMAGE_ID:-}" ] && [ -z "${PF_IMAGE_SSM:-}" ]; then
    rm -f "$images_file"
    echo "  no image override — using the images baked at generate time"
    return 0
  fi
  ROLES_JSON='{{ roles_json }}' python3 - "$images_file" <<'PY'
import json, os, sys
roles = json.loads(os.environ["ROLES_JSON"])
def env(k):
    v = os.environ.get(k, "").strip()
    return v or None
os_key   = env("PF_OS")
image_id = env("PF_IMAGE_ID")   # an AMI id
ssm_path = env("PF_IMAGE_SSM")  # an SSM public-parameter path for a new os key
doc = {}
# A custom SSM path defines/overrides an os->ssm-parameter entry, keyed by PF_OS
# (else a synthetic key), and remaps every role onto it.
if ssm_path:
    key = os_key or "__pf_custom_ssm__"
    doc["os_ssm_overrides"] = {key: ssm_path}
    doc["os_overrides"] = {r: key for r in roles}
# A stock os key (no custom ssm) just remaps every role to it.
if os_key and "os_overrides" not in doc:
    doc["os_overrides"] = {r: os_key for r in roles}
# A custom AMI wins over any os for every role.
if image_id:
    doc["image_id_overrides"] = {r: image_id for r in roles}
open(sys.argv[1], "w").write(json.dumps(doc, indent=2) + "\n")
print("  wrote " + sys.argv[1] + ": " + json.dumps(doc))
PY
}

# ---- terraform apply --------------------------------------------------------
tf_apply() {
  log "3. terraform init + apply"
  terraform -chdir="$TF_DIR" init -backend-config=backend.hcl -input=false -reconfigure \
    || die "terraform init failed"
  local tries=0 max=4
  until terraform -chdir="$TF_DIR" apply -auto-approve -input=false; do
    tries=$((tries+1))
    [ "$tries" -ge "$max" ] && die "terraform apply still failing after $tries tries — see the error above (AWS-DEPLOY-RUNBOOK.md step 4)"
    warn "apply failed (attempt $tries/$max) — retrying in 15s (transient API/eventual-consistency lag is expected)"
    sleep 15
  done
  echo "  apply complete"
}

# ---- start any stopped VMs (redeploying a lab auto_shutdown stopped) --------
start_vms() {
  log "3b. Starting any stopped VMs"
  local ids
  ids="$(aws ec2 describe-instances \
          --filters "Name=tag:lab,Values=$LAB" "Name=instance-state-name,Values=stopped,stopping" \
          --query 'Reservations[].Instances[].InstanceId' --output text 2>/dev/null || true)"
  [ -z "$ids" ] && { echo "  no stopped VMs — continuing"; return; }
  echo "  starting: $ids"
  aws ec2 start-instances --instance-ids $ids >/dev/null 2>&1 || true
  # brief settle so WinRM/SSH have a chance to come up before wg_up/ansible probe
  sleep 30
}

# ---- WireGuard tunnel (the only path into the lab) --------------------------
wg_up() {
  log "4. WireGuard tunnel to the bastion"
  mkdir -p "$TF_DIR/ssh_keys"
  cd "$TF_DIR"
  if [ ! -s ssh_keys/bastion.pem ]; then
    terraform -chdir="$TF_DIR" show -json | python3 -c '
import json,sys
d=json.load(sys.stdin)
for r in d.get("values",{}).get("root_module",{}).get("resources",[]):
    if r.get("address")=="tls_private_key.bastion_ssh":
        sys.stdout.write(r["values"]["private_key_pem"])
' > ssh_keys/bastion.pem
    chmod 600 ssh_keys/bastion.pem
  fi
  local BASTION_IP CLIENT_PUB SERVER_PUB
  BASTION_IP="$(terraform -chdir="$TF_DIR" output -raw bastion_public_ip)"
  [ -n "$BASTION_IP" ] || die "no bastion_public_ip output — did apply finish?"
  [ -f ssh_keys/client_wg.key ] || wg genkey | tee ssh_keys/client_wg.key | wg pubkey > ssh_keys/client_wg.pub
  CLIENT_PUB="$(cat ssh_keys/client_wg.pub)"
  # SSH user is 'ubuntu' — the Canonical AMI's built-in default user, into whose
  # authorized_keys EC2 injects the aws_key_pair. (Azure/Proxmox log in as
  # 'purpleforge' because their bastion image is configured with that admin user;
  # on AWS the stock Ubuntu AMI fixes it to 'ubuntu'.)
  local SSH="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=20 -i ssh_keys/bastion.pem ubuntu@$BASTION_IP"
  local i=0; until $SSH true 2>/dev/null; do i=$((i+1)); [ "$i" -ge 20 ] && die "bastion SSH never came up at $BASTION_IP (check bastion_ssh_allowed_cidrs includes your IP)"; sleep 15; done
  # sshd answers well before cloud-init finishes installing wireguard-tools and
  # generating the server keypair — wait for it, or SERVER_PUB comes back empty
  # and wg-quick fails with "Line unrecognized: PublicKey=".
  echo "  waiting for bastion cloud-init (wireguard-tools + server keypair)..."
  $SSH 'sudo cloud-init status --wait >/dev/null 2>&1; true'
  SERVER_PUB="$($SSH 'sudo cat /etc/wireguard/publickey 2>/dev/null')"
  [ -n "$SERVER_PUB" ] || die "bastion has no /etc/wireguard/publickey — cloud-init failed? check: ssh ... 'sudo tail -50 /var/log/cloud-init-output.log'"
  $SSH "sudo wg set wg0 peer $CLIENT_PUB allowed-ips 10.250.250.2/32 && sudo wg-quick save wg0" \
    || die "could not register the client peer on the bastion's wg0"
  cat > ssh_keys/pf-lab.conf <<EOF
[Interface]
PrivateKey = $(cat ssh_keys/client_wg.key)
Address = 10.250.250.2/32
[Peer]
PublicKey = $SERVER_PUB
Endpoint = $BASTION_IP:$WG_PORT
AllowedIPs = 10.250.250.0/24, $SUPERNET
PersistentKeepalive = 25
EOF
  chmod 600 ssh_keys/pf-lab.conf
  sudo wg-quick down "$TF_DIR/ssh_keys/pf-lab.conf" 2>/dev/null || true
  sudo wg-quick up "$TF_DIR/ssh_keys/pf-lab.conf" || die "wg-quick up failed"
  cd "$LAB_DIR"
  echo "  tunnel up (bastion $BASTION_IP:$WG_PORT)"
}

# ---- Ansible control node in Docker (Python 3.10 GOAD needs) ----------------
ansible_up() {
  log "5. Ansible control node (Docker, --network host to see the tunnel)"
  docker rm -f pf-ansible >/dev/null 2>&1 || true
  docker run -d --name pf-ansible --network host -v "$REPO:/repo" \
    -w "/repo/generated/$LAB/ansible" python:3.10-slim sleep infinity >/dev/null \
    || die "could not start the pf-ansible container"
  docker exec pf-ansible bash -c "pip install --quiet ansible-core==2.12.6 pywinrm rich psutil Jinja2 pyyaml ansible_runner" \
    || die "pip install in pf-ansible failed"
  docker exec pf-ansible bash -c "ansible-galaxy collection install ansible.windows:1.11.0 community.windows:1.11.0 chocolatey.chocolatey" \
    || die "ansible-galaxy collection install failed"
  docker exec pf-ansible python3 -c "import urllib.request; urllib.request.urlretrieve('https://galaxy.ansible.com/api/v3/plugin/ansible/content/published/collections/artifacts/community-general-6.6.2.tar.gz','/tmp/cg.tar.gz')" \
    && docker exec pf-ansible ansible-galaxy collection install /tmp/cg.tar.gz || warn "community.general install failed (only some roles need it) — continuing"
}

# ---- provision AD (site.yml enforces hardening-before-vulns order) ----------
run_site() {
  log "6. Provision AD -> population -> hardening -> vuln injection (site.yml)"
  # Telemetry (DETECT) backend creds are operator-provided + deploy-time only
  # (never in the spec). Validate the ones this lab's telemetry agents need and
  # pass them to site.yml as extra-vars (expanded on the host, so values travel as
  # literal args — no env forwarding into the container needed).
  TELEMETRY_EV=""
{% if telemetry_elastic %}
  [ -n "${PF_FLEET_URL:-}" ] || die "telemetry: PF_FLEET_URL unset (operator Fleet endpoint)"
  [ -n "${PF_FLEET_ENROLLMENT_TOKEN:-}" ] || die "telemetry: PF_FLEET_ENROLLMENT_TOKEN unset"
  [ -n "${PF_ELASTIC_AGENT_VERSION:-}" ] || die "telemetry: PF_ELASTIC_AGENT_VERSION unset (match your Elastic stack)"
  TELEMETRY_EV="$TELEMETRY_EV -e pf_fleet_url=$PF_FLEET_URL -e pf_fleet_enrollment_token=$PF_FLEET_ENROLLMENT_TOKEN -e pf_elastic_agent_version=$PF_ELASTIC_AGENT_VERSION"
  [ -n "${PF_FLEET_INSECURE:-}" ] && TELEMETRY_EV="$TELEMETRY_EV -e pf_fleet_insecure=$PF_FLEET_INSECURE"
{% endif %}
{% if telemetry_warp %}
  [ -n "${PF_CLOUDFLARE_TEAM:-}" ] || die "telemetry: PF_CLOUDFLARE_TEAM unset (Zero Trust org slug)"
  [ -n "${PF_CLOUDFLARE_ENROLL_CLIENT_ID:-}" ] || die "telemetry: PF_CLOUDFLARE_ENROLL_CLIENT_ID unset"
  [ -n "${PF_CLOUDFLARE_ENROLL_CLIENT_SECRET:-}" ] || die "telemetry: PF_CLOUDFLARE_ENROLL_CLIENT_SECRET unset"
  TELEMETRY_EV="$TELEMETRY_EV -e pf_cloudflare_team=$PF_CLOUDFLARE_TEAM -e pf_cloudflare_enroll_client_id=$PF_CLOUDFLARE_ENROLL_CLIENT_ID -e pf_cloudflare_enroll_client_secret=$PF_CLOUDFLARE_ENROLL_CLIENT_SECRET"
{% endif %}
{% if bas_caldera %}
  # BAS (adversary emulation) — MITRE Caldera sandcat beacon. The Caldera server is
  # operator-run: a cloud server (agents reach it via bastion egress) or a local
  # Kali server (set PF_CALDERA_SERVER to the Kali address reachable over the
  # WireGuard tunnel, e.g. http://10.x.x.x:8888). Creds are deploy-time only.
  [ -n "${PF_CALDERA_SERVER:-}" ] || die "bas: PF_CALDERA_SERVER unset (operator Caldera URL, e.g. http://host:8888 — cloud or local Kali over the tunnel)"
  [ -n "${PF_CALDERA_GROUP:-}" ] || die "bas: PF_CALDERA_GROUP unset (sandcat agent group, e.g. red)"
  TELEMETRY_EV="$TELEMETRY_EV -e pf_caldera_server=$PF_CALDERA_SERVER -e pf_caldera_group=$PF_CALDERA_GROUP"
  [ -n "${PF_CALDERA_API_KEY:-}" ] && TELEMETRY_EV="$TELEMETRY_EV -e pf_caldera_api_key=$PF_CALDERA_API_KEY"
{% endif %}
  local i=0
  until docker exec -w "/repo/generated/$LAB/ansible" pf-ansible ansible all -i inventory/hosts.yml -m ansible.windows.win_ping >/dev/null 2>&1; do
    i=$((i+1)); [ "$i" -ge 20 ] && { warn "win_ping never went green for every host — running site.yml anyway (it will retry)"; break; }
    echo "  waiting for WinRM on all hosts ($i)..."; sleep 20
  done
  local tries=0 max=6
  until docker exec -w "/repo/generated/$LAB/ansible" pf-ansible ansible-playbook -i inventory/hosts.yml playbooks/site.yml $TELEMETRY_EV; do
    tries=$((tries+1))
    [ "$tries" -ge "$max" ] && die "site.yml still failing after $tries runs — inspect the error above (AWS-DEPLOY-RUNBOOK.md step 7)"
    warn "site.yml failed (attempt $tries/$max) — re-running (idempotent; picks up where it left off)"
    docker exec pf-ansible true >/dev/null 2>&1 || { warn "pf-ansible container is gone — recreating it before the next attempt"; ansible_up; }
    sleep 15
  done
  echo "  provisioning complete"
}

# ---- clean-state snapshot (CLAUDE.md deploy order: LAST, AFTER hardening+vulns,
# BEFORE any attack). One AMI per instance, named "<lab>-<vm>-clean" (the name
# `forge reset` / lifecycle.clean_snapshot_name() look for), created --no-reboot
# so the running lab is not disturbed. Best-effort: failure never fails deploy.
# teardown.sh deregisters these + their snapshots, so they add no leftover cost.
snapshot_clean() {
  [ "${PF_SNAPSHOT:-1}" = "1" ] || { log "7. Clean-state snapshot (skipped: PF_SNAPSHOT=0)"; return 0; }
  log "7. Clean-state snapshot (post-hardening+vulns, pre-attack)"
  local rows
  rows="$(aws ec2 describe-instances --filters "Name=tag:lab,Values=$LAB" \
          --query 'Reservations[].Instances[].[InstanceId,Tags[?Key==`Name`]|[0].Value]' --output text 2>/dev/null || true)"
  [ -z "$rows" ] && { warn "no instances found — skipping snapshot"; return 0; }
  printf '%s\n' "$rows" | while IFS=$'\t' read -r id name; do
    [ -n "$id" ] || continue
    [ -n "$name" ] || name="$id"
    # The bastion is disposable infra, not part of the clean lab state `forge
    # reset` restores — skip it (also avoids a doubled "<lab>-<lab>-bastion-clean"
    # AMI name, since its Name tag already carries the lab prefix).
    [ "$name" = "${LAB}-bastion" ] && { echo "  skip bastion (disposable infra)"; continue; }
    local snap="${LAB}-${name}-clean"
    echo "  snapshot $name -> AMI $snap"
    # Capture stdout+stderr so a failure surfaces the ACTUAL AWS error instead of
    # an opaque "could not snapshot" (which hid the cause across live runs). On
    # success $out is the new AMI id, harmlessly ignored.
    local out
    if ! out="$(aws ec2 create-image --instance-id "$id" --name "$snap" --no-reboot \
      --tag-specifications "ResourceType=image,Tags=[{Key=purpleforge,Value=clean-state},{Key=lab,Value=$LAB}]" \
      "ResourceType=snapshot,Tags=[{Key=purpleforge,Value=clean-state},{Key=lab,Value=$LAB}]" 2>&1)"; then
      warn "could not snapshot $name (continuing) — AWS said: ${out} — take it manually or re-run this step"
    fi
  done
  echo "  clean-state AMI(s) requested — reset with: forge reset {{ spec_rel }}"
}

# ---- provisioning guard -----------------------------------------------------
# Tag every lab instance pf:provisioning=true for the duration of the deploy.
# The auto-shutdown Lambda skips instances carrying this tag, so a long first
# deploy that crosses the daily cron time isn't stopped underneath Ansible
# (AWS-DEPLOY-RUNBOOK symptom: hosts go UNREACHABLE mid site.yml, State=stopped).
_lab_instance_ids() {
  aws ec2 describe-instances \
    --filters "Name=tag:lab,Values=$LAB" "Name=instance-state-name,Values=pending,running,stopping,stopped" \
    --query 'Reservations[].Instances[].InstanceId' --output text 2>/dev/null || true
}
mark_provisioning() {
  local ids; ids="$(_lab_instance_ids)"
  [ -z "$ids" ] && return 0
  aws ec2 create-tags --resources $ids --tags "Key=pf:provisioning,Value=true" >/dev/null 2>&1 \
    || warn "could not set pf:provisioning tag (auto-shutdown may fire mid-deploy)"
  echo "  provisioning guard on (auto-shutdown will skip these instances until deploy completes)"
}
unmark_provisioning() {
  local ids; ids="$(_lab_instance_ids)"
  [ -z "$ids" ] && return 0
  aws ec2 delete-tags --resources $ids --tags "Key=pf:provisioning" >/dev/null 2>&1 \
    || warn "could not clear pf:provisioning tag — remove it by hand or auto-shutdown won't stop these"
  echo "  provisioning guard off (auto-shutdown now manages these instances)"
}

main() {
  preflight
  ensure_secrets
  bootstrap_state
  pick_sizes
  pick_images
  if [ "${1:-}" = "--sizes-only" ]; then log "done (--sizes-only)"; exit 0; fi
  tf_apply
  start_vms
  mark_provisioning
  wg_up
  ansible_up
  run_site
  snapshot_clean
  unmark_provisioning
  log "DEPLOY COMPLETE — $LAB"
  cat <<EOF

Next steps (no AI):
  # confirm the injected vulnerabilities are applied + exploitable:
  PYTHONPATH="$REPO/scripts" python3 -m forge validate "{{ spec_rel }}" --run
  # verify the live domain matches the plan (users/groups/NT hashes):
  PYTHONPATH="$REPO/scripts" python3 -m forge ad-inventory "{{ spec_rel }}"

When finished, tear everything down to cost-zero:
  ./teardown.sh
EOF
}

main "$@"
