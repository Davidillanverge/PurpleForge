#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand. Tears {{ lab_name }} down
# on Proxmox VE, without AI: destroys every VM in the lab's pool, verifies the
# pool is empty, and removes the auto_shutdown cron + local session state.
#
#   ./teardown.sh [<generated-lab-dir>]           # asks you to type the lab name
#   ./teardown.sh [<generated-lab-dir>] --force   # no prompt (CI / scripted)
# After a verified destroy it also purges .terraform/, local tfstate, ssh_keys/,
# deploy overlays, terraform-outputs.json and Ansible caches.
#
# Needs the same PROXMOX_VE_ENDPOINT / PROXMOX_VE_API_TOKEN env as deploy.sh.
# =============================================================================
set -uo pipefail

LAB="{{ lab_name }}"
SPEC_REL="{{ spec_rel }}"

{% include "_lifecycle-common.sh.j2" %}
# usage: teardown.sh [<generated-lab-dir>] [--force]
pf_resolve_lab_dir "$@"
TF_DIR="$LAB_DIR/terraform/proxmox"
ENV_FILE="$LAB_DIR/.pf-proxmox-env"
# ---- confirmation (destructive, irreversible) -------------------------------
# Type the lab name at the prompt, or pass --force (required when stdin is not
# a terminal, e.g. CI / an agent — never destroys silently by default).
confirm_teardown() {
  if pf_has_flag --force; then
    warn "--force given — skipping confirmation"
    return 0
  fi
  [ -t 0 ] || die "refusing to destroy '$LAB' without confirmation: stdin is not a terminal — re-run with --force"
  printf '
[1;31mThis DESTROYS every resource of lab "%s" (irreversible).[0m
' "$LAB"
  local answer
  read -r -p "Type the lab name to confirm: " answer
  [ "$answer" = "$LAB" ] || die "confirmation did not match '$LAB' — nothing was destroyed"
}

# ---- local residue (only after a VERIFIED destroy) --------------------------
# Terraform plugin cache + lock, any local state files, the deploy-time
# overlays/keys/outputs, the tunnel config and Ansible's temp/cache files. The
# generated sources (*.tf, playbooks, inventory/hosts.yml, secrets) stay, so the
# lab can be redeployed with ./deploy.sh without regenerating.
purge_local() {
  log "Purging local caches, temp inventories and residual state files"
  rm -rf "$TF_DIR/.terraform" "$TF_DIR/.terraform.lock.hcl" \
         "$TF_DIR"/terraform.tfstate "$TF_DIR"/terraform.tfstate.* "$TF_DIR"/*.tfplan \
         "$TF_DIR/ssh_keys" \
         "$TF_DIR/sizes.auto.tfvars.json" "$TF_DIR/region.auto.tfvars.json" \
         "$TF_DIR/images.auto.tfvars.json" "$TF_DIR/template.auto.tfvars.json" \
         "$LAB_DIR/$OUTPUTS_JSON_NAME" "$LAB_DIR/connectivity.json" \
         "$LAB_DIR/ansible/.ansible" "$LAB_DIR/ansible/fact_cache" "$LAB_DIR/ansible/.cache"
  find "$LAB_DIR/ansible" \( -name '*.retry' -o -name '__pycache__' \) -prune -exec rm -rf {} + 2>/dev/null || true
  echo "  removed .terraform/, lock file, local tfstate*, ssh_keys/, deploy overlays, outputs + ansible caches"
}

command -v terraform >/dev/null 2>&1 || die "missing prerequisite: terraform"
# Reuse the credentials deploy.sh persisted (or an exported env). Sourced inside
# this bash script so the token's `!` never triggers zsh history expansion.
if [ -z "${PROXMOX_VE_ENDPOINT:-}" ] && [ -f "$ENV_FILE" ]; then
  set -a; . "$ENV_FILE"; set +a
fi
[ -n "${PROXMOX_VE_ENDPOINT:-}" ] || die "PROXMOX_VE_ENDPOINT is not set (export it or fill $ENV_FILE)"
[ -n "${PROXMOX_VE_API_TOKEN:-}" ] || die "PROXMOX_VE_API_TOKEN is not set (export it or fill $ENV_FILE)"

# ---- 1. remove the auto_shutdown cron first (it points at the pool we destroy)
remove_cron() {
  log "1. Removing auto_shutdown cron + local helper"
  local helper="$LAB_DIR/pf-autoshutdown.sh"
  if command -v crontab >/dev/null 2>&1; then
    crontab -l 2>/dev/null | grep -vF "$helper" | crontab - 2>/dev/null || true
  fi
  rm -f "$helper"
  echo "  cron + helper removed"
}

# ---- 2. terraform destroy (every VM/pool/firewall this lab created) ---------
destroy() {
  log "2. terraform destroy"
  terraform -chdir="$TF_DIR" init -input=false >/dev/null 2>&1 || true
  local tries=0 par="$PF_TF_PARALLELISM"
  # -refresh=false: the bpg provider's pre-destroy REFRESH reads each VM through
  # the QEMU guest agent and BLOCKS on it (the same agent-wait that slows apply) —
  # on teardown that hangs indefinitely. We're tearing everything down anyway, so
  # destroy straight from the recorded state without re-reading the guests.
  while true; do
    if terraform -chdir="$TF_DIR" destroy -refresh=false -auto-approve -input=false -parallelism="$par"; then
      return 0
    fi
    tries=$((tries+1))
    [ "$tries" -ge 3 ] && { warn "destroy still failing after $tries tries — check the Proxmox UI for leftover VMs in pool '$LAB'"; return 1; }
    warn "destroy failed (attempt $tries) — retrying in 15s"
    par="$PF_TF_RETRY_PARALLELISM"
    sleep 15
  done
}

# ---- 3. verify the pool holds no VMs (nothing left running/consuming) -------
verify() {
  log "3. Verifying pool '$LAB' is empty"
  local K="" BASE AUTH left
  [ "${PROXMOX_VE_INSECURE:-false}" = "true" ] && K="-k"
  BASE="${PROXMOX_VE_ENDPOINT%/}"
  AUTH="Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN"
  left="$(curl -s $K -H "$AUTH" "$BASE/api2/json/pools/$LAB" 2>/dev/null \
    | python3 -c 'import json,sys
try: d=json.load(sys.stdin).get("data",{})
except Exception: d={}
print(len([m for m in d.get("members",[]) if m.get("type")=="qemu"]))' 2>/dev/null || echo "?")"
  if [ "$left" = "0" ]; then
    echo "  pool '$LAB' has no VMs left — teardown complete"
    return 0
  elif [ "$left" = "?" ]; then
    warn "could not query the pool (pool already deleted, or API unreachable) — verify manually in the Proxmox UI"
    return 0
  else
    warn "$left VM(s) still in pool '$LAB' — delete them manually in the Proxmox UI"
    return 1
  fi
}

# ---- 4. local session state (tunnel + ansible container) -------------------
local_cleanup() {
  log "4. Local session cleanup"
  pf_local_down
}

confirm_teardown
remove_cron
destroy_ok=0
destroy && destroy_ok=1 || warn "terraform destroy reported failure — verifying the pool directly"
verify_ok=0; verify && verify_ok=1
local_cleanup
# The local tfstate is the ONLY record of these VMs (local backend): purge it
# only when destroy itself succeeded AND the pool verified empty.
if [ "$destroy_ok" = 1 ] && [ "$verify_ok" = 1 ]; then
  purge_local
elif [ "$verify_ok" = 1 ]; then
  warn "destroy did not report success — KEEPING terraform.tfstate and caches; re-run ./teardown.sh once the API is reachable"
fi
[ "$verify_ok" = 1 ] || die "pool '$LAB' still has VM(s) — teardown did NOT reach cost-zero; delete them in the Proxmox UI or re-run ./teardown.sh"
# KEEP .pf-proxmox-env (it is gitignored, holds no lab state, and a fresh
# `forge generate` wipes generated/ anyway) so a later redeploy of this lab
# re-sources the same credentials with nothing to retype. Previously this was
# rm'd here, which forced re-supplying the token on every redeploy.
log "TEARDOWN COMPLETE — $LAB"
