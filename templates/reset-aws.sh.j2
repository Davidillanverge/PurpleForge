#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand. Resets {{ lab_name }} to its
# CLEAN-STATE snapshot (the AMI taken at the end of deploy.sh, AFTER hardening +
# vuln injection but BEFORE any attack — CLAUDE.md deploy order). Use it between
# exercises so every run starts from the same pristine, fully-instrumented lab.
#
# Per VM it swaps the root EBS volume back to a fresh one made from the
# "<lab>-<vm>-clean" AMI's backing snapshot (the AWS analogue of Azure's
# OS-disk swap):
#   stop -> detach root -> create volume from the AMI snapshot -> attach as
#   root -> start -> delete the replaced volume.
#
# NOTE: rendered from the documented AWS procedure; like verify.yml it has NOT
# been exercised against a live account in this repo — treat the first run with
# the same skepticism the project applies elsewhere.
#
#   ./reset.sh            # roll every VM back to its clean-state AMI
# =============================================================================
set -uo pipefail

LAB="{{ lab_name }}"
REGION="${PF_REGION:-{{ region }}}"

export AWS_DEFAULT_REGION="$REGION"

log()  { printf '\n\033[1;35m== %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mFAIL:\033[0m %s\n' "$*" >&2; exit 1; }

command -v aws >/dev/null 2>&1 || die "missing prerequisite: aws"
aws sts get-caller-identity >/dev/null 2>&1 || die "AWS credentials not usable (configure env / AWS_PROFILE / 'aws sso login')"

# All instances in the lab, with id | Name | AZ | root device | current root volume id.
rows="$(aws ec2 describe-instances --filters "Name=tag:lab,Values=$LAB" \
        --query 'Reservations[].Instances[].[InstanceId,Tags[?Key==`Name`]|[0].Value,Placement.AvailabilityZone,RootDeviceName,BlockDeviceMappings[?DeviceName==RootDeviceName]|[0].Ebs.VolumeId]' \
        --output text 2>/dev/null || true)"
[ -n "$rows" ] || die "no instances tagged lab=$LAB — is the lab deployed?"

printf '%s\n' "$rows" | while IFS=$'\t' read -r id name az rootdev oldvol; do
  [ -n "$id" ] || continue
  [ -n "$name" ] || name="$id"
  # The bastion isn't snapshotted (disposable infra) — don't try to reset it.
  [ "$name" = "${LAB}-bastion" ] && continue
  snap_ami="${LAB}-${name}-clean"
  log "reset $name  (from AMI $snap_ami)"

  # The clean AMI's backing root snapshot.
  snapid="$(aws ec2 describe-images --owners self --filters "Name=name,Values=$snap_ami" \
            --query 'Images[0].BlockDeviceMappings[?DeviceName==`'"$rootdev"'`]|[0].Ebs.SnapshotId' --output text 2>/dev/null || true)"
  if [ -z "$snapid" ] || [ "$snapid" = "None" ]; then
    warn "no clean-state AMI '$snap_ami' (or no root snapshot) — skipping $name (was the deploy snapshot step run?)"; continue
  fi

  echo "  1) stop";              aws ec2 stop-instances --instance-ids "$id" >/dev/null 2>&1 \
    && aws ec2 wait instance-stopped --instance-ids "$id" || { warn "stop failed for $name"; continue; }
  echo "  2) detach root vol";   aws ec2 detach-volume --volume-id "$oldvol" >/dev/null 2>&1 \
    && aws ec2 wait volume-available --volume-ids "$oldvol" || { warn "detach failed for $name"; continue; }
  echo "  3) volume from snap";  newvol="$(aws ec2 create-volume --availability-zone "$az" --snapshot-id "$snapid" \
            --tag-specifications "ResourceType=volume,Tags=[{Key=lab,Value=$LAB}]" --query VolumeId --output text 2>/dev/null || true)"
  [ -n "$newvol" ] && [ "$newvol" != "None" ] || { warn "volume create failed for $name — reattaching old root"; aws ec2 attach-volume --volume-id "$oldvol" --instance-id "$id" --device "$rootdev" >/dev/null 2>&1 || true; continue; }
  aws ec2 wait volume-available --volume-ids "$newvol"
  echo "  4) attach as root";    aws ec2 attach-volume --volume-id "$newvol" --instance-id "$id" --device "$rootdev" >/dev/null 2>&1 \
    || { warn "attach failed for $name"; continue; }
  echo "  5) start";             aws ec2 start-instances --instance-ids "$id" >/dev/null 2>&1 || warn "could not start $name — start it manually"
  # 6) reclaim the replaced volume (best-effort; never blocks the reset)
  [ -n "$oldvol" ] && aws ec2 delete-volume --volume-id "$oldvol" >/dev/null 2>&1 || true
  echo "  done: $name now on a fresh root volume from $snap_ami"
done

log "RESET COMPLETE — $LAB back to clean state (verify over the tunnel before re-attacking)"
