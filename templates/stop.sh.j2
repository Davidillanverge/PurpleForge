#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand (regenerated on every
# `forge generate`). STOPS {{ lab_name }} on {{ provider }}/{{ region }} WITHOUT
# destroying it and WITHOUT touching Terraform state: every VM in resource
# group $LAB is first powered off GRACEFULLY (guest OS shutdown, so the DCs
# close AD cleanly) and then DEALLOCATED (compute released — you keep paying
# only for disks). The bastion's static public IP, disks, AD state and the
# clean-state snapshots all survive.
#
#   ./stop.sh [<generated-lab-dir>]
#
# Idempotent: an already-deallocated lab exits 0. Bring it back with ./start.sh
# (`forge start {{ spec_rel }}`). Credentials resolve like deploy.sh.
# =============================================================================
set -uo pipefail

LAB="{{ lab_name }}"
REGION="${PF_REGION:-{{ region }}}"
API="api-version=2023-07-01"

{% include "_lifecycle-common.sh.j2" %}
pf_resolve_lab_dir "$@"
TF_DIR="$LAB_DIR/terraform/azure"

preflight() {
  log "0. Preflight"
  for b in az python3; do need "$b"; done
  if [ -z "${ARM_CLIENT_ID:-}" ]; then
    az account show >/dev/null 2>&1 || die "not logged in: run 'az login', or export ARM_CLIENT_ID/ARM_CLIENT_SECRET/ARM_TENANT_ID/ARM_SUBSCRIPTION_ID"
  fi
  SUB="${ARM_SUBSCRIPTION_ID:-$(az account show --query id -o tsv 2>/dev/null)}"
  [ -n "$SUB" ] || die "could not resolve the subscription id (set ARM_SUBSCRIPTION_ID)"
  export ARM_SUBSCRIPTION_ID="$SUB"
  echo "  subscription: $SUB   region: $REGION"
}

# "<vm-id> <power-state>" for every VM in the lab RG (az rest: avoids the broken
# `az vm` command-loading path some environments hit). The per-VM instanceView
# GETs run concurrently (one background job each, one wait).
vm_states() {
  local id
  for id in $(az rest --method get --url "https://management.azure.com/subscriptions/$SUB/resourceGroups/$LAB/providers/Microsoft.Compute/virtualMachines?$API" 2>/dev/null \
      | python3 -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: d={}
[print(v["id"]) for v in d.get("value",[])]' || true); do
    printf '%s %s\n' "$id" "$(az rest --method get --url "https://management.azure.com${id}/instanceView?$API" 2>/dev/null \
      | python3 -c 'import json,sys
try: s=json.load(sys.stdin).get("statuses",[])
except Exception: s=[]
print(next((x["code"].split("/")[1] for x in s if x.get("code","").startswith("PowerState/")),"unknown"))')" &
  done
  wait
}

stop_vms() {
  log "1. Graceful power-off + deallocate of every VM in $LAB"
  local states todo id st
  states="$(vm_states)"
  [ -n "$states" ] || { echo "  no VMs in resource group $LAB — not deployed (nothing to stop)"; return 0; }
  todo="$(printf '%s\n' "$states" | awk '$2!="deallocated"{print $1}')"
  [ -n "$todo" ] || { echo "  every VM already deallocated"; return 0; }
  # Per VM: graceful powerOff THEN deallocate (ordered within the VM), every VM
  # concurrently (one background job each, one wait).
  for id in $todo; do
    echo "  power off (graceful guest shutdown) + deallocate: ${id##*/}"
    (
      az rest --method post --url "https://management.azure.com${id}/powerOff?skipShutdown=false&$API" >/dev/null 2>&1 \
        || warn "powerOff request failed for ${id##*/} — deallocate will still stop it"
      az rest --method post --url "https://management.azure.com${id}/deallocate?$API" >/dev/null 2>&1 \
        || warn "deallocate request failed for ${id##*/}"
    ) &
  done
  wait
  echo "  waiting until every VM is deallocated..."
  local deadline=$(( $(date +%s) + 900 ))
  while :; do
    states="$(vm_states)"
    printf '%s\n' "$states" | awk '$2!="deallocated"{f=1} END{exit f}' && { echo "  all deallocated"; return 0; }
    [ "$(date +%s)" -ge "$deadline" ] && { printf '%s\n' "$states" | sed 's#^.*/#  #'; die "not every VM reached 'deallocated' within 15 min — check the portal"; }
    sleep 15
  done
}

preflight
stop_vms
log "2. Local session cleanup"
pf_local_down
log "STOP COMPLETE — $LAB is deallocated (terraform state untouched). Resume with: ./start.sh"
