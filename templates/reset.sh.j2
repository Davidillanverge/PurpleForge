#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand (regenerated on every
# `forge generate`). RESETS the SOFTWARE state of {{ lab_name }} ({{ provider }}):
# re-runs the Ansible phase (playbooks/site.yml — AD topology, population,
# hardening, vuln injection, EDR/telemetry, in the mandated order) against the
# RUNNING VMs, restoring the logical configuration the spec defines. No VM is
# destroyed, stopped or rebooted by this script, and Terraform is not invoked.
#
#   ./reset.sh [<generated-lab-dir>]              # re-run Ansible (default)
#   ./reset.sh [<generated-lab-dir>] --snapshot   # instead roll every VM back to
#                                                 # its clean-state snapshot (rollback.sh)
#
# site.yml is idempotent: it RE-ASSERTS everything the spec declares (accounts,
# passwords, ACLs, GPOs, injected vulns, hardening). It does not hunt down
# arbitrary artifacts an exercise added (e.g. a dropped binary or a new user
# not in the spec) — for a bit-exact pristine lab use --snapshot.
# The lab must be running (./start.sh first if it was stopped).
# =============================================================================
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
for a in "$@"; do
  if [ "$a" = "--snapshot" ]; then
    exec bash "$HERE/rollback.sh"
  fi
done

# Reuse deploy.sh's functions (sourced = definitions only, main() does not run).
. "$HERE/deploy.sh" "$@"

reset_main() {
  log "RESET $LAB — re-run the Ansible phase on the running VMs (no destroy, no power-off)"
  preflight
  ensure_secrets
  pf_ensure_outputs
  wg_up
{% if provider == "proxmox" %}
  route_lab
{% endif %}
  pf_check_connectivity || die "lab not reachable — is it stopped? run ./start.sh first (details: connectivity.json)"
{% if provider == "aws" %}
  mark_provisioning
{% endif %}
  ansible_up
  run_site
{% if provider == "aws" %}
  unmark_provisioning
{% endif %}
  log "RESET COMPLETE — $LAB re-provisioned to the spec's clean logical state"
  echo "  re-validate before attacking: PYTHONPATH=\"$REPO/scripts\" python3 -m forge validate \"{{ spec_rel }}\" --run"
}

reset_main
