#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand. Resets {{ lab_name }} to its
# CLEAN-STATE snapshot (taken at the end of deploy.sh, AFTER hardening + vuln
# injection but BEFORE any attack — CLAUDE.md deploy order). Use it between
# exercises so every run starts from the same pristine, fully-instrumented lab
# instead of whatever a previous attack left behind.
#
# Per VM it swaps the OS disk back to a fresh disk made from "<lab>-<vm>-clean":
#   deallocate -> create disk from snapshot -> az vm update --os-disk -> start.
# Idempotent-ish and best-effort per VM; a VM with no clean snapshot is skipped
# with a warning rather than left half-reset.
#
# NOTE: rendered from the documented Azure procedure; like verify.yml it has not
# been exercised against a live subscription in this repo — treat the first run
# with the same skepticism the project applies elsewhere.
#
#   ./reset.sh            # roll every VM back to its clean-state snapshot
# =============================================================================
set -uo pipefail

LAB="{{ lab_name }}"
REGION="${PF_REGION:-{{ region }}}"

log()  { printf '\n\033[1;35m== %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mFAIL:\033[0m %s\n' "$*" >&2; exit 1; }

command -v az >/dev/null 2>&1 || die "missing prerequisite: az"
SUB="${ARM_SUBSCRIPTION_ID:-$(az account show --query id -o tsv 2>/dev/null)}"
[ -n "$SUB" ] || die "could not resolve the subscription id (az login / ARM_SUBSCRIPTION_ID)"
export ARM_SUBSCRIPTION_ID="$SUB"

# All VMs in the lab RG, with their CURRENT OS disk id (deleted after the swap).
vms="$(az rest --method get --url "https://management.azure.com/subscriptions/$SUB/resourceGroups/$LAB/providers/Microsoft.Compute/virtualMachines?api-version=2023-07-01" 2>/dev/null \
      | python3 -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: d={}
for v in d.get("value",[]):
    disk=(((v.get("properties") or {}).get("storageProfile") or {}).get("osDisk") or {}).get("managedDisk") or {}
    print(v["name"]+"\t"+(disk.get("id") or ""))' || true)"
[ -n "$vms" ] || die "no VMs found in resource group '$LAB' — is the lab deployed?"

ts="$(date +%Y%m%d%H%M%S)"
overall_ok=1
printf '%s\n' "$vms" | while IFS=$'\t' read -r vm olddisk; do
  [ -n "$vm" ] || continue
  snap="${LAB}-${vm}-clean"
  log "reset $vm  (from snapshot $snap)"
  snapid="$(az snapshot show -g "$LAB" -n "$snap" --query id -o tsv 2>/dev/null || true)"
  if [ -z "$snapid" ]; then
    warn "no clean-state snapshot '$snap' — skipping $vm (was the deploy snapshot step run?)"; overall_ok=0; continue
  fi
  newdisk="${vm}-osdisk-clean-${ts}"
  echo "  1) deallocate";      az vm deallocate -g "$LAB" -n "$vm" >/dev/null 2>&1 || { warn "deallocate failed for $vm"; overall_ok=0; continue; }
  echo "  2) disk from snap";  az disk create -g "$LAB" -n "$newdisk" --source "$snapid" -l "$REGION" >/dev/null 2>&1 || { warn "disk create failed for $vm"; overall_ok=0; continue; }
  newid="$(az disk show -g "$LAB" -n "$newdisk" --query id -o tsv 2>/dev/null)"
  echo "  3) swap OS disk";    az vm update -g "$LAB" -n "$vm" --os-disk "$newid" >/dev/null 2>&1 || { warn "os-disk swap failed for $vm"; overall_ok=0; continue; }
  echo "  4) start";           az vm start -g "$LAB" -n "$vm" >/dev/null 2>&1 || warn "could not start $vm — start it manually"
  # 5) reclaim the replaced disk (best-effort; never blocks the reset)
  [ -n "$olddisk" ] && az resource delete --ids "$olddisk" >/dev/null 2>&1 || true
  echo "  done: $vm now on a fresh disk from $snap"
done

log "RESET COMPLETE — $LAB back to clean state (verify over the tunnel before re-attacking)"
