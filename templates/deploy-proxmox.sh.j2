#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand (regenerated on every
# `forge generate`). Deploys {{ lab_name }} on Proxmox VE end-to-end, without
# AI. Idempotent and safe to re-run: every step checks for existing state first,
# and the terraform/ansible steps retry on transient failures.
#
#   ./deploy.sh            # full deploy
#
# Prereqs (once per machine): terraform wireguard-tools openssl curl python3
# docker openssh-client.
#
# CHOOSE THE PROXMOX HOST — this script bakes NO credentials. Provide them EITHER
# by exporting the env vars, OR by filling in the .pf-proxmox-env file next to this
# script (deploy.sh sources it automatically; run once with nothing set and it
# writes a .pf-proxmox-env.example to fill in):
#   export PROXMOX_VE_ENDPOINT="https://pve.example.lan:8006/"
#   export PROXMOX_VE_API_TOKEN="user@pam!tokenid=xxxxxxxx-xxxx-...."
#   export PROXMOX_VE_INSECURE=true    # only if the PVE cert is self-signed
# A successful deploy rewrites .pf-proxmox-env, so teardown/reset/redeploy reuse it
# with nothing to retype. Also fill terraform/proxmox/host.auto.tfvars.json (node/bridges/datastore/
# template ids) from host.auto.tfvars.example.json. The Windows templates it
# references MUST have WinRM + the local `ansible` admin + cloudbase-init baked
# in (Proxmox has no VM extension to bootstrap WinRM, unlike Azure).
#
# TEMPLATE OVERRIDE — redeploy the SAME lab from a different golden template
# without regenerating or editing template_map (the lab was e.g. generated
# against a Server 2016 template; a later deploy wants a 2022 / EDR-baked one):
#   PF_TEMPLATE_ID=<vmid>   clone EVERY Windows VM from this template vm_id,
#                           overriding the os->template_map lookup. The template
#                           still needs WinRM + `ansible` admin + cloudbase-init.
# The hardening baseline still targets the os chosen at generate time.
# =============================================================================
set -uo pipefail   # deliberately NOT -e: failures are handled explicitly (retries)

LAB="{{ lab_name }}"
SUPERNET="{{ supernet }}"
DOMAIN="{{ domain }}"
WG_PORT="{{ wireguard_port }}"
AUTO_SHUTDOWN="{{ auto_shutdown }}"
# domain -> {vlan_id, gateway_ip, subnet}; drives the bastion VLAN routing step.
DOMAINS_JSON='{{ domains_json }}'

{% include "_lifecycle-common.sh.j2" %}
# usage: deploy.sh [<generated-lab-dir>] [--sizes-only]   (dir defaults to this script's)
pf_resolve_lab_dir "$@"
TF_DIR="$LAB_DIR/terraform/proxmox"
ANS_DIR="$LAB_DIR/ansible"
ENV_FILE="$LAB_DIR/.pf-proxmox-env"


# A fill-in-the-blanks credentials file, same idea as host.auto.tfvars.example.json.
# Written only when the operator has provided nothing to source, so `./deploy.sh`
# points them at ONE file to edit instead of failing on a bare env-var error.
pf_write_env_example() {
  local ex="${ENV_FILE}.example"
  [ -f "$ex" ] && return 0
  umask 077
  cat > "$ex" <<'EOF'
# Copy to .pf-proxmox-env (gitignored) and fill in — deploy.sh/teardown.sh/reset.sh
# source it AUTOMATICALLY. Proxmox credentials are read from the environment and
# never baked into shared files (account/host independence). After a successful
# deploy, deploy.sh rewrites .pf-proxmox-env so later teardown/reset/redeploy reuse
# it with nothing to retype.
PROXMOX_VE_ENDPOINT=https://your-proxmox:8006/
PROXMOX_VE_API_TOKEN=user@pam!tokenid=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PROXMOX_VE_INSECURE=true            # self-signed PVE cert

# --- only for a CLOUD-hosted Proxmox reached from a REMOTE deploy host ---
# SSH to the node (bpg uploads the bastion snippet over SSH, not the API):
#PROXMOX_VE_SSH_USERNAME=root
#PROXMOX_VE_SSH_PRIVATE_KEY="$(cat ~/.ssh/id_ed25519)"   # or rely on ssh-agent
# Reach the bastion through the host's public IP + DNAT (see PROXMOX-DEPLOY-RUNBOOK.md):
#PF_BASTION_ENDPOINT=<proxmox-public-ip>
#PF_BASTION_SSH_PORT=2222
EOF
  echo "  wrote $(basename "$ex")"
}

# Proxmox credentials come from the ENVIRONMENT (never baked into generated files).
# Convenience: if they are not exported but a .pf-proxmox-env sits next to this
# script (written by a prior deploy, or filled in from the .example), source it
# automatically so a plain `./deploy.sh` just works — no manual `set -a; source`.
# Sourced INSIDE this bash script, so the token's `!` never trips zsh history
# expansion (the reason a manual source under zsh failed before).
pf_load_env() {
  if [ -z "${PROXMOX_VE_ENDPOINT:-}" ] && [ -f "$ENV_FILE" ]; then
    echo "  sourcing $(basename "$ENV_FILE")"
    set -a; . "$ENV_FILE"; set +a
  fi
  if [ -z "${PROXMOX_VE_ENDPOINT:-}" ] || [ -z "${PROXMOX_VE_API_TOKEN:-}" ]; then
    pf_write_env_example
    die "Proxmox credentials not set. Fill in $ENV_FILE (template written to ${ENV_FILE}.example), or export PROXMOX_VE_ENDPOINT + PROXMOX_VE_API_TOKEN, then re-run ./deploy.sh"
  fi
}

preflight() {
  log "0. Preflight"
  for b in terraform wg openssl curl python3 docker ssh; do need "$b"; done
  pf_load_env
  [ -f "$TF_DIR/host.auto.tfvars.json" ] \
    || die "terraform/proxmox/host.auto.tfvars.json missing — copy host.auto.tfvars.example.json and fill node/bridges/datastore/template ids for your Proxmox host"
  echo "  endpoint: $PROXMOX_VE_ENDPOINT"
}

# ---- infra secrets (verify present; NEVER minted here) ----------------------
# Identical to the Azure flow: every secret under generated/<lab>/ — population
# USER passwords AND the two infra keys (domain admin + ansible WinRM) — is
# deterministic from population.seed, so `forge generate` reproduces them all
# from the spec. deploy mints nothing; it just confirms generate ran.
ensure_secrets() {
  log "0b. Infra secrets (verify generate produced them — never minted here)"
  local tf_secrets="$TF_DIR/secrets.auto.tfvars.json"
  local ans_secrets="$ANS_DIR/inventory/group_vars/all/secrets.yml"
  local pop_secrets="$ANS_DIR/inventory/group_vars/all/population-secrets.yml"
  for f in "$pop_secrets" "$tf_secrets" "$ans_secrets"; do
    [ -f "$f" ] || die "$(basename "$f") missing — every secret is seed-derived; run 'forge generate {{ spec_rel }}' first"
  done
  echo "  all secrets present (seed-derived by generate) — nothing to mint"
}

# ---- optional template override (PF_TEMPLATE_ID) ----------------------------
# Turn PF_TEMPLATE_ID into an auto.tfvars overlay that overrides the os->template
# lookup baked into host.auto.tfvars.json, applied to EVERY Windows VM (all
# roles). Unset => remove any stale overlay so a plain re-run reverts to the
# per-os template_map.
pick_template() {
  log "0c. Template override (PF_TEMPLATE_ID)"
  local overlay="$TF_DIR/template.auto.tfvars.json"
  if [ -z "${PF_TEMPLATE_ID:-}" ]; then
    rm -f "$overlay"
    echo "  no template override — cloning from template_map[os] (host.auto.tfvars.json)"
    return 0
  fi
  case "$PF_TEMPLATE_ID" in
    ''|*[!0-9]*) die "PF_TEMPLATE_ID must be a numeric Proxmox vm_id, got '$PF_TEMPLATE_ID'";;
  esac
  ROLES_JSON='{{ roles_json }}' TID="$PF_TEMPLATE_ID" python3 - "$overlay" <<'PY'
import json, os, sys
roles = json.loads(os.environ["ROLES_JSON"])
doc = {"template_id_overrides": {r: int(os.environ["TID"]) for r in roles}}
open(sys.argv[1], "w").write(json.dumps(doc, indent=2) + "\n")
print("  wrote " + sys.argv[1] + ": all roles -> template vm_id " + os.environ["TID"])
PY
}

# ---- terraform apply (local backend — CLAUDE.md #4 relaxed for on-prem) ------
tf_apply() {
  log "1. terraform init + apply (local state backend)"
  terraform -chdir="$TF_DIR" init -input=false || die "terraform init failed"
  local tries=0 max=5 par="$PF_TF_PARALLELISM"
  # -refresh=false: on a RE-RUN, bpg's refresh reads each existing VM through the
  # QEMU guest agent and can block for minutes per VM (same agent-wait that hangs
  # teardown). A fresh apply has nothing to refresh, so this is a no-op there and
  # only speeds up idempotent re-runs; drift isn't expected in a deterministic lab.
  # First attempt at high concurrency (parallel clones); a retry — typically a
  # template clone-lock — drops to PF_TF_RETRY_PARALLELISM.
  until terraform -chdir="$TF_DIR" apply -refresh=false -auto-approve -input=false -parallelism="$par"; do
    tries=$((tries+1))
    par="$PF_TF_RETRY_PARALLELISM"   # retries: low concurrency is what cures API lag/locks
    [ "$tries" -ge "$max" ] && die "terraform apply still failing after $tries tries — see the error above"
    warn "apply failed (attempt $tries/$max) — retrying in 15s (Proxmox API/clone lag is expected)"
    sleep 15
  done
  echo "  apply complete"
}

# ---- start any stopped VMs (redeploying a lab auto_shutdown stopped) --------
# terraform apply reconciles CONFIGURATION drift, not power state — it will
# NOT start an already-stopped VM. A fresh deploy's VMs are already running
# (harmless no-op start below); redeploying/continuing a lab after
# setup_auto_shutdown's cron stopped it needs this, or wg_up/ansible never
# reach a live host. Same pool-membership query the auto_shutdown helper
# uses, inverted (start instead of shutdown).
start_vms() {
  log "1b. Starting any stopped VMs"
  local k=""; [ "${PROXMOX_VE_INSECURE:-false}" = "true" ] && k="-k"
  local base="${PROXMOX_VE_ENDPOINT%/}"
  local auth="Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN"
  local members
  members="$(curl -s $k -H "$auth" "$base/api2/json/pools/$LAB" \
    | python3 -c 'import json,sys
try: d=json.load(sys.stdin).get("data",{})
except Exception: d={}
for m in d.get("members",[]):
    if m.get("type")=="qemu": print(m["node"], m["vmid"])' 2>/dev/null || true)"
  [ -z "$members" ] && { echo "  no VMs found yet — continuing"; return; }
  while read -r node vmid; do
    [ -n "$node" ] && [ -n "$vmid" ] || continue
    curl -s $k -H "$auth" -X POST "$base/api2/json/nodes/$node/qemu/$vmid/status/start" >/dev/null 2>&1 &
  done <<< "$members"
  wait
  echo "  start requested for every VM (in parallel) — reachability is gated by the connectivity probe"
}

# ---- WireGuard tunnel (the only path into the lab) --------------------------
# Same server-side wiring as the Azure flow: read the bastion's routable IP,
# pull the SSH key from state, register this host as a WireGuard peer.
wg_up() {
  log "2. WireGuard tunnel to the bastion"
  mkdir -p "$TF_DIR/ssh_keys"
  if [ ! -s "$TF_DIR/ssh_keys/bastion.pem" ]; then
    terraform -chdir="$TF_DIR" show -json | python3 -c '
import json,sys
d=json.load(sys.stdin)
for r in d.get("values",{}).get("root_module",{}).get("resources",[]):
    if r.get("address")=="tls_private_key.bastion_ssh":
        sys.stdout.write(r["values"]["private_key_pem"])
' > "$TF_DIR/ssh_keys/bastion.pem"
    chmod 600 "$TF_DIR/ssh_keys/bastion.pem"
  fi
  BASTION_IP="$(pf_out bastion_public_ip)"
  [ -n "$BASTION_IP" ] || die "no bastion_public_ip in terraform-outputs.json — did apply finish?"
  # Reachable-address override for a CLOUD-hosted Proxmox reached from a REMOTE
  # deploy host: the bastion's mgmt IP ($BASTION_IP) isn't directly routable from
  # outside the Proxmox host, so reach it via the host's public IP + a DNAT (WG
  # udp + ssh) — see PROXMOX-DEPLOY-RUNBOOK.md. Set PF_BASTION_ENDPOINT to that
  # public IP and PF_BASTION_SSH_PORT to the DNAT'd ssh port. Defaults preserve
  # the bare-metal-LAN behaviour (reach the bastion directly on :22).
  BASTION_ENDPOINT="${PF_BASTION_ENDPOINT:-$BASTION_IP}"
  BASTION_SSH_PORT="${PF_BASTION_SSH_PORT:-22}"
  [ -f "$TF_DIR/ssh_keys/client_wg.key" ] || wg genkey | tee "$TF_DIR/ssh_keys/client_wg.key" | wg pubkey > "$TF_DIR/ssh_keys/client_wg.pub"
  local CLIENT_PUB SERVER_PUB
  CLIENT_PUB="$(cat "$TF_DIR/ssh_keys/client_wg.pub")"
  SSH="ssh -p $BASTION_SSH_PORT -o StrictHostKeyChecking=no -o ConnectTimeout=20 -i $TF_DIR/ssh_keys/bastion.pem purpleforge@$BASTION_ENDPOINT"
  BASTION_SSH="$SSH"
  local i=0; until $SSH true 2>/dev/null; do i=$((i+1)); [ "$i" -ge 20 ] && die "bastion SSH never came up at $BASTION_ENDPOINT:$BASTION_SSH_PORT (check its routable NIC / mgmt_bridge / DNAT)"; sleep 15; done
  # sshd answers well before cloud-init finishes installing wireguard-tools and
  # generating the server keypair — wait for it, or SERVER_PUB comes back empty
  # and wg-quick fails with "Line unrecognized: PublicKey=".
  echo "  waiting for bastion cloud-init (wireguard-tools + server keypair)..."
  $SSH 'sudo cloud-init status --wait >/dev/null 2>&1; true'
  SERVER_PUB="$($SSH 'sudo cat /etc/wireguard/publickey 2>/dev/null')"
  [ -n "$SERVER_PUB" ] || die "bastion has no /etc/wireguard/publickey — cloud-init failed? check: ssh ... 'sudo tail -50 /var/log/cloud-init-output.log'"
  $SSH "sudo wg set wg0 peer $CLIENT_PUB allowed-ips 10.250.250.2/32 && sudo wg-quick save wg0" \
    || die "could not register the client peer on the bastion's wg0"
  cat > "$TF_DIR/ssh_keys/pf-lab.conf" <<EOF
[Interface]
PrivateKey = $(cat "$TF_DIR/ssh_keys/client_wg.key")
Address = 10.250.250.2/32
[Peer]
PublicKey = $SERVER_PUB
Endpoint = $BASTION_ENDPOINT:$WG_PORT
AllowedIPs = 10.250.250.0/24, $SUPERNET
PersistentKeepalive = 25
EOF
  chmod 600 "$TF_DIR/ssh_keys/pf-lab.conf"
  sudo wg-quick down "$TF_DIR/ssh_keys/pf-lab.conf" 2>/dev/null || true
  sudo wg-quick up "$TF_DIR/ssh_keys/pf-lab.conf" || die "wg-quick up failed"
  echo "  tunnel up (bastion $BASTION_ENDPOINT:$WG_PORT)"
}

# ---- bastion L3 routing for the lab VLANs (Proxmox-only) --------------------
# On Azure the VNet routes management<->domain subnets for free; on Proxmox the
# bastion has to become that router. For each domain, bring up a VLAN
# sub-interface on the bastion's internal NIC with the domain's .254 gateway IP
# (the address Windows hosts default-route to — see windows.tf), and enable
# forwarding. Idempotent: re-running just re-asserts the interfaces.
route_lab() {
  log "3. Bastion VLAN routing for the lab subnets"
  local rules
  rules="$(DOMAINS_JSON="$DOMAINS_JSON" python3 -c '
import json,os
d=json.loads(os.environ["DOMAINS_JSON"])
for _,v in d.items():
    print(v["vlan_id"], v["gateway_ip"], v["subnet"].split("/")[1])
')"
  # Detect the bastion NIC on the lab bridge = the one NOT carrying the default
  # route (net0 is the routable/mgmt NIC with the default gateway; net1 is the
  # lab-side NIC we tag per domain).
  # base64 the rules so the whole "VLAN GW PREFIX" block survives the SSH hop:
  # ssh joins argv with spaces and the remote shell re-splits, so a spaced/
  # multi-line "$rules" passed as a positional arg arrives truncated to its first
  # word (the bug that left the .254 gateway unset — "gw /"). A single base64
  # token has no spaces, so $1 arrives intact.
  local rules_b64; rules_b64="$(printf '%s' "$rules" | base64 | tr -d '\n')"
  local remote
  remote="$($SSH bash -s -- "$rules_b64" <<'REMOTE'
set -e
RULES="$(printf '%s' "$1" | base64 -d)"
sudo sysctl -w net.ipv4.ip_forward=1 >/dev/null
DEFAULT_IF=$(ip route show default | awk '{print $5; exit}')
LAB_IF=$(ip -o link show | awk -F': ' '{print $2}' | sed 's/@.*//' | grep -vx "lo" | grep -vx "$DEFAULT_IF" | grep -E '^(eth|ens|enp)' | head -1)
[ -n "$LAB_IF" ] || { echo "could not find lab-side NIC on bastion" >&2; exit 1; }
echo "$RULES" | while read -r VLAN GW PREFIX; do
  [ -n "$VLAN" ] || continue
  sudo ip link add link "$LAB_IF" name "${LAB_IF}.${VLAN}" type vlan id "$VLAN" 2>/dev/null || true
  sudo ip addr add "${GW}/${PREFIX}" dev "${LAB_IF}.${VLAN}" 2>/dev/null || true
  sudo ip link set "${LAB_IF}.${VLAN}" up
  echo "  routed VLAN ${VLAN} gw ${GW}/${PREFIX} on ${LAB_IF}"
done
# Outbound-only internet for the lab: GOAD's `common` role installs
# PowerShellGet/NuGet from the PS Gallery during setup (pre-DC-promotion), which
# needs egress. On Azure the lab NICs have outbound by default; on the isolated
# Proxmox lab bridge they don't. MASQUERADE lab subnets out the bastion's default
# NIC — outbound only, no inbound is opened, so invariant #1 holds. Idempotent.
LAB_SUPERNET="$(printf '%s' "$RULES" | awk 'NR==1{n=$2; sub(/\.[0-9]+\.[0-9]+$/,".0.0/16",n); print n}')"
if [ -n "$LAB_SUPERNET" ]; then
  sudo iptables -t nat -C POSTROUTING -s "$LAB_SUPERNET" -o "$DEFAULT_IF" -j MASQUERADE 2>/dev/null \
    || sudo iptables -t nat -A POSTROUTING -s "$LAB_SUPERNET" -o "$DEFAULT_IF" -j MASQUERADE
  echo "  lab egress NAT: $LAB_SUPERNET -> $DEFAULT_IF (outbound only)"
fi
REMOTE
)" || die "bastion VLAN routing setup failed"
  echo "$remote"
}

# ---- Ansible control node in Docker (Python 3.10 GOAD needs) ----------------
ansible_up() {
  log "4. Ansible control node (cached Docker image, --network host to see the tunnel)"
  pf_ansible_up
}

# ---- provision AD (site.yml enforces hardening-before-vulns order) ----------
run_site() {
  log "5. Provision AD -> population -> hardening -> vuln injection (site.yml)"
  # Telemetry (DETECT) backend creds are operator-provided + deploy-time only
  # (never in the spec). Validate the ones this lab's telemetry agents need and
  # pass them to site.yml as extra-vars (expanded on the host -> literal args).
  TELEMETRY_EV=""
{% if telemetry_elastic %}
  [ -n "${PF_FLEET_URL:-}" ] || die "telemetry: PF_FLEET_URL unset (operator Fleet endpoint)"
  [ -n "${PF_FLEET_ENROLLMENT_TOKEN:-}" ] || die "telemetry: PF_FLEET_ENROLLMENT_TOKEN unset"
  [ -n "${PF_ELASTIC_AGENT_VERSION:-}" ] || die "telemetry: PF_ELASTIC_AGENT_VERSION unset (match your Elastic stack)"
  TELEMETRY_EV="$TELEMETRY_EV -e pf_fleet_url=$PF_FLEET_URL -e pf_fleet_enrollment_token=$PF_FLEET_ENROLLMENT_TOKEN -e pf_elastic_agent_version=$PF_ELASTIC_AGENT_VERSION"
  [ -n "${PF_FLEET_INSECURE:-}" ] && TELEMETRY_EV="$TELEMETRY_EV -e pf_fleet_insecure=$PF_FLEET_INSECURE"
{% endif %}
{% if telemetry_warp %}
  [ -n "${PF_CLOUDFLARE_TEAM:-}" ] || die "telemetry: PF_CLOUDFLARE_TEAM unset (Zero Trust org slug)"
  [ -n "${PF_CLOUDFLARE_ENROLL_CLIENT_ID:-}" ] || die "telemetry: PF_CLOUDFLARE_ENROLL_CLIENT_ID unset"
  [ -n "${PF_CLOUDFLARE_ENROLL_CLIENT_SECRET:-}" ] || die "telemetry: PF_CLOUDFLARE_ENROLL_CLIENT_SECRET unset"
  TELEMETRY_EV="$TELEMETRY_EV -e pf_cloudflare_team=$PF_CLOUDFLARE_TEAM -e pf_cloudflare_enroll_client_id=$PF_CLOUDFLARE_ENROLL_CLIENT_ID -e pf_cloudflare_enroll_client_secret=$PF_CLOUDFLARE_ENROLL_CLIENT_SECRET"
{% endif %}
{% if bas_caldera %}
  # BAS (adversary emulation) — MITRE Caldera sandcat beacon. The Caldera server is
  # operator-run: a cloud server (agents reach it via bastion egress) or a local
  # Kali server (set PF_CALDERA_SERVER to the Kali address reachable over the
  # WireGuard tunnel, e.g. http://10.x.x.x:8888). Creds are deploy-time only.
  [ -n "${PF_CALDERA_SERVER:-}" ] || die "bas: PF_CALDERA_SERVER unset (operator Caldera URL, e.g. http://host:8888 — cloud or local Kali over the tunnel)"
  [ -n "${PF_CALDERA_GROUP:-}" ] || die "bas: PF_CALDERA_GROUP unset (sandcat agent group, e.g. red)"
  TELEMETRY_EV="$TELEMETRY_EV -e pf_caldera_server=$PF_CALDERA_SERVER -e pf_caldera_group=$PF_CALDERA_GROUP"
  [ -n "${PF_CALDERA_API_KEY:-}" ] && TELEMETRY_EV="$TELEMETRY_EV -e pf_caldera_api_key=$PF_CALDERA_API_KEY"
{% endif %}
  local i=0
  until pf_ansible ansible all -i inventory/hosts.yml -m ansible.windows.win_ping >/dev/null 2>&1; do
    i=$((i+1)); [ "$i" -ge 20 ] && { warn "win_ping never went green for every host — running site.yml anyway (it will retry)"; break; }
    echo "  waiting for WinRM on all hosts ($i)..."; sleep 20
  done
  local tries=0 max=6
  until pf_ansible ansible-playbook -i inventory/hosts.yml playbooks/site.yml $TELEMETRY_EV; do
    tries=$((tries+1))
    [ "$tries" -ge "$max" ] && die "site.yml still failing after $tries runs — inspect the error above"
    warn "site.yml failed (attempt $tries/$max) — re-running (idempotent; picks up where it left off)"
    docker exec pf-ansible true >/dev/null 2>&1 || { warn "pf-ansible container is gone — recreating it before the next attempt"; ansible_up; }
    sleep 15
  done
  echo "  provisioning complete"
}

# ---- auto_shutdown (CLAUDE.md #4) — best-effort local cron ------------------
# Proxmox has no native scheduled-shutdown (Azure uses DevTest schedules). This
# installs a cron on THIS deploy host that stops every VM in the lab's pool via
# the Proxmox API at the spec's auto_shutdown time. Best-effort: it only fires
# while this host is up. The API token is written to a gitignored 600 env file
# so cron (which has no exported env) can read it. teardown.sh removes both.
setup_auto_shutdown() {
  log "6. auto_shutdown ($AUTO_SHUTDOWN) — best-effort cron on this host"
  [ -n "$AUTO_SHUTDOWN" ] || { echo "  no auto_shutdown in spec — skipping"; return 0; }
  command -v crontab >/dev/null 2>&1 || { warn "crontab not available — auto_shutdown NOT installed; stop the lab manually with ./teardown.sh"; return 0; }
  local hh mm envf helper
  hh="$(printf '%s' "$AUTO_SHUTDOWN" | cut -d: -f1)"
  mm="$(printf '%s' "$AUTO_SHUTDOWN" | cut -d: -f2 | cut -d' ' -f1)"
  envf="$ENV_FILE"
  helper="$LAB_DIR/pf-autoshutdown.sh"
  umask 077
  # Persist EVERY credential this deploy used (not just the core three) so a later
  # teardown/reset/redeploy re-sources a complete env — including the SSH key and
  # bastion overrides a cloud-hosted node needs. %q keeps the multiline SSH key
  # sourceable ($'...\n...'). Optional vars are written only when set.
  {
    printf 'PROXMOX_VE_ENDPOINT=%q\n' "$PROXMOX_VE_ENDPOINT"
    printf 'PROXMOX_VE_API_TOKEN=%q\n' "$PROXMOX_VE_API_TOKEN"
    printf 'PROXMOX_VE_INSECURE=%q\n' "${PROXMOX_VE_INSECURE:-false}"
    [ -n "${PROXMOX_VE_SSH_USERNAME:-}" ]    && printf 'PROXMOX_VE_SSH_USERNAME=%q\n' "$PROXMOX_VE_SSH_USERNAME"
    [ -n "${PROXMOX_VE_SSH_PRIVATE_KEY:-}" ] && printf 'PROXMOX_VE_SSH_PRIVATE_KEY=%q\n' "$PROXMOX_VE_SSH_PRIVATE_KEY"
    [ -n "${PF_BASTION_ENDPOINT:-}" ]        && printf 'PF_BASTION_ENDPOINT=%q\n' "$PF_BASTION_ENDPOINT"
    [ -n "${PF_BASTION_SSH_PORT:-}" ]        && printf 'PF_BASTION_SSH_PORT=%q\n' "$PF_BASTION_SSH_PORT"
  } > "$envf"
  cat > "$helper" <<HELPER
#!/usr/bin/env bash
# GENERATED — stops every VM in Proxmox pool '$LAB' via the API. gitignored.
set -uo pipefail
. "$envf"
K=""; [ "\${PROXMOX_VE_INSECURE:-false}" = "true" ] && K="-k"
BASE="\${PROXMOX_VE_ENDPOINT%/}"
AUTH="Authorization: PVEAPIToken=\$PROXMOX_VE_API_TOKEN"
curl -s \$K -H "\$AUTH" "\$BASE/api2/json/pools/$LAB" \
  | python3 -c 'import json,sys
d=json.load(sys.stdin).get("data",{})
for m in d.get("members",[]):
    if m.get("type")=="qemu": print(m["node"], m["vmid"])' \
  | while read -r NODE VMID; do
      curl -s \$K -H "\$AUTH" -X POST "\$BASE/api2/json/nodes/\$NODE/qemu/\$VMID/status/shutdown" >/dev/null || true
    done
HELPER
  chmod 700 "$helper"
  # Idempotent crontab: drop any prior line for this helper, add the new one.
  ( crontab -l 2>/dev/null | grep -vF "$helper"; printf '%s %s * * * %s\n' "$mm" "$hh" "$helper" ) | crontab - \
    && echo "  installed cron: $mm $hh daily -> stop pool '$LAB'" \
    || warn "could not install crontab entry — auto_shutdown not enforced"
}

# ---- clean-state snapshot (CLAUDE.md deploy order: the LAST provisioning ------
# step, AFTER hardening+vulns, BEFORE any attack). One Proxmox snapshot named
# "pf-clean" per lab VM, via the API — `forge reset` (reset.sh) rolls back to it.
# Best-effort: never fails the deploy.
snapshot_clean() {
  [ "${PF_SNAPSHOT:-1}" = "1" ] || { log "5b. Clean-state snapshot (skipped: PF_SNAPSHOT=0)"; return 0; }
  log "5b. Clean-state snapshot (post-hardening+vulns, pre-attack) — pf-clean"
  local k=""; [ "${PROXMOX_VE_INSECURE:-false}" = "true" ] && k="-k"
  local base="${PROXMOX_VE_ENDPOINT%/}"
  local auth="Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN"
  local members
  members="$(curl -s $k -H "$auth" "$base/api2/json/pools/$LAB" \
    | python3 -c 'import json,sys
try: d=json.load(sys.stdin).get("data",{})
except Exception: d={}
for m in d.get("members",[]):
    if m.get("type")=="qemu": print(m["node"], m["vmid"])' 2>/dev/null || true)"
  [ -z "$members" ] && { warn "no VMs found — skipping snapshot"; return 0; }
  while read -r node vmid; do
    [ -n "$node" ] && [ -n "$vmid" ] || continue
    echo "  snapshot vm $vmid -> pf-clean"
    (
    # delete a stale pf-clean first so re-deploys refresh it (ignore if absent)
    curl -s $k -H "$auth" -X DELETE "$base/api2/json/nodes/$node/qemu/$vmid/snapshot/pf-clean" >/dev/null 2>&1 || true
    curl -s $k -H "$auth" -X POST "$base/api2/json/nodes/$node/qemu/$vmid/snapshot" \
      --data-urlencode "snapname=pf-clean" --data-urlencode "description=PurpleForge clean state (post-hardening+vulns, pre-attack)" >/dev/null 2>&1 \
      || warn "could not snapshot vm $vmid (continuing)"
    ) &
  done <<< "$members"
  wait
  echo "  clean-state snapshot(s) done — restore with: forge reset {{ spec_rel }} --snapshot"
}

main() {
  preflight
  ensure_secrets
  pick_template
  tf_apply
  pf_export_outputs || die "could not read terraform outputs after apply"
  start_vms
  wg_up
  route_lab
  pf_check_connectivity || die "lab not reachable over the tunnel — see connectivity.json"
  ansible_up
  run_site
  snapshot_clean
  setup_auto_shutdown
  log "DEPLOY COMPLETE — $LAB"
  cat <<EOF

Next steps (no AI):
  # confirm the injected vulnerabilities are applied + exploitable:
  PYTHONPATH="$REPO/scripts" python3 -m forge validate "{{ spec_rel }}" --run
  # verify the live domain matches the plan (users/groups/NT hashes):
  PYTHONPATH="$REPO/scripts" python3 -m forge ad-inventory "{{ spec_rel }}"

When finished, tear everything down (removes every VM in the pool):
  ./teardown.sh
EOF
}

# Executed -> run the full deploy. Sourced (by start.sh / reset.sh) -> only
# define the functions above, so those scripts reuse the exact same steps.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main
fi
