#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand (regenerated on every
# `forge.py generate`). Deploys {{ lab_name }} on Proxmox VE end-to-end, without
# AI. Idempotent and safe to re-run: every step checks for existing state first,
# and the terraform/ansible steps retry on transient failures.
#
#   ./deploy.sh            # full deploy
#
# Prereqs (once per machine): terraform wireguard-tools openssl curl python3
# docker openssh-client.
#
# CHOOSE THE PROXMOX HOST — this script bakes NO credentials. Export before run:
#   export PROXMOX_VE_ENDPOINT="https://pve.example.lan:8006/"
#   export PROXMOX_VE_API_TOKEN="user@pam!tokenid=xxxxxxxx-xxxx-...."
#   export PROXMOX_VE_INSECURE=true    # only if the PVE cert is self-signed
# and fill terraform/proxmox/host.auto.tfvars.json (node/bridges/datastore/
# template ids) from host.auto.tfvars.example.json. The Windows templates it
# references MUST have WinRM + the local `ansible` admin + cloudbase-init baked
# in (Proxmox has no VM extension to bootstrap WinRM, unlike Azure).
#
# TEMPLATE OVERRIDE — redeploy the SAME lab from a different golden template
# without regenerating or editing template_map (the lab was e.g. generated
# against a Server 2016 template; a later deploy wants a 2022 / EDR-baked one):
#   PF_TEMPLATE_ID=<vmid>   clone EVERY Windows VM from this template vm_id,
#                           overriding the os->template_map lookup. The template
#                           still needs WinRM + `ansible` admin + cloudbase-init.
# The hardening baseline still targets the os chosen at generate time.
# =============================================================================
set -uo pipefail   # deliberately NOT -e: failures are handled explicitly (retries)

LAB="{{ lab_name }}"
SUPERNET="{{ supernet }}"
DOMAIN="{{ domain }}"
WG_PORT="{{ wireguard_port }}"
AUTO_SHUTDOWN="{{ auto_shutdown }}"
# domain -> {vlan_id, gateway_ip, subnet}; drives the bastion VLAN routing step.
DOMAINS_JSON='{{ domains_json }}'

cd "$(dirname "$0")"
LAB_DIR="$PWD"
TF_DIR="$LAB_DIR/terraform/proxmox"
ANS_DIR="$LAB_DIR/ansible"
REPO="$(cd "$LAB_DIR/../.." && pwd)"

log()  { printf '\n\033[1;35m== %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mFAIL:\033[0m %s\n' "$*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing prerequisite: $1"; }

preflight() {
  log "0. Preflight"
  for b in terraform wg openssl curl python3 docker ssh; do need "$b"; done
  [ -n "${PROXMOX_VE_ENDPOINT:-}" ] || die "PROXMOX_VE_ENDPOINT is not set (e.g. https://pve.example.lan:8006/)"
  [ -n "${PROXMOX_VE_API_TOKEN:-}" ] || die "PROXMOX_VE_API_TOKEN is not set (user@realm!tokenid=uuid)"
  [ -f "$TF_DIR/host.auto.tfvars.json" ] \
    || die "terraform/proxmox/host.auto.tfvars.json missing — copy host.auto.tfvars.example.json and fill node/bridges/datastore/template ids for your Proxmox host"
  echo "  endpoint: $PROXMOX_VE_ENDPOINT"
}

# ---- infra secrets (mint the domain-admin + ansible keys if this is a share) -
# Identical to the Azure flow: everything under generated/<lab>/ is versioned,
# population USER passwords are committed and never regenerated, and only the
# two INFRA keys (domain admin + ansible WinRM) are per-deployer + gitignored.
ensure_secrets() {
  log "0b. Infra secrets (domain admin + ansible WinRM)"
  local tf_secrets="$TF_DIR/secrets.auto.tfvars.json"
  local ans_secrets="$ANS_DIR/inventory/group_vars/all/secrets.yml"
  [ -f "$ANS_DIR/inventory/group_vars/all/population-secrets.yml" ] \
    || die "population-secrets.yml missing — it is committed with the lab; run 'forge.py generate {{ spec_rel }}' first"
  if [ -f "$tf_secrets" ] && [ -f "$ans_secrets" ]; then
    echo "  infra secrets already present — reusing (not a fresh share)"
    return 0
  fi
  echo "  fresh share detected — minting the two infra keys (population passwords are committed, not touched)"
  TF_OUT="$tf_secrets" ANS_OUT="$ans_secrets" python3 - <<'PY'
import json, os, secrets, string
symbols = "!@#*-_=+"   # cmd.exe-safe — see forge.py generate_password
alphabet = string.ascii_letters + string.digits + symbols
def pw(length=20):
    while True:
        p = "".join(secrets.choice(alphabet) for _ in range(length))
        if (any(c.islower() for c in p) and any(c.isupper() for c in p)
                and any(c.isdigit() for c in p) and any(c in symbols for c in p)):
            return p
admin, ansible = pw(), pw()
with open(os.environ["TF_OUT"], "w") as f:
    json.dump({"admin_password": admin, "ansible_password": ansible}, f, indent=2); f.write("\n")
os.makedirs(os.path.dirname(os.environ["ANS_OUT"]), exist_ok=True)
with open(os.environ["ANS_OUT"], "w") as f:
    f.write("# minted by deploy.sh — gitignored, never commit\n")
    json.dump({"pf_admin_password": admin, "pf_ansible_password": ansible}, f, indent=2); f.write("\n")
print("  minted domain-admin + ansible keys (population passwords untouched)")
PY
}

# ---- optional template override (PF_TEMPLATE_ID) ----------------------------
# Turn PF_TEMPLATE_ID into an auto.tfvars overlay that overrides the os->template
# lookup baked into host.auto.tfvars.json, applied to EVERY Windows VM (all
# roles). Unset => remove any stale overlay so a plain re-run reverts to the
# per-os template_map.
pick_template() {
  log "0c. Template override (PF_TEMPLATE_ID)"
  local overlay="$TF_DIR/template.auto.tfvars.json"
  if [ -z "${PF_TEMPLATE_ID:-}" ]; then
    rm -f "$overlay"
    echo "  no template override — cloning from template_map[os] (host.auto.tfvars.json)"
    return 0
  fi
  case "$PF_TEMPLATE_ID" in
    ''|*[!0-9]*) die "PF_TEMPLATE_ID must be a numeric Proxmox vm_id, got '$PF_TEMPLATE_ID'";;
  esac
  ROLES_JSON='{{ roles_json }}' TID="$PF_TEMPLATE_ID" python3 - "$overlay" <<'PY'
import json, os, sys
roles = json.loads(os.environ["ROLES_JSON"])
doc = {"template_id_overrides": {r: int(os.environ["TID"]) for r in roles}}
open(sys.argv[1], "w").write(json.dumps(doc, indent=2) + "\n")
print("  wrote " + sys.argv[1] + ": all roles -> template vm_id " + os.environ["TID"])
PY
}

# ---- terraform apply (local backend — CLAUDE.md #4 relaxed for on-prem) ------
tf_apply() {
  log "1. terraform init + apply (local state backend)"
  terraform -chdir="$TF_DIR" init -input=false || die "terraform init failed"
  local tries=0 max=5
  until terraform -chdir="$TF_DIR" apply -auto-approve -input=false; do
    tries=$((tries+1))
    [ "$tries" -ge "$max" ] && die "terraform apply still failing after $tries tries — see the error above"
    warn "apply failed (attempt $tries/$max) — retrying in 15s (Proxmox API/clone lag is expected)"
    sleep 15
  done
  echo "  apply complete"
}

# ---- start any stopped VMs (redeploying a lab auto_shutdown stopped) --------
# terraform apply reconciles CONFIGURATION drift, not power state — it will
# NOT start an already-stopped VM. A fresh deploy's VMs are already running
# (harmless no-op start below); redeploying/continuing a lab after
# setup_auto_shutdown's cron stopped it needs this, or wg_up/ansible never
# reach a live host. Same pool-membership query the auto_shutdown helper
# uses, inverted (start instead of shutdown).
start_vms() {
  log "1b. Starting any stopped VMs"
  local k=""; [ "${PROXMOX_VE_INSECURE:-false}" = "true" ] && k="-k"
  local base="${PROXMOX_VE_ENDPOINT%/}"
  local auth="Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN"
  local members
  members="$(curl -s $k -H "$auth" "$base/api2/json/pools/$LAB" \
    | python3 -c 'import json,sys
try: d=json.load(sys.stdin).get("data",{})
except Exception: d={}
for m in d.get("members",[]):
    if m.get("type")=="qemu": print(m["node"], m["vmid"])' 2>/dev/null || true)"
  [ -z "$members" ] && { echo "  no VMs found yet — continuing"; return; }
  while read -r node vmid; do
    [ -n "$node" ] && [ -n "$vmid" ] || continue
    curl -s $k -H "$auth" -X POST "$base/api2/json/nodes/$node/qemu/$vmid/status/start" >/dev/null 2>&1 || true
  done <<< "$members"
  # brief settle so WinRM/SSH have a chance to come up before wg_up/ansible_up probe them
  sleep 30
}

# ---- WireGuard tunnel (the only path into the lab) --------------------------
# Same server-side wiring as the Azure flow: read the bastion's routable IP,
# pull the SSH key from state, register this host as a WireGuard peer.
wg_up() {
  log "2. WireGuard tunnel to the bastion"
  mkdir -p "$TF_DIR/ssh_keys"
  if [ ! -s "$TF_DIR/ssh_keys/bastion.pem" ]; then
    terraform -chdir="$TF_DIR" show -json | python3 -c '
import json,sys
d=json.load(sys.stdin)
for r in d.get("values",{}).get("root_module",{}).get("resources",[]):
    if r.get("address")=="tls_private_key.bastion_ssh":
        sys.stdout.write(r["values"]["private_key_pem"])
' > "$TF_DIR/ssh_keys/bastion.pem"
    chmod 600 "$TF_DIR/ssh_keys/bastion.pem"
  fi
  BASTION_IP="$(terraform -chdir="$TF_DIR" output -raw bastion_public_ip)"
  [ -n "$BASTION_IP" ] || die "no bastion_public_ip output — did apply finish?"
  [ -f "$TF_DIR/ssh_keys/client_wg.key" ] || wg genkey | tee "$TF_DIR/ssh_keys/client_wg.key" | wg pubkey > "$TF_DIR/ssh_keys/client_wg.pub"
  local CLIENT_PUB SERVER_PUB
  CLIENT_PUB="$(cat "$TF_DIR/ssh_keys/client_wg.pub")"
  SSH="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=20 -i $TF_DIR/ssh_keys/bastion.pem purpleforge@$BASTION_IP"
  local i=0; until $SSH true 2>/dev/null; do i=$((i+1)); [ "$i" -ge 20 ] && die "bastion SSH never came up at $BASTION_IP (check its routable NIC / mgmt_bridge)"; sleep 15; done
  SERVER_PUB="$($SSH 'sudo cat /etc/wireguard/publickey')"
  $SSH "sudo wg set wg0 peer $CLIENT_PUB allowed-ips 10.250.250.2/32 && sudo wg-quick save wg0"
  cat > "$TF_DIR/ssh_keys/pf-lab.conf" <<EOF
[Interface]
PrivateKey = $(cat "$TF_DIR/ssh_keys/client_wg.key")
Address = 10.250.250.2/32
[Peer]
PublicKey = $SERVER_PUB
Endpoint = $BASTION_IP:$WG_PORT
AllowedIPs = 10.250.250.0/24, $SUPERNET
PersistentKeepalive = 25
EOF
  sudo wg-quick down "$TF_DIR/ssh_keys/pf-lab.conf" 2>/dev/null || true
  sudo wg-quick up "$TF_DIR/ssh_keys/pf-lab.conf" || die "wg-quick up failed"
  echo "  tunnel up (bastion $BASTION_IP:$WG_PORT)"
}

# ---- bastion L3 routing for the lab VLANs (Proxmox-only) --------------------
# On Azure the VNet routes management<->domain subnets for free; on Proxmox the
# bastion has to become that router. For each domain, bring up a VLAN
# sub-interface on the bastion's internal NIC with the domain's .254 gateway IP
# (the address Windows hosts default-route to — see windows.tf), and enable
# forwarding. Idempotent: re-running just re-asserts the interfaces.
route_lab() {
  log "3. Bastion VLAN routing for the lab subnets"
  local rules
  rules="$(DOMAINS_JSON="$DOMAINS_JSON" python3 -c '
import json,os
d=json.loads(os.environ["DOMAINS_JSON"])
for _,v in d.items():
    print(v["vlan_id"], v["gateway_ip"], v["subnet"].split("/")[1])
')"
  # Detect the bastion NIC on the lab bridge = the one NOT carrying the default
  # route (net0 is the routable/mgmt NIC with the default gateway; net1 is the
  # lab-side NIC we tag per domain).
  local remote
  remote="$($SSH bash -s -- "$rules" <<'REMOTE'
set -e
RULES="$1"
sudo sysctl -w net.ipv4.ip_forward=1 >/dev/null
DEFAULT_IF=$(ip route show default | awk '{print $5; exit}')
LAB_IF=$(ip -o link show | awk -F': ' '{print $2}' | sed 's/@.*//' | grep -vx "lo" | grep -vx "$DEFAULT_IF" | grep -E '^(eth|ens|enp)' | head -1)
[ -n "$LAB_IF" ] || { echo "could not find lab-side NIC on bastion" >&2; exit 1; }
echo "$RULES" | while read -r VLAN GW PREFIX; do
  [ -n "$VLAN" ] || continue
  sudo ip link add link "$LAB_IF" name "${LAB_IF}.${VLAN}" type vlan id "$VLAN" 2>/dev/null || true
  sudo ip addr add "${GW}/${PREFIX}" dev "${LAB_IF}.${VLAN}" 2>/dev/null || true
  sudo ip link set "${LAB_IF}.${VLAN}" up
  echo "  routed VLAN ${VLAN} gw ${GW}/${PREFIX} on ${LAB_IF}"
done
REMOTE
)" || die "bastion VLAN routing setup failed"
  echo "$remote"
}

# ---- Ansible control node in Docker (Python 3.10 GOAD needs) ----------------
ansible_up() {
  log "4. Ansible control node (Docker, --network host to see the tunnel)"
  docker rm -f pf-ansible >/dev/null 2>&1 || true
  docker run -d --name pf-ansible --network host -v "$REPO:/repo" \
    -w "/repo/generated/$LAB/ansible" python:3.10-slim sleep infinity >/dev/null \
    || die "could not start the pf-ansible container"
  docker exec pf-ansible bash -c "pip install --quiet ansible-core==2.12.6 pywinrm rich psutil Jinja2 pyyaml ansible_runner" \
    || die "pip install in pf-ansible failed"
  docker exec pf-ansible bash -c "ansible-galaxy collection install ansible.windows:1.11.0 community.windows:1.11.0 chocolatey.chocolatey" \
    || die "ansible-galaxy collection install failed"
  docker exec pf-ansible python3 -c "import urllib.request; urllib.request.urlretrieve('https://galaxy.ansible.com/api/v3/plugin/ansible/content/published/collections/artifacts/community-general-6.6.2.tar.gz','/tmp/cg.tar.gz')" \
    && docker exec pf-ansible ansible-galaxy collection install /tmp/cg.tar.gz || warn "community.general install failed (only some roles need it) — continuing"
}

# ---- provision AD (site.yml enforces hardening-before-vulns order) ----------
run_site() {
  log "5. Provision AD -> population -> hardening -> vuln injection (site.yml)"
  local i=0
  until docker exec -w "/repo/generated/$LAB/ansible" pf-ansible ansible all -i inventory/hosts.yml -m ansible.windows.win_ping >/dev/null 2>&1; do
    i=$((i+1)); [ "$i" -ge 20 ] && { warn "win_ping never went green for every host — running site.yml anyway (it will retry)"; break; }
    echo "  waiting for WinRM on all hosts ($i)..."; sleep 20
  done
  local tries=0 max=6
  until docker exec -w "/repo/generated/$LAB/ansible" pf-ansible ansible-playbook -i inventory/hosts.yml playbooks/site.yml; do
    tries=$((tries+1))
    [ "$tries" -ge "$max" ] && die "site.yml still failing after $tries runs — inspect the error above"
    warn "site.yml failed (attempt $tries/$max) — re-running (idempotent; picks up where it left off)"
    docker exec pf-ansible true >/dev/null 2>&1 || { warn "pf-ansible container is gone — recreating it before the next attempt"; ansible_up; }
    sleep 15
  done
  echo "  provisioning complete"
}

# ---- auto_shutdown (CLAUDE.md #4) — best-effort local cron ------------------
# Proxmox has no native scheduled-shutdown (Azure uses DevTest schedules). This
# installs a cron on THIS deploy host that stops every VM in the lab's pool via
# the Proxmox API at the spec's auto_shutdown time. Best-effort: it only fires
# while this host is up. The API token is written to a gitignored 600 env file
# so cron (which has no exported env) can read it. teardown.sh removes both.
setup_auto_shutdown() {
  log "6. auto_shutdown ($AUTO_SHUTDOWN) — best-effort cron on this host"
  [ -n "$AUTO_SHUTDOWN" ] || { echo "  no auto_shutdown in spec — skipping"; return 0; }
  command -v crontab >/dev/null 2>&1 || { warn "crontab not available — auto_shutdown NOT installed; stop the lab manually with ./teardown.sh"; return 0; }
  local hh mm envf helper
  hh="$(printf '%s' "$AUTO_SHUTDOWN" | cut -d: -f1)"
  mm="$(printf '%s' "$AUTO_SHUTDOWN" | cut -d: -f2 | cut -d' ' -f1)"
  envf="$LAB_DIR/.pf-proxmox-env"
  helper="$LAB_DIR/pf-autoshutdown.sh"
  umask 077
  {
    printf 'PROXMOX_VE_ENDPOINT=%q\n' "$PROXMOX_VE_ENDPOINT"
    printf 'PROXMOX_VE_API_TOKEN=%q\n' "$PROXMOX_VE_API_TOKEN"
    printf 'PROXMOX_VE_INSECURE=%q\n' "${PROXMOX_VE_INSECURE:-false}"
  } > "$envf"
  cat > "$helper" <<HELPER
#!/usr/bin/env bash
# GENERATED — stops every VM in Proxmox pool '$LAB' via the API. gitignored.
set -uo pipefail
. "$envf"
K=""; [ "\${PROXMOX_VE_INSECURE:-false}" = "true" ] && K="-k"
BASE="\${PROXMOX_VE_ENDPOINT%/}"
AUTH="Authorization: PVEAPIToken=\$PROXMOX_VE_API_TOKEN"
curl -s \$K -H "\$AUTH" "\$BASE/api2/json/pools/$LAB" \
  | python3 -c 'import json,sys
d=json.load(sys.stdin).get("data",{})
for m in d.get("members",[]):
    if m.get("type")=="qemu": print(m["node"], m["vmid"])' \
  | while read -r NODE VMID; do
      curl -s \$K -H "\$AUTH" -X POST "\$BASE/api2/json/nodes/\$NODE/qemu/\$VMID/status/shutdown" >/dev/null || true
    done
HELPER
  chmod 700 "$helper"
  # Idempotent crontab: drop any prior line for this helper, add the new one.
  ( crontab -l 2>/dev/null | grep -vF "$helper"; printf '%s %s * * * %s\n' "$mm" "$hh" "$helper" ) | crontab - \
    && echo "  installed cron: $mm $hh daily -> stop pool '$LAB'" \
    || warn "could not install crontab entry — auto_shutdown not enforced"
}

# ---- clean-state snapshot (CLAUDE.md deploy order: the LAST provisioning ------
# step, AFTER hardening+vulns, BEFORE any attack). One Proxmox snapshot named
# "pf-clean" per lab VM, via the API — `forge reset` (reset.sh) rolls back to it.
# Best-effort: never fails the deploy.
snapshot_clean() {
  [ "${PF_SNAPSHOT:-1}" = "1" ] || { log "5b. Clean-state snapshot (skipped: PF_SNAPSHOT=0)"; return 0; }
  log "5b. Clean-state snapshot (post-hardening+vulns, pre-attack) — pf-clean"
  local k=""; [ "${PROXMOX_VE_INSECURE:-false}" = "true" ] && k="-k"
  local base="${PROXMOX_VE_ENDPOINT%/}"
  local auth="Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN"
  local members
  members="$(curl -s $k -H "$auth" "$base/api2/json/pools/$LAB" \
    | python3 -c 'import json,sys
try: d=json.load(sys.stdin).get("data",{})
except Exception: d={}
for m in d.get("members",[]):
    if m.get("type")=="qemu": print(m["node"], m["vmid"])' 2>/dev/null || true)"
  [ -z "$members" ] && { warn "no VMs found — skipping snapshot"; return 0; }
  while read -r node vmid; do
    [ -n "$node" ] && [ -n "$vmid" ] || continue
    echo "  snapshot vm $vmid -> pf-clean"
    # delete a stale pf-clean first so re-deploys refresh it (ignore if absent)
    curl -s $k -H "$auth" -X DELETE "$base/api2/json/nodes/$node/qemu/$vmid/snapshot/pf-clean" >/dev/null 2>&1 || true
    curl -s $k -H "$auth" -X POST "$base/api2/json/nodes/$node/qemu/$vmid/snapshot" \
      --data-urlencode "snapname=pf-clean" --data-urlencode "description=PurpleForge clean state (post-hardening+vulns, pre-attack)" >/dev/null 2>&1 \
      || warn "could not snapshot vm $vmid (continuing)"
  done <<< "$members"
  echo "  clean-state snapshot(s) done — reset with: forge reset {{ spec_rel }}"
}

main() {
  preflight
  ensure_secrets
  pick_template
  tf_apply
  start_vms
  wg_up
  route_lab
  ansible_up
  run_site
  snapshot_clean
  setup_auto_shutdown
  log "DEPLOY COMPLETE — $LAB"
  cat <<EOF

Next steps (no AI):
  # confirm the injected vulnerabilities are applied + exploitable:
  PYTHONPATH="$REPO/scripts" python3 -m forge validate "{{ spec_rel }}" --run
  # verify the live domain matches the plan (users/groups/NT hashes):
  PYTHONPATH="$REPO/scripts" python3 -m forge ad-inventory "{{ spec_rel }}"

When finished, tear everything down (removes every VM in the pool):
  ./teardown.sh
EOF
}

main "$@"
