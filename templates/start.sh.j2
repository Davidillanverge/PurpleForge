#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand (regenerated on every
# `forge generate`). STARTS {{ lab_name }} ({{ provider }}) after ./stop.sh (or
# auto_shutdown) powered it off — WITHOUT `terraform apply`: no resource is
# created, changed or re-written, and the Terraform state is only READ (via the
# cached terraform-outputs.json).
#
#   ./start.sh [<generated-lab-dir>]
#
# Steps: power on every VM via the provider API -> re-establish the WireGuard
# tunnel -> {% if provider == "proxmox" %}re-assert the bastion VLAN routing (not persistent across a reboot) -> {% endif %}verify network/SSH
# (bastion SSH, WireGuard handshake, WinRM on every host; connectivity.json).
# Credentials resolve exactly like deploy.sh. PF_CONNECT_TIMEOUT (default 900s)
# bounds the wait for Windows to finish booting.
# =============================================================================
set -uo pipefail

# Reuse deploy.sh's functions (sourced = definitions only, main() does not run).
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/deploy.sh" "$@"

{% if provider == "azure" %}
# terraform-outputs.json is cached by deploy.sh; if it is missing, reading the
# outputs needs the remote-state access key (read-only lookup, nothing created).
backend_access_key() {
  [ -s "$LAB_DIR/$OUTPUTS_JSON_NAME" ] && return 0
  [ -f "$TF_DIR/backend.hcl" ] || return 0
  local sa rg
  sa="$(python3 -c "import re,sys;print(re.search(r'storage_account_name\s*=\s*\"([^\"]+)\"', open(sys.argv[1]).read()).group(1))" "$TF_DIR/backend.hcl" 2>/dev/null || true)"
  rg="$(python3 -c "import re,sys;print(re.search(r'resource_group_name\s*=\s*\"([^\"]+)\"', open(sys.argv[1]).read()).group(1))" "$TF_DIR/backend.hcl" 2>/dev/null || true)"
  [ -n "$sa" ] && [ -n "$rg" ] || return 0
  ARM_ACCESS_KEY="$(az storage account keys list -n "$sa" -g "$rg" --query "[0].value" -o tsv 2>/dev/null || true)"
  export ARM_ACCESS_KEY
}
{% endif %}
start_main() {
  log "START $LAB — power on the existing lab (no terraform apply, state untouched)"
  preflight
{% if provider == "azure" %}
  backend_access_key
{% endif %}
  pf_ensure_outputs
  start_vms
{% if provider == "aws" %}
  local ids
  ids="$(_lab_instance_ids)"
  [ -n "$ids" ] && { echo "  waiting for instances to be running..."; aws ec2 wait instance-running --instance-ids $ids 2>/dev/null || warn "not every instance reported running yet"; }
{% endif %}
  wg_up
{% if provider == "proxmox" %}
  route_lab
{% endif %}
  pf_check_connectivity || die "lab powered on but NOT fully reachable — see connectivity.json (try ./restart.sh for a hung VM)"
  log "START COMPLETE — $LAB is up and reachable over the tunnel"
}

start_main
