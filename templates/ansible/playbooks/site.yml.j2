{#
  PurpleForge — master deploy sequence (GENERATED, do not edit).
  Rendered by forge generate. CLAUDE.md invariant: hardening
  applies BEFORE vulnerabilities are injected; deploy order is
  infra(terraform) -> ad-topology -> service-provisioning -> ad-population ->
  hardening baseline -> vuln-injection -> EDR/telemetry -> snapshot.
  service-provisioning installs what machines[].services declares (e.g.
  mssql) SECURELY — it's establishing what the machine IS, not a vuln or a
  hardening control; requires_services vulns land afterwards, in
  vuln-injection. This file is the single entry point a /deploy command
  should run — never invoke the individual playbooks out of order by hand.
  Only imports playbooks scripts/forge/ actually rendered (e.g.
  vuln-injection.yml doesn't exist for a 0-vuln spec).

  NOTE: no post-deploy snapshot step exists yet. CLAUDE.md's deploy order
  calls for a clean-state snapshot here, after vuln-injection and before any
  purple-team attack — that requires either an azurerm VM/managed-disk
  snapshot resource wired into a real /deploy orchestrator, or an
  ansible-side equivalent, neither of which has been built or tested against
  a live Azure subscription. Track it before relying on "reset between
  exercises" — don't assume it exists because this file runs cleanly.
#}
---
- import_playbook: ad-topology.yml
{% if has_service_provisioning %}
- import_playbook: service-provisioning.yml
{% endif %}
{% if has_application_provisioning %}
- import_playbook: application-provisioning.yml
{% endif %}
- import_playbook: ad-population.yml
- import_playbook: defensive-controls.yml
{% if has_replication_wait %}
# Multi-DC / multi-domain: wait for AD replication to converge so every object,
# ACL and GPO change from the steps above is present on all DCs before vulns are
# injected and before validation hits a different DC (Creation -> Replication
# Delay -> Misconfiguration Injection). No-ops fast on a single-DC domain.
- import_playbook: replication-convergence.yml
{% endif %}
{% if has_vuln_injection %}
- import_playbook: vuln-injection.yml
{% endif %}
{% if has_telemetry %}
# DETECT pillar: install/enroll the telemetry agents (elastic-agent, WARP) on the
# defended+gapped box, BEFORE the clean snapshot so they're part of the baseline.
# Agents only — backends/policies/rules are operator-configured; backend creds are
# deploy-time extra-vars.
- import_playbook: telemetry-provisioning.yml
{% endif %}
{% if has_bas %}
# BAS pillar (adversary emulation): install/enroll the Caldera sandcat beacon,
# AFTER telemetry and BEFORE the clean snapshot — the dormant agent is part of the
# defended baseline (like the EDR), while the Caldera operations themselves are
# attacks that run AFTER the snapshot (like /validate). Agents only — the operator
# stands up the Caldera server (cloud or local Kali) and launches operations;
# server creds are deploy-time extra-vars, never in the spec.
- import_playbook: bas-provisioning.yml
{% endif %}
