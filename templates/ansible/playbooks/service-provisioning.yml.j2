{#
  PurpleForge — service-provisioning playbook for {{ lab_name }} (GENERATED,
  do not edit). Installs the infra services machines[].services declares —
  today only `mssql` is wired (iis/sccm remain declared-but-unconsumed, Tier B
  backlog — see NON-AD-VULNS-ROADMAP.md). Reuses vendor/GOAD's mssql role's
  install mechanics, trimmed to a SECURE base install (sa disabled,
  Windows-auth only, xp_cmdshell off) — any vuln that requires_services this
  host lands afterwards, in vuln-injection, same hardening-before-gaps order.

  Deploy order (CLAUDE.md / site.yml.j2): runs after ad-topology (the
  member-server is already domain-joined) and before ad-population/hardening
  — this establishes what the machine IS, not a vuln or a hardening control.
#}
---
{% for m in mssql_hosts %}
- name: "PurpleForge | service-provisioning | mssql -> {{ m }}"
  hosts: {{ m }}
  gather_facts: false
  vars:
    service_files_dir: "{{ '{{' }} playbook_dir {{ '}}' }}/files"
    mssql_baseline_sa_password: "{{ '{{' }} lookup('password', '/dev/null length=24 chars=ascii_letters,digits') {{ '}}' }}"
  tasks:
    - name: "mssql-install | provision"
      ansible.builtin.include_tasks: "{{ '{{' }} playbook_dir {{ '}}' }}/../services/mssql-install.yml"
{% endfor %}
{% for m in adcs_hosts %}
- name: "PurpleForge | service-provisioning | adcs -> {{ m }}"
  hosts: {{ m }}
  gather_facts: false
  tasks:
    - name: "adcs-install | provision"
      ansible.builtin.include_tasks: "{{ '{{' }} playbook_dir {{ '}}' }}/../services/adcs-install.yml"
{% endfor %}
{% if adcs_hosts %}
# The EnterpriseRootCA install publishes its cert to AD's NTAuth store, but the
# DC caches NTAuth locally and only refreshes on GP/autoenrollment — until it
# does, PKINIT with an ADCS-issued cert (the end of an ESC1 chain) fails with
# KDC_ERROR_CLIENT_NOT_TRUSTED. Pull the freshly-published CA into the DC's
# NTAuth cache now, before the clean snapshot, so cert-logon works out of the box.
- name: "PurpleForge | service-provisioning | refresh DC NTAuth cache for ADCS cert logon"
  hosts: domain_controllers
  gather_facts: false
  tasks:
    - name: "adcs | pulse autoenrollment + refresh computer GP so NTAuth is populated"
      ansible.windows.win_shell: |
        certutil -pulse
        gpupdate /target:computer /force
      changed_when: false
      failed_when: false
{% endif %}
