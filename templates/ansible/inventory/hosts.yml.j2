{#
  PurpleForge — Ansible inventory for {{ lab_name }}.
  Rendered by scripts/forge.py generate from lab-manifest.json's topology
  (see .claude/skills/ad-topology/SKILL.md for the group-assignment rules).
  WinRM is only reachable from the management subnet (network-topology's NSG
  rules) — i.e. only through the WireGuard bastion, never directly.
#}
all:
  vars:
    ansible_user: ansible
    ansible_password: "{{ '{{ pf_ansible_password }}' }}"
    ansible_connection: winrm
    # basic, not ntlm — verified against a real deploy that cross-machine
    # WinRM/NTLM to a DOMAIN CONTROLLER over HTTPS fails ("the specified
    # credentials were rejected") even with the exact same, confirmed-correct
    # credentials — NTLM's Channel Binding Token computation over a
    # self-signed cert (ansible_winrm_server_cert_validation: ignore, right
    # below) apparently doesn't line up the same way for a DC as it does for
    # a plain member server/workstation, where ntlm worked fine. Basic auth
    # has no CBT step to mismatch; it's already confirmed enabled
    # (WSMan:\localhost\Service\Auth\Basic) and this is already HTTPS inside
    # the isolated management-subnet-only WinRM path (see network-topology's
    # NSG rules), not Basic-over-HTTP.
    ansible_winrm_transport: basic
    ansible_winrm_server_cert_validation: ignore
    ansible_port: 5986
    local_admin_username: "{{ local_admin_username }}"
    # Provider baked in at generate time so provider-specific playbook steps can
    # branch (e.g. ad-topology's pre-promotion local-admin handling differs on
    # Proxmox templates, which ship an enabled built-in RID-500 Administrator).
    pf_provider: "{{ provider }}"
    two_adapters: false
    nat_adapter: ""
    add_route: "no"
    domain_adapter: "{{ domain_adapter }}"
    dns_server_forwarder: "{{ dns_server_forwarder }}"
    pf_supernet: "{{ pf_supernet }}"
    force_dns_server: "no"
    http_proxy: "no"
    ad_http_proxy: ""
    ad_https_proxy: ""
  children:
{% if groups.domain_controllers %}
    domain_controllers:
      hosts:
{% for h in groups.domain_controllers %}
        {{ h.name }}:
          ansible_host: "{{ h.ip }}"
          hostname: "{{ h.name }}"
          domain: "{{ h.domain }}"
          domain_name: "{{ h.domain }}"
          netbios_name: "{{ h.netbios_name }}"
          domain_username: {{ h.domain_username }}
          domain_password: "{{ '{{ pf_admin_password }}' }}"
          dns_domain: "{{ h.dns_domain }}"
{% endfor %}
{% endif %}
{% if groups.domain_controllers_additional %}
    domain_controllers_additional:
      hosts:
{% for h in groups.domain_controllers_additional %}
        {{ h.name }}:
          ansible_host: "{{ h.ip }}"
          hostname: "{{ h.name }}"
          domain: "{{ h.domain }}"
          domain_name: "{{ h.domain_name }}"
          netbios_name: "{{ h.netbios_name }}"
          domain_username: {{ h.domain_username }}
          domain_password: "{{ '{{ pf_admin_password }}' }}"
          dns_domain: "{{ h.dns_domain }}"
{% endfor %}
{% endif %}
{% if groups.child_domain_controllers %}
    child_domain_controllers:
      hosts:
{% for h in groups.child_domain_controllers %}
        {{ h.name }}:
          ansible_host: "{{ h.ip }}"
          hostname: "{{ h.name }}"
          domain: "{{ h.domain }}"
          domain_name: "{{ h.domain_name }}"
          netbios_name: "{{ h.netbios_name }}"
          domain_password: "{{ '{{ pf_admin_password }}' }}"
          dns_domain: "{{ h.dns_domain }}"
          parent_domain: "{{ h.parent_domain }}"
          parent_domain_user: {{ h.parent_domain_user }}
          parent_domain_password: "{{ '{{ pf_admin_password }}' }}"
          source_dc: "{{ h.source_dc }}"
{% endfor %}
{% endif %}
{% if groups.trust_anchors %}
    trust_anchors:
      hosts:
{% for h in groups.trust_anchors %}
        {{ h.name }}:
          ansible_host: "{{ h.ip }}"
          domain_username: {{ h.domain_username }}
          domain_password: "{{ '{{ pf_admin_password }}' }}"
          remote_forest: "{{ h.remote_forest }}"
          remote_admin: {{ h.remote_admin }}
          remote_admin_password: "{{ '{{ pf_admin_password }}' }}"
{% endfor %}
{% endif %}
{% if groups.member_servers %}
    member_servers:
      hosts:
{% for h in groups.member_servers %}
        {{ h.name }}:
          ansible_host: "{{ h.ip }}"
          hostname: "{{ h.name }}"
          member_domain: "{{ h.member_domain }}"
          domain_username: {{ h.domain_username }}
          domain_password: "{{ '{{ pf_admin_password }}' }}"
          dns_domain: "{{ h.dns_domain }}"
{% endfor %}
{% endif %}
{% if groups.workstations %}
    workstations:
      hosts:
{% for h in groups.workstations %}
        {{ h.name }}:
          ansible_host: "{{ h.ip }}"
          hostname: "{{ h.name }}"
          member_domain: "{{ h.member_domain }}"
          domain_username: {{ h.domain_username }}
          domain_password: "{{ '{{ pf_admin_password }}' }}"
          dns_domain: "{{ h.dns_domain }}"
{% endfor %}
{% endif %}
