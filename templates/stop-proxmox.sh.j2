#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand (regenerated on every
# `forge generate`). STOPS {{ lab_name }} on Proxmox WITHOUT destroying it and
# WITHOUT touching Terraform state (terraform.tfstate is not read or written):
# every VM in pool $LAB gets a GRACEFUL guest shutdown via the Proxmox API
# (status/shutdown — ACPI / QEMU guest agent, so the DCs close AD cleanly). A VM
# that has not powered off after PF_SHUTDOWN_TIMEOUT seconds (default 300) is
# then hard-stopped. Disks, AD state and the pf-clean snapshot all survive.
#
#   ./stop.sh [<generated-lab-dir>]
#
# Idempotent: an already-stopped lab exits 0. Bring it back with ./start.sh
# (`forge start {{ spec_rel }}`). Needs the same PROXMOX_VE_* the deploy used
# (sourced from .pf-proxmox-env automatically).
# =============================================================================
set -uo pipefail

LAB="{{ lab_name }}"

{% include "_lifecycle-common.sh.j2" %}
pf_resolve_lab_dir "$@"
TF_DIR="$LAB_DIR/terraform/proxmox"
ENV_FILE="$LAB_DIR/.pf-proxmox-env"

need curl; need python3
# Sourced inside bash so the token's `!` never triggers zsh history expansion.
if [ -z "${PROXMOX_VE_ENDPOINT:-}" ] && [ -f "$ENV_FILE" ]; then
  set -a; . "$ENV_FILE"; set +a
fi
[ -n "${PROXMOX_VE_ENDPOINT:-}" ] || die "PROXMOX_VE_ENDPOINT not set (export it or fill $ENV_FILE)"
[ -n "${PROXMOX_VE_API_TOKEN:-}" ] || die "PROXMOX_VE_API_TOKEN not set (export it or fill $ENV_FILE)"

K=""; [ "${PROXMOX_VE_INSECURE:-false}" = "true" ] && K="-k"
BASE="${PROXMOX_VE_ENDPOINT%/}"
AUTH="Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN"

# "node vmid status" for every VM in the lab pool.
pool_vms() {
  curl -s $K -H "$AUTH" "$BASE/api2/json/pools/$LAB" \
    | python3 -c 'import json,sys
try: d=json.load(sys.stdin).get("data",{})
except Exception: d={}
for m in d.get("members",[]):
    if m.get("type")=="qemu": print(m["node"], m["vmid"], m.get("status","unknown"))' 2>/dev/null || true
}
vm_status() {
  curl -s $K -H "$AUTH" "$BASE/api2/json/nodes/$1/qemu/$2/status/current" \
    | python3 -c 'import json,sys
try: print(json.load(sys.stdin)["data"]["status"])
except Exception: print("unknown")'
}

log "1. Graceful shutdown of every VM in pool '$LAB'"
members="$(pool_vms)"
[ -n "$members" ] || { echo "  no VMs in pool '$LAB' — not deployed (nothing to stop)"; members=""; }
running="$(printf '%s\n' "$members" | awk 'NF==3 && $3!="stopped"{print $1, $2}')"
if [ -n "$members" ] && [ -z "$running" ]; then
  echo "  every VM already stopped"
fi
timeout="${PF_SHUTDOWN_TIMEOUT:-300}"
while read -r node vmid; do
  [ -n "${node:-}" ] && [ -n "${vmid:-}" ] || continue
  echo "  shutdown vm $vmid (timeout ${timeout}s)"
  curl -s $K -H "$AUTH" -X POST "$BASE/api2/json/nodes/$node/qemu/$vmid/status/shutdown" \
    --data-urlencode "timeout=$timeout" >/dev/null 2>&1 || warn "shutdown request failed for vm $vmid"
done <<< "$running"

if [ -n "$running" ]; then
  echo "  waiting for the guests to power off..."
  deadline=$(( $(date +%s) + timeout + 30 ))
  while :; do
    left=""
    while read -r node vmid; do
      [ -n "${node:-}" ] || continue
      [ "$(vm_status "$node" "$vmid")" = "stopped" ] || left="$left$node $vmid"$'\n'
    done <<< "$running"
    [ -z "$left" ] && { echo "  all VMs powered off cleanly"; break; }
    if [ "$(date +%s)" -ge "$deadline" ]; then
      while read -r node vmid; do
        [ -n "${node:-}" ] || continue
        warn "vm $vmid ignored the graceful shutdown — hard stop"
        curl -s $K -H "$AUTH" -X POST "$BASE/api2/json/nodes/$node/qemu/$vmid/status/stop" >/dev/null 2>&1 \
          || warn "could not stop vm $vmid — stop it in the Proxmox UI"
      done <<< "$left"
      break
    fi
    sleep 10
  done
fi

log "2. Local session cleanup"
pf_local_down
log "STOP COMPLETE — $LAB is powered off (terraform state untouched). Resume with: ./start.sh"
