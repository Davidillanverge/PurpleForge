#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand (regenerated on every
# `forge generate`). STOPS {{ lab_name }} on Proxmox WITHOUT destroying it:
# every lab VM is powered off, freeing the host's CPU/RAM. On-prem there is no
# cloud bill, but a stopped VM consumes no host resources — this is the pause
# button, not teardown. Disks, AD state and the pf-clean snapshot all survive.
#
#   PROXMOX_VE_ENDPOINT=... PROXMOX_VE_API_TOKEN=... ./stop.sh
#
# Bring it back later with `forge deploy {{ spec_rel }}` (deploy.sh starts
# stopped VMs). Needs the same PROXMOX_VE_* the deploy used.
# =============================================================================
set -uo pipefail

LAB="{{ lab_name }}"
cd "$(dirname "$0")"
LAB_DIR="$PWD"
ENV_FILE="$LAB_DIR/.pf-proxmox-env"

log()  { printf '\n\033[1;35m== %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mFAIL:\033[0m %s\n' "$*" >&2; exit 1; }

command -v curl >/dev/null 2>&1 || die "missing prerequisite: curl"
# Reuse the credentials deploy.sh persisted (or an exported env). Sourced inside
# this bash script so the token's `!` never triggers zsh history expansion.
if [ -z "${PROXMOX_VE_ENDPOINT:-}" ] && [ -f "$ENV_FILE" ]; then
  set -a; . "$ENV_FILE"; set +a
fi
[ -n "${PROXMOX_VE_ENDPOINT:-}" ] || die "PROXMOX_VE_ENDPOINT not set (export it or fill $ENV_FILE)"
[ -n "${PROXMOX_VE_API_TOKEN:-}" ] || die "PROXMOX_VE_API_TOKEN not set (export it or fill $ENV_FILE)"

K=""; [ "${PROXMOX_VE_INSECURE:-false}" = "true" ] && K="-k"
BASE="${PROXMOX_VE_ENDPOINT%/}"
AUTH="Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN"

members="$(curl -s $K -H "$AUTH" "$BASE/api2/json/pools/$LAB" \
  | python3 -c 'import json,sys
try: d=json.load(sys.stdin).get("data",{})
except Exception: d={}
for m in d.get("members",[]):
    if m.get("type")=="qemu": print(m["node"], m["vmid"])' 2>/dev/null || true)"
[ -n "$members" ] || die "no VMs found in Proxmox pool '$LAB' — is the lab deployed?"

log "Stopping every lab VM (host CPU/RAM released)"
while read -r node vmid; do
  [ -n "$node" ] && [ -n "$vmid" ] || continue
  echo "  stop vm $vmid"
  curl -s $K -H "$AUTH" -X POST "$BASE/api2/json/nodes/$node/qemu/$vmid/status/stop" >/dev/null 2>&1 \
    || warn "could not stop vm $vmid — stop it manually"
done <<< "$members"
log "STOP complete — $LAB is powered off. Resume with: forge deploy {{ spec_rel }}"
