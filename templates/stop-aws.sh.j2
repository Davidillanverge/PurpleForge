#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand (regenerated on every
# `forge generate`). STOPS {{ lab_name }} on AWS/{{ region }} WITHOUT destroying
# it and WITHOUT touching Terraform state: every EC2 instance tagged lab=$LAB is
# stopped through the EC2 API (stop-instances = an ACPI shutdown, so Windows
# shuts down cleanly), you stop paying for compute, and EBS volumes, AD state,
# the bastion's Elastic IP and the clean-state AMIs all survive.
#
#   ./stop.sh [<generated-lab-dir>]
#
# Idempotent: an already-stopped lab exits 0. Bring it back with ./start.sh
# (`forge start {{ spec_rel }}`). Credentials/region resolve like deploy.sh.
# =============================================================================
set -uo pipefail

LAB="{{ lab_name }}"
REGION="${PF_REGION:-{{ region }}}"
export AWS_REGION="$REGION" AWS_DEFAULT_REGION="$REGION"  # pin AWS_REGION too: CLI v2 lets it beat AWS_DEFAULT_REGION, so a stale ambient AWS_REGION (e.g. from .env) would hijack every call

{% include "_lifecycle-common.sh.j2" %}
pf_resolve_lab_dir "$@"
TF_DIR="$LAB_DIR/terraform/aws"

preflight() {
  log "0. Preflight"
  need aws
  aws sts get-caller-identity >/dev/null 2>&1 \
    || die "AWS credentials not usable: configure env vars / AWS_PROFILE / 'aws sso login'"
  echo "  account: $(aws sts get-caller-identity --query Account --output text)   region: $REGION"
}

stop_vms() {
  log "1. Graceful stop of every EC2 instance in $LAB"
  local ids
  ids="$(aws ec2 describe-instances \
          --filters "Name=tag:lab,Values=$LAB" "Name=instance-state-name,Values=pending,running,stopping" \
          --query 'Reservations[].Instances[].InstanceId' --output text 2>/dev/null || true)"
  if [ -z "$ids" ]; then
    echo "  no running instances tagged lab=$LAB — already stopped (or not deployed)"
    return 0
  fi
  echo "  stopping: $ids"
  aws ec2 stop-instances --instance-ids $ids >/dev/null \
    || die "stop-instances failed — see the error above"
  echo "  waiting until every instance is stopped..."
  aws ec2 wait instance-stopped --instance-ids $ids \
    || die "instances did not all reach 'stopped' — check the EC2 console"
  echo "  all stopped"
}

preflight
stop_vms
log "2. Local session cleanup"
pf_local_down
log "STOP COMPLETE — $LAB is stopped (terraform state untouched). Resume with: ./start.sh"
