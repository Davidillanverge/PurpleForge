#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand (regenerated on every
# `forge generate`). STOPS {{ lab_name }} on AWS/{{ region }} at minimal cost
# WITHOUT destroying it: every EC2 instance is STOPPED (you stop paying for
# compute — only the cheap EBS volumes remain). This is the pause button, not
# teardown.
#
#   ./stop.sh            # stop every EC2 instance in the lab
#
# Bring it back later with `forge deploy {{ spec_rel }}` — deploy.sh starts any
# stopped instance, re-establishes the tunnel, and re-runs the idempotent
# site.yml. Nothing is lost: EBS volumes, AD state and the clean-state AMI all
# survive a stop. (A stopped instance keeps its instance-id but gets a NEW
# private IP only if not in a fixed subnet — the lab's are fixed, so IPs hold.)
#
# Credentials/region resolve exactly like deploy.sh (env vars / AWS_PROFILE /
# 'aws sso login'; PF_REGION overrides the region).
# =============================================================================
set -uo pipefail

LAB="{{ lab_name }}"
REGION="${PF_REGION:-{{ region }}}"

cd "$(dirname "$0")"
export AWS_DEFAULT_REGION="$REGION"

log()  { printf '\n\033[1;35m== %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mFAIL:\033[0m %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing prerequisite: $1"; }

preflight() {
  log "0. Preflight"
  for b in aws; do need "$b"; done
  aws sts get-caller-identity >/dev/null 2>&1 \
    || die "AWS credentials not usable: configure env vars / AWS_PROFILE / 'aws sso login'"
  echo "  account: $(aws sts get-caller-identity --query Account --output text)   region: $REGION"
}

# ---- stop every running instance tagged for this lab ------------------------
stop_vms() {
  log "1. Stopping every EC2 instance in $LAB (compute released — minimal cost)"
  local ids
  ids="$(aws ec2 describe-instances \
          --filters "Name=tag:lab,Values=$LAB" "Name=instance-state-name,Values=pending,running" \
          --query 'Reservations[].Instances[].InstanceId' --output text 2>/dev/null || true)"
  [ -z "$ids" ] && die "no running instances tagged lab=$LAB — is the lab deployed/already stopped? (nothing to stop)"
  echo "  stopping: $ids"
  aws ec2 stop-instances --instance-ids $ids >/dev/null 2>&1 || warn "stop-instances failed — stop them manually"
}

preflight
stop_vms
log "STOP complete — $LAB is stopped (minimal cost). Resume with: forge deploy {{ spec_rel }}"
