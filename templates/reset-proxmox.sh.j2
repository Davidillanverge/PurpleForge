#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand. Resets {{ lab_name }} to its
# CLEAN-STATE snapshot ("pf-clean", taken at the end of deploy.sh AFTER
# hardening + vuln injection but BEFORE any attack — CLAUDE.md deploy order),
# so exercises restart from the same pristine, fully-instrumented lab.
#
# Rolls every lab VM back to pf-clean via the Proxmox API, then starts it.
# Needs the same PROXMOX_VE_ENDPOINT / PROXMOX_VE_API_TOKEN the deploy used.
# Best-effort per VM; a VM with no pf-clean snapshot is skipped with a warning.
#
#   PROXMOX_VE_ENDPOINT=... PROXMOX_VE_API_TOKEN=... ./reset.sh
# =============================================================================
set -uo pipefail

LAB="{{ lab_name }}"
cd "$(dirname "$0")"
LAB_DIR="$PWD"
ENV_FILE="$LAB_DIR/.pf-proxmox-env"

log()  { printf '\n\033[1;35m== %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mFAIL:\033[0m %s\n' "$*" >&2; exit 1; }

command -v curl >/dev/null 2>&1 || die "missing prerequisite: curl"
# Reuse the credentials deploy.sh persisted (or an exported env). Sourced inside
# this bash script so the token's `!` never triggers zsh history expansion.
if [ -z "${PROXMOX_VE_ENDPOINT:-}" ] && [ -f "$ENV_FILE" ]; then
  set -a; . "$ENV_FILE"; set +a
fi
[ -n "${PROXMOX_VE_ENDPOINT:-}" ] || die "PROXMOX_VE_ENDPOINT not set (export it or fill $ENV_FILE)"
[ -n "${PROXMOX_VE_API_TOKEN:-}" ] || die "PROXMOX_VE_API_TOKEN not set (export it or fill $ENV_FILE)"

K=""; [ "${PROXMOX_VE_INSECURE:-false}" = "true" ] && K="-k"
BASE="${PROXMOX_VE_ENDPOINT%/}"
AUTH="Authorization: PVEAPIToken=$PROXMOX_VE_API_TOKEN"

members="$(curl -s $K -H "$AUTH" "$BASE/api2/json/pools/$LAB" \
  | python3 -c 'import json,sys
try: d=json.load(sys.stdin).get("data",{})
except Exception: d={}
for m in d.get("members",[]):
    if m.get("type")=="qemu": print(m["node"], m["vmid"])' 2>/dev/null || true)"
[ -n "$members" ] || die "no VMs found in Proxmox pool '$LAB' — is the lab deployed?"

log "Rolling every lab VM back to pf-clean"
while read -r node vmid; do
  [ -n "$node" ] && [ -n "$vmid" ] || continue
  # confirm the snapshot exists before rolling back (a missing one would 500)
  if ! curl -s $K -H "$AUTH" "$BASE/api2/json/nodes/$node/qemu/$vmid/snapshot" 2>/dev/null | grep -q '"name":"pf-clean"'; then
    warn "vm $vmid has no pf-clean snapshot — skipping (was the deploy snapshot step run?)"; continue
  fi
  echo "  rollback vm $vmid -> pf-clean"
  curl -s $K -H "$AUTH" -X POST "$BASE/api2/json/nodes/$node/qemu/$vmid/snapshot/pf-clean/rollback" >/dev/null 2>&1 \
    || { warn "rollback failed for vm $vmid"; continue; }
  curl -s $K -H "$AUTH" -X POST "$BASE/api2/json/nodes/$node/qemu/$vmid/status/start" >/dev/null 2>&1 || warn "could not start vm $vmid — start it manually"
  echo "  done: vm $vmid restored to clean state"
done <<< "$members"

log "RESET COMPLETE — $LAB back to clean state (verify over the tunnel before re-attacking)"
