# ---- shared lifecycle helpers (rendered from _lifecycle-common.sh.j2) -------
# Included by every generated lifecycle script (deploy/start/stop/reset/teardown)
# so the lab-dir resolution, the terraform-outputs JSON, the connectivity probe
# and the local session cleanup are ONE implementation, not five drifting copies.

log()  { printf '\n\033[1;35m== %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mFAIL:\033[0m %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing prerequisite: $1"; }

# Lab directory = the first positional (non --flag) argument, so every script
# can be pointed at a generated lab explicitly:
#   ./deploy.sh generated/<lab>        bash deploy.sh /path/to/generated/<lab>
# With no path it defaults to the directory the script lives in. Every other
# argument (--force, --snapshot, --sizes-only ...) is collected in PF_FLAGS.
# The dir must hold this lab's lab-manifest.json (guards against running one
# lab's script against another lab's state) and live at <repo>/generated/<x>/,
# because ansible.cfg's roles_path reaches the repo's vendor/ relatively.
pf_resolve_lab_dir() {
  local arg path=""
  PF_FLAGS=()
  for arg in "$@"; do
    case "$arg" in
      --*) PF_FLAGS+=("$arg") ;;
      *)   if [ -z "$path" ]; then path="$arg"; else PF_FLAGS+=("$arg"); fi ;;
    esac
  done
  [ -n "$path" ] || path="$(dirname "${BASH_SOURCE[1]:-$0}")"
  [ -d "$path" ] || die "lab directory not found: $path"
  cd "$path" || die "cannot cd into $path"
  LAB_DIR="$PWD"
  [ -f "$LAB_DIR/lab-manifest.json" ] \
    || die "$LAB_DIR has no lab-manifest.json — not a generated lab (run 'forge generate {{ spec_rel }}')"
  local mlab
  mlab="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["lab"]["name"])' "$LAB_DIR/lab-manifest.json" 2>/dev/null || true)"
  [ "$mlab" = "$LAB" ] || die "$LAB_DIR is lab '$mlab', but this script was generated for '$LAB'"
  REPO="$(cd "$LAB_DIR/../.." && pwd)"
  [ -d "$REPO/vendor" ] || die "$LAB_DIR must live at <PurpleForge repo>/generated/<lab>/ (ansible roles resolve ../../../vendor)"
  LAB_REL="${LAB_DIR#"$REPO"/}"
}

pf_has_flag() { local f; for f in "${PF_FLAGS[@]+"${PF_FLAGS[@]}"}"; do [ "$f" = "$1" ] && return 0; done; return 1; }

# ---- terraform outputs -> JSON ------------------------------------------------
# `terraform output -json` is READ-ONLY (no plan/apply, the state is untouched).
# It is cached in terraform-outputs.json so start/reset/stop never need a
# backend round-trip — and so connectivity can be verified from it.
OUTPUTS_JSON_NAME="terraform-outputs.json"
pf_export_outputs() {
  local out="$LAB_DIR/$OUTPUTS_JSON_NAME" tmp
  tmp="$(mktemp)"
  if terraform -chdir="$TF_DIR" output -json > "$tmp" 2>/dev/null \
     && python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));sys.exit(0 if d.get("bastion_public_ip") else 1)' "$tmp"; then
    mv "$tmp" "$out"; chmod 600 "$out"
    echo "  terraform outputs -> $OUTPUTS_JSON_NAME"
    return 0
  fi
  rm -f "$tmp"
  return 1
}

# Make sure the outputs JSON exists: reuse the cached copy, else read it from
# state (needs an initialised terraform dir). Never applies anything.
pf_ensure_outputs() {
  [ -s "$LAB_DIR/$OUTPUTS_JSON_NAME" ] && { echo "  using cached $OUTPUTS_JSON_NAME"; return 0; }
  pf_export_outputs \
    || die "no terraform outputs available (no $OUTPUTS_JSON_NAME and 'terraform output' failed) — is the lab deployed? run ./deploy.sh first"
}

# pf_out <name>: a scalar output prints its value; a map prints "key<TAB>value" lines.
pf_out() {
  python3 - "$LAB_DIR/$OUTPUTS_JSON_NAME" "$1" <<'PY'
import json, sys
try:
    v = json.load(open(sys.argv[1]))[sys.argv[2]]["value"]
except Exception:
    sys.exit(0)
if isinstance(v, dict):
    for k, x in sorted(v.items()):
        print(f"{k}\t{x}")
else:
    print(v)
PY
}

# ---- connectivity probe (network + SSH) ---------------------------------------
# 1) SSH to the bastion (the only routable host), 2) a WireGuard handshake on
# the pf-lab tunnel, 3) a TCP connect to WinRM (5986) on every Windows host's
# private IP THROUGH the tunnel. Retries until PF_CONNECT_TIMEOUT seconds
# (default 900: Windows first boot / reboot is slow). Writes connectivity.json.
# Uses $BASTION_SSH (set by wg_up). Returns non-zero if anything is unreachable.
pf_check_connectivity() {
  log "Connectivity check (bastion SSH -> WireGuard -> WinRM on every host)"
  local deadline=$(( $(date +%s) + ${PF_CONNECT_TIMEOUT:-900} ))
  local ssh_ok=0 wg_ok=0 hosts
  hosts="$(pf_out windows_hosts)"
  [ -n "$hosts" ] || { warn "no windows_hosts in $OUTPUTS_JSON_NAME"; return 1; }
  while :; do
    ssh_ok=0; wg_ok=0
    $BASTION_SSH true >/dev/null 2>&1 && ssh_ok=1
    sudo wg show pf-lab latest-handshakes 2>/dev/null | awk '$2>0{f=1} END{exit !f}' && wg_ok=1
    if HOSTS="$hosts" SSH_OK="$ssh_ok" WG_OK="$wg_ok" python3 - "$LAB_DIR/connectivity.json" <<'PY'
import json, os, socket, sys, time
res = {"checked_at": int(time.time()),
       "bastion_ssh": os.environ["SSH_OK"] == "1",
       "wireguard_handshake": os.environ["WG_OK"] == "1",
       "winrm": {}}
for line in os.environ["HOSTS"].splitlines():
    name, ip = line.split("\t")
    try:
        socket.create_connection((ip, 5986), timeout=5).close(); ok = True
    except OSError:
        ok = False
    res["winrm"][name] = {"ip": ip, "port": 5986, "reachable": ok}
json.dump(res, open(sys.argv[1], "w"), indent=2)
all_ok = res["bastion_ssh"] and res["wireguard_handshake"] and all(h["reachable"] for h in res["winrm"].values())
for n, h in res["winrm"].items():
    print(f"  {'OK  ' if h['reachable'] else 'DOWN'} {n:<20} {h['ip']}:5986")
print(f"  {'OK  ' if res['bastion_ssh'] else 'DOWN'} bastion SSH")
print(f"  {'OK  ' if res['wireguard_handshake'] else 'DOWN'} WireGuard handshake (pf-lab)")
sys.exit(0 if all_ok else 1)
PY
    then
      echo "  all reachable (details: connectivity.json)"
      return 0
    fi
    [ "$(date +%s)" -ge "$deadline" ] && { warn "still unreachable after ${PF_CONNECT_TIMEOUT:-900}s (details: connectivity.json)"; return 1; }
    echo "  not all reachable yet — retrying in 20s"
    sleep 20
  done
}

# ---- local session state ------------------------------------------------------
# The WireGuard interface and the pf-ansible container only exist while you work
# on the lab; stop/teardown take them down. Never touches terraform state.
pf_local_down() {
  docker rm -f pf-ansible >/dev/null 2>&1 || true
  sudo wg-quick down "$TF_DIR/ssh_keys/pf-lab.conf" >/dev/null 2>&1 \
    || sudo ip link delete pf-lab >/dev/null 2>&1 || true
  echo "  pf-ansible container + pf-lab WireGuard interface down"
}
# ---- end shared lifecycle helpers ---------------------------------------------
