#!/usr/bin/env bash
# =============================================================================
# GENERATED by scripts/forge.py — DO NOT edit by hand (regenerated on every
# `forge.py generate`). Deploys {{ lab_name }} on {{ provider }}/{{ region }}
# end-to-end, without AI. Idempotent and safe to re-run: every step checks
# for existing state first, and the ansible/terraform steps retry on the
# transient failures documented in AZURE-DEPLOY-RUNBOOK.md.
#
#   ./deploy.sh            # full deploy
#   ./deploy.sh --sizes-only   # only (re)write the sizes/images auto.tfvars and exit
#
# Prereqs (once per machine): terraform az docker wireguard-tools openssl curl.
#
# CHOOSE THE AZURE ACCOUNT — this script bakes NO credentials; it deploys into
# whatever account/subscription you authenticate with here. Two ways:
#
#   A) Interactive user login (simplest, for your own account):
#        az login                              # sign in to the target account
#        az account set --subscription <id>    # pick the target subscription
#      then run ./deploy.sh — it deploys into that subscription.
#
#   B) Service principal (CI, or a non-interactive/other account) — export these
#      4 env vars before running, no `az login` needed:
#        export ARM_TENANT_ID=<tenant-id>
#        export ARM_SUBSCRIPTION_ID=<subscription-id>
#        export ARM_CLIENT_ID=<sp-app-id>
#        export ARM_CLIENT_SECRET=<sp-password>
#      Create the SP (once, from an account that can grant roles):
#        az ad sp create-for-rbac --name pf-deployer \
#          --role Contributor --scopes /subscriptions/<subscription-id>
#      (the --role/--scopes are REQUIRED or the SP gets zero access — see runbook)
#
#   ARM_SUBSCRIPTION_ID always wins over the `az` default, so exporting just that
#   targets a specific subscription without `az account set`. Region/SKU are
#   overridable with PF_REGION / PF_VM_SIZE (below). Full symptom->cause table:
#   AZURE-DEPLOY-RUNBOOK.md.
# =============================================================================
set -uo pipefail   # deliberately NOT -e: failures are handled explicitly (retries)

LAB="{{ lab_name }}"
# Account/subscription independence: this script bakes NOTHING account-specific.
# The subscription is resolved at deploy time (ARM_SUBSCRIPTION_ID or the current
# `az` login), the remote-state storage account is minted per-deployer, and the
# region + VM size are overridable via env so the SAME generated lab deploys on
# ANYONE's account/region without editing the spec:
#   PF_REGION=<azure-region>   override the region (default: the spec's region)
#   PF_VM_SIZE=<sku>           force a VM SKU your account/region supports
#   PF_TFSTATE_RG=<rg-name>    override the remote-state resource group name
#
# IMAGE OVERRIDES — redeploy the SAME lab on a different Windows image without
# regenerating (the lab was e.g. generated for windows-server-2016; a later
# deploy wants 2022 or a golden image). All apply to EVERY Windows VM:
#   PF_OS=<os>                 stock image key: windows-server-2016|2019|2022|
#                              2025, windows-10-22h2, windows-11-23h2 (default:
#                              each host's os baked at generate time)
#   PF_IMAGE_ID=<resource-id>  clone a custom managed-image / Shared Image
#                              Gallery version instead (e.g. a golden image with
#                              EDR pre-installed); wins over PF_OS
#   PF_IMAGE_PUBLISHER=<p> PF_IMAGE_OFFER=<o> PF_IMAGE_SKU=<s>
#                              a marketplace image PurpleForge has no key for
#                              (set all three; PF_OS, if given, names the key)
#   PF_IMAGE_VERSION=<ver>     pin the marketplace image version (default latest)
# The hardening baseline still targets the os chosen at generate time — swap the
# backing image freely, but regenerate the spec to change the CIS/STIG baseline.
REGION="${PF_REGION:-{{ region }}}"
SUPERNET="{{ supernet }}"
DOMAIN="{{ domain }}"
WG_PORT="{{ wireguard_port }}"
BASTION_VM="${LAB}-bastion"
TFSTATE_RG="${PF_TFSTATE_RG:-purpleforge-tfstate-rg}"
# Cheap-first candidate 1-2 vCPU SKUs (AZURE-DEPLOY-RUNBOOK.md step 2). The first
# one that is unrestricted in $REGION for this subscription is used for every VM,
# keeping cost minimal and avoiding the #1 deploy blocker (an invalid SKU).
SKU_CANDIDATES=(Standard_B1s Standard_B2s Standard_F1as_v7 Standard_DC1s_v3 Standard_D2s_v3)

cd "$(dirname "$0")"
LAB_DIR="$PWD"
TF_DIR="$LAB_DIR/terraform/azure"
ANS_DIR="$LAB_DIR/ansible"
REPO="$(cd "$LAB_DIR/../.." && pwd)"

log()  { printf '\n\033[1;35m== %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mFAIL:\033[0m %s\n' "$*" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || die "missing prerequisite: $1 (see AZURE-DEPLOY-RUNBOOK.md step 0)"; }

preflight() {
  log "0. Preflight"
  for b in terraform az docker wg openssl curl python3; do need "$b"; done
  # az auth: either a cached user login or an ARM service principal in the env.
  if [ -z "${ARM_CLIENT_ID:-}" ]; then
    az account show >/dev/null 2>&1 || die "not logged in: run 'az login' (a real user in the subscription's tenant), or export ARM_CLIENT_ID/ARM_CLIENT_SECRET/ARM_TENANT_ID/ARM_SUBSCRIPTION_ID"
  fi
  SUB="${ARM_SUBSCRIPTION_ID:-$(az account show --query id -o tsv 2>/dev/null)}"
  [ -n "$SUB" ] || die "could not resolve the subscription id (set ARM_SUBSCRIPTION_ID)"
  export ARM_SUBSCRIPTION_ID="$SUB"
  echo "  subscription: $SUB   region: $REGION"
}

# ---- infra secrets (mint the domain-admin + ansible keys if this is a share) -
# Everything under generated/<lab>/ is versioned. Population USER passwords are
# fixed at lab creation and committed (group_vars/all/population-secrets.yml) —
# deploy NEVER (re)generates them. Only the two INFRA keys (domain admin +
# ansible WinRM) are per-deployer and gitignored; when a lab is shared and
# deployed without re-running `forge.py generate` they are absent, so we mint
# them here. Matches scripts/forge.py generate_password (same alphabet +
# complexity). Runs BEFORE terraform apply, which needs admin/ansible.
ensure_secrets() {
  log "0b. Infra secrets (domain admin + ansible WinRM)"
  local tf_secrets="$TF_DIR/secrets.auto.tfvars.json"
  local ans_secrets="$ANS_DIR/inventory/group_vars/all/secrets.yml"
  [ -f "$ANS_DIR/inventory/group_vars/all/population-secrets.yml" ] \
    || die "population-secrets.yml missing — it is committed with the lab; run 'forge.py generate {{ spec_rel }}' first"
  if [ -f "$tf_secrets" ] && [ -f "$ans_secrets" ]; then
    echo "  infra secrets already present — reusing (not a fresh share)"
    return 0
  fi
  echo "  fresh share detected — minting the two infra keys (population passwords are committed, not touched)"
  TF_OUT="$tf_secrets" ANS_OUT="$ans_secrets" python3 - <<'PY'
import json, os, secrets, string
symbols = "!@#*-_=+"   # cmd.exe-safe (no & ^ % $ < > | ") — see forge.py generate_password
alphabet = string.ascii_letters + string.digits + symbols
def pw(length=20):
    while True:
        p = "".join(secrets.choice(alphabet) for _ in range(length))
        if (any(c.islower() for c in p) and any(c.isupper() for c in p)
                and any(c.isdigit() for c in p) and any(c in symbols for c in p)):
            return p
admin, ansible = pw(), pw()
with open(os.environ["TF_OUT"], "w") as f:
    json.dump({"admin_password": admin, "ansible_password": ansible}, f, indent=2); f.write("\n")
os.makedirs(os.path.dirname(os.environ["ANS_OUT"]), exist_ok=True)
with open(os.environ["ANS_OUT"], "w") as f:
    f.write("# minted by deploy.sh — gitignored, never commit\n")
    json.dump({"pf_admin_password": admin, "pf_ansible_password": ansible}, f, indent=2); f.write("\n")
print("  minted domain-admin + ansible keys (population passwords untouched)")
PY
}

# ---- state backend (invariant #4: never local) -----------------------------
bootstrap_state() {
  log "1. Remote Terraform state backend"
  # A shared/committed lab ships WITHOUT backend.hcl (it is gitignored — it gets
  # patched with the deployer's own state storage account, which must not leak
  # into git). Recreate the static placeholder if absent so a fresh clone works;
  # the block below then mints the per-deployer storage account and patches it in.
  [ -f "$TF_DIR/backend.hcl" ] || printf \
    'resource_group_name  = "%s"\nstorage_account_name = "purpleforgetfstate"\ncontainer_name       = "tfstate"\nkey                  = "%s.tfstate"\n' \
    "$TFSTATE_RG" "$LAB" > "$TF_DIR/backend.hcl"
  az group create -n "$TFSTATE_RG" -l "$REGION" -o none
  local SA
  SA="$(python3 -c "import re;print(re.search(r'storage_account_name\s*=\s*\"([^\"]+)\"', open('$TF_DIR/backend.hcl').read()).group(1))")"
  if [ "$SA" = "purpleforgetfstate" ] || ! az storage account show -n "$SA" -g "$TFSTATE_RG" -o none 2>/dev/null; then
    SA="pf$(openssl rand -hex 6)"      # 14 chars, lowercase alnum, globally unique
    echo "  creating storage account $SA"
    az storage account create -n "$SA" -g "$TFSTATE_RG" -l "$REGION" --sku Standard_LRS -o none \
      || die "storage account create failed"
    # patch backend.hcl in place so re-runs (and terraform init) reuse it
    sed -i "s|storage_account_name = .*|storage_account_name = \"$SA\"|" "$TF_DIR/backend.hcl"
  else
    echo "  reusing storage account $SA"
  fi
  az storage container create -n tfstate --account-name "$SA" -o none 2>/dev/null || true
  # Bind by account key so `init` doesn't hang for minutes waiting on fresh RBAC.
  ARM_ACCESS_KEY="$(az storage account keys list -n "$SA" -g "$TFSTATE_RG" --query "[0].value" -o tsv)"
  export ARM_ACCESS_KEY
}

# ---- pick a valid, cheap SKU + open bastion SSH to just this host -----------
pick_sizes() {
  log "2. VM sizing (auto — cheapest unrestricted SKU in $REGION)"
  local sizes_file="$TF_DIR/sizes.auto.tfvars.json"
  local MY_IP SIZE
  MY_IP="$(curl -s https://api.ipify.org || true)"
  [ -n "$MY_IP" ] || { warn "could not detect your public IP; bastion SSH will be closed — set bastion_ssh_allowed_cidrs by hand"; MY_IP=""; }

  SIZE="$(az vm list-skus --location "$REGION" --resource-type virtualMachines --all -o json 2>/dev/null \
    | SKU_PREF="${SKU_CANDIDATES[*]}" REGION="$REGION" python3 -c '
import json,sys,os
try:
    data=json.load(sys.stdin)
except Exception:
    print(""); sys.exit(0)
region=os.environ["REGION"].lower()
avail=set()
for s in data:
    if s.get("resourceType")!="virtualMachines": continue
    if region not in [l.lower() for l in s.get("locations",[])]: continue
    # a SKU is usable only if it has NO location/zone restrictions here
    if any(r for r in (s.get("restrictions") or [])): continue
    avail.add(s["name"])
for p in os.environ["SKU_PREF"].split():
    if p in avail:
        print(p); break
' )"
  # PF_VM_SIZE (if exported) wins over auto-detect — lets any deployer force a
  # SKU their own account/region supports without editing the lab.
  SIZE="${PF_VM_SIZE:-$SIZE}"
  if [ -z "$SIZE" ]; then
    SIZE="Standard_F1as_v7"
    warn "SKU auto-detect found nothing unrestricted (or the az vm module is unavailable here); defaulting to $SIZE, a broadly-available cheap 1-vCPU SKU. If your account/region does not offer it, export PF_VM_SIZE=<sku> and re-run (AZURE-DEPLOY-RUNBOOK.md step 2)."
  fi
  echo "  chosen SKU (all VMs): $SIZE"

  SIZE="$SIZE" BASTION_CIDR="${MY_IP:+${MY_IP}/32}" python3 - "$sizes_file" <<'PY'
import json,os,sys
size=os.environ["SIZE"]
cidr=os.environ.get("BASTION_CIDR","")
doc={
  "bastion_size": size,
  "vm_size_overrides": {r: size for r in {{ roles_json }}},
  "bastion_ssh_allowed_cidrs": ([cidr] if cidr else []),
}
open(sys.argv[1],"w").write(json.dumps(doc,indent=2)+"\n")
PY
  echo "  wrote $sizes_file"

  # Make the (possibly PF_REGION-overridden) region flow into terraform,
  # overriding the location baked into terraform.tfvars.json at generate time.
  # When PF_REGION is unset this equals the spec region, so it is a harmless no-op.
  printf '{\n  "location": "%s"\n}\n' "$REGION" > "$TF_DIR/region.auto.tfvars.json"
  echo "  wrote $TF_DIR/region.auto.tfvars.json (location=$REGION)"
}

# ---- optional image override (PF_OS / PF_IMAGE_* ) --------------------------
# Same idiom as pick_sizes: turn the PF_* env vars into an auto.tfvars overlay
# that overrides the os/image baked into terraform.tfvars.json at generate time,
# applied to EVERY Windows VM (all roles). No override env set => remove any
# stale overlay so a plain re-run reverts to the generate-time images.
pick_images() {
  log "2b. Image override (PF_OS / PF_IMAGE_*)"
  local images_file="$TF_DIR/images.auto.tfvars.json"
  if [ -z "${PF_OS:-}" ] && [ -z "${PF_IMAGE_ID:-}" ] && [ -z "${PF_IMAGE_SKU:-}" ] \
     && [ -z "${PF_IMAGE_PUBLISHER:-}" ] && [ -z "${PF_IMAGE_OFFER:-}" ] && [ -z "${PF_IMAGE_VERSION:-}" ]; then
    rm -f "$images_file"
    echo "  no image override — using the images baked at generate time"
    return 0
  fi
  ROLES_JSON='{{ roles_json }}' python3 - "$images_file" <<'PY'
import json, os, sys
roles = json.loads(os.environ["ROLES_JSON"])
def env(k):
    v = os.environ.get(k, "").strip()
    return v or None
os_key   = env("PF_OS")
image_id = env("PF_IMAGE_ID")
pub, off, sku = env("PF_IMAGE_PUBLISHER"), env("PF_IMAGE_OFFER"), env("PF_IMAGE_SKU")
ver      = env("PF_IMAGE_VERSION")
doc = {}

# A full marketplace triple defines/overrides a custom image entry, keyed by
# PF_OS if given (else a synthetic key), and forces every role onto it.
if pub and off and sku:
    key = os_key or "__pf_custom_image__"
    doc["custom_os_images"] = {key: {"publisher": pub, "offer": off, "sku": sku}}
    doc["os_overrides"] = {r: key for r in roles}
elif any([pub, off, sku]):
    sys.stderr.write("PF_IMAGE_PUBLISHER/OFFER/SKU must all be set together — ignoring the partial set\n")

# A stock os key (no custom triple) just remaps every role to it.
if os_key and "os_overrides" not in doc:
    doc["os_overrides"] = {r: os_key for r in roles}

# A custom managed-image / SIG version wins over any os for every role.
if image_id:
    doc["image_id_overrides"] = {r: image_id for r in roles}

if ver:
    doc["image_version_override"] = ver

open(sys.argv[1], "w").write(json.dumps(doc, indent=2) + "\n")
print("  wrote " + sys.argv[1] + ": " + json.dumps(doc))
PY
}

# ---- terraform apply (with the flags the runbook proved necessary) ----------
tf_apply() {
  log "3. terraform init + apply"
  terraform -chdir="$TF_DIR" init -backend-config=backend.hcl -input=false -reconfigure \
    || die "terraform init failed"
  local tries=0 max=6 applog
  applog="$(mktemp)"
  # -refresh=false + -parallelism=1 dodge ARM read-after-write lag; retrying makes
  # real progress (imported/created resources persist) — it is not spinning.
  until terraform -chdir="$TF_DIR" apply -auto-approve -input=false -refresh=false -parallelism=1 2>&1 | tee "$applog"; do
    tries=$((tries+1))
    [ "$tries" -ge "$max" ] && { rm -f "$applog"; die "terraform apply still failing after $tries tries — see the error above (AZURE-DEPLOY-RUNBOOK.md step 4)"; }
    # Self-heal the recurring 'already exists' state drift: a resource that lives
    # in Azure but not in state (typically a VM ansible-prep extension left by a
    # prior interrupted apply). With -refresh=false terraform would otherwise
    # keep trying to CREATE it forever; instead import each (address, id) pair
    # parsed from the error and retry.
    if grep -q "already exists - to be managed via Terraform" "$applog"; then
      while IFS=$'\t' read -r addr id; do
        [ -n "$addr" ] && [ -n "$id" ] || continue
        echo "  auto-importing drifted resource into state: $addr"
        terraform -chdir="$TF_DIR" import "$addr" "$id" >/dev/null 2>&1 \
          || warn "auto-import of $addr failed — may need a manual terraform import"
      done < <(python3 - "$applog" <<'PY'
import re, sys
pending_id = None
for ln in open(sys.argv[1]):
    m = re.search(r'A resource with the ID "([^"]+)" already exists', ln)
    if m:
        pending_id = m.group(1); continue
    if pending_id:
        m2 = re.search(r'with (\S.*?),\s*$', ln)
        if m2:
            print(f"{m2.group(1)}\t{pending_id}"); pending_id = None
PY
)
      warn "apply hit state drift (attempt $tries/$max) — auto-imported the pre-existing resource(s), retrying"
    else
      warn "apply failed (attempt $tries/$max) — retrying in 15s (transient ARM lag is expected on some subscriptions)"
      sleep 15
    fi
  done
  rm -f "$applog"
  echo "  apply complete"
}

# ---- WireGuard tunnel (the only path into the lab) --------------------------
wg_up() {
  log "4. WireGuard tunnel to the bastion"
  mkdir -p "$TF_DIR/ssh_keys"
  cd "$TF_DIR"
  # The in-VM provisioner that writes ssh_keys/bastion.pem doesn't always fire
  # (imports skip provisioners); pull the key straight from state as a fallback.
  if [ ! -s ssh_keys/bastion.pem ]; then
    terraform -chdir="$TF_DIR" show -json | python3 -c '
import json,sys
d=json.load(sys.stdin)
for r in d.get("values",{}).get("root_module",{}).get("resources",[]):
    if r.get("address")=="tls_private_key.bastion_ssh":
        sys.stdout.write(r["values"]["private_key_pem"])
' > ssh_keys/bastion.pem
    chmod 600 ssh_keys/bastion.pem
  fi
  local BASTION_IP CLIENT_PUB SERVER_PUB
  BASTION_IP="$(terraform -chdir="$TF_DIR" output -raw bastion_public_ip)"
  [ -n "$BASTION_IP" ] || die "no bastion_public_ip output — did apply finish?"
  [ -f ssh_keys/client_wg.key ] || wg genkey | tee ssh_keys/client_wg.key | wg pubkey > ssh_keys/client_wg.pub
  CLIENT_PUB="$(cat ssh_keys/client_wg.pub)"
  local SSH="ssh -o StrictHostKeyChecking=no -o ConnectTimeout=20 -i ssh_keys/bastion.pem purpleforge@$BASTION_IP"
  # bastion boot + cloud-init can lag; wait for it to answer.
  local i=0; until $SSH true 2>/dev/null; do i=$((i+1)); [ "$i" -ge 20 ] && die "bastion SSH never came up at $BASTION_IP (check bastion_ssh_allowed_cidrs includes your IP)"; sleep 15; done
  SERVER_PUB="$($SSH 'sudo cat /etc/wireguard/publickey')"
  $SSH "sudo wg set wg0 peer $CLIENT_PUB allowed-ips 10.250.250.2/32 && sudo wg-quick save wg0"
  cat > ssh_keys/pf-lab.conf <<EOF
[Interface]
PrivateKey = $(cat ssh_keys/client_wg.key)
Address = 10.250.250.2/32
[Peer]
PublicKey = $SERVER_PUB
Endpoint = $BASTION_IP:$WG_PORT
AllowedIPs = 10.250.250.0/24, $SUPERNET
PersistentKeepalive = 25
EOF
  sudo wg-quick down "$TF_DIR/ssh_keys/pf-lab.conf" 2>/dev/null || true
  sudo wg-quick up "$TF_DIR/ssh_keys/pf-lab.conf" || die "wg-quick up failed"
  cd "$LAB_DIR"
  echo "  tunnel up (bastion $BASTION_IP:$WG_PORT)"
}

# ---- Ansible control node in Docker (Python 3.10 GOAD needs) ----------------
ansible_up() {
  log "5. Ansible control node (Docker, --network host to see the tunnel)"
  docker rm -f pf-ansible >/dev/null 2>&1 || true
  docker run -d --name pf-ansible --network host -v "$REPO:/repo" \
    -w "/repo/generated/$LAB/ansible" python:3.10-slim sleep infinity >/dev/null \
    || die "could not start the pf-ansible container"
  docker exec pf-ansible bash -c "pip install --quiet ansible-core==2.12.6 pywinrm rich psutil Jinja2 pyyaml ansible_runner" \
    || die "pip install in pf-ansible failed"
  docker exec pf-ansible bash -c "ansible-galaxy collection install ansible.windows:1.11.0 community.windows:1.11.0 chocolatey.chocolatey" \
    || die "ansible-galaxy collection install failed"
  # community.general (unpinned) breaks ansible-core 2.12's galaxy client — pinned tarball instead.
  docker exec pf-ansible python3 -c "import urllib.request; urllib.request.urlretrieve('https://galaxy.ansible.com/api/v3/plugin/ansible/content/published/collections/artifacts/community-general-6.6.2.tar.gz','/tmp/cg.tar.gz')" \
    && docker exec pf-ansible ansible-galaxy collection install /tmp/cg.tar.gz || warn "community.general install failed (only some roles need it) — continuing"
}

# ---- provision AD (site.yml enforces hardening-before-vulns order) ----------
run_site() {
  log "6. Provision AD -> population -> hardening -> vuln injection (site.yml)"
  # WinRM can lag while VMs finish first boot; wait, don't fail hard.
  local i=0
  until docker exec -w "/repo/generated/$LAB/ansible" pf-ansible ansible all -i inventory/hosts.yml -m ansible.windows.win_ping >/dev/null 2>&1; do
    i=$((i+1)); [ "$i" -ge 20 ] && { warn "win_ping never went green for every host — running site.yml anyway (it will retry)"; break; }
    echo "  waiting for WinRM on all hosts ($i)..."; sleep 20
  done
  local tries=0 max=6
  # site.yml is idempotent; a heavy PowerShell step OR the DC-promotion reboot
  # ends an attempt mid-run — re-run. The pf-ansible container can also vanish
  # between attempts (a host docker hiccup); recreate it if it is gone so the
  # retry actually runs instead of erroring 'No such container: pf-ansible'.
  until docker exec -w "/repo/generated/$LAB/ansible" pf-ansible ansible-playbook -i inventory/hosts.yml playbooks/site.yml; do
    tries=$((tries+1))
    [ "$tries" -ge "$max" ] && die "site.yml still failing after $tries runs — inspect the error above (AZURE-DEPLOY-RUNBOOK.md step 7)"
    warn "site.yml failed (attempt $tries/$max) — re-running (idempotent; picks up where it left off)"
    docker exec pf-ansible true >/dev/null 2>&1 || { warn "pf-ansible container is gone — recreating it before the next attempt"; ansible_up; }
    sleep 15
  done
  echo "  provisioning complete"
}

main() {
  preflight
  ensure_secrets
  bootstrap_state
  pick_sizes
  pick_images
  if [ "${1:-}" = "--sizes-only" ]; then log "done (--sizes-only)"; exit 0; fi
  tf_apply
  wg_up
  ansible_up
  run_site
  log "DEPLOY COMPLETE — $LAB"
  cat <<EOF

Next steps (no AI):
  # confirm the injected vulnerabilities are applied + exploitable:
  python3 "$REPO/scripts/forge.py" validate "{{ spec_rel }}" --run
  # verify the live domain matches the plan (users/groups/NT hashes):
  python3 "$REPO/scripts/forge.py" ad-inventory "{{ spec_rel }}"

When finished, tear everything down to cost-zero:
  ./teardown.sh
EOF
}

main "$@"
