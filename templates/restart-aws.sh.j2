#!/usr/bin/env bash
# =============================================================================
# GENERATED by forge — DO NOT edit by hand (regenerated on every
# `forge generate`). RESTARTS (reboots) every EC2 instance in {{ lab_name }} on
# AWS/{{ region }} — the unstick button for a hung/blocked machine (WinRM
# wedged, a stuck update, a frozen DC promotion). It does a POWER reboot, NOT a
# snapshot rollback: no EBS/AD state is lost. For a pristine lab instead, use
# `forge reset {{ spec_rel }}` (restores the clean-state AMI).
#
#   ./restart.sh            # reboot every EC2 instance in the lab
#
# A reboot only works on a RUNNING instance. If an instance is stopped, resume
# the lab with `forge deploy {{ spec_rel }}` (deploy.sh starts stopped VMs).
#
# Credentials/region resolve exactly like deploy.sh (env vars / AWS_PROFILE /
# 'aws sso login'; PF_REGION overrides the region).
# =============================================================================
set -uo pipefail

LAB="{{ lab_name }}"
REGION="${PF_REGION:-{{ region }}}"

cd "$(dirname "$0")"
export AWS_DEFAULT_REGION="$REGION"

log()  { printf '\n\033[1;35m== %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mWARN:\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31mFAIL:\033[0m %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing prerequisite: $1"; }

preflight() {
  log "0. Preflight"
  for b in aws; do need "$b"; done
  aws sts get-caller-identity >/dev/null 2>&1 \
    || die "AWS credentials not usable: configure env vars / AWS_PROFILE / 'aws sso login'"
  echo "  account: $(aws sts get-caller-identity --query Account --output text)   region: $REGION"
}

# ---- reboot every running instance tagged for this lab ----------------------
# reboot-instances is a no-op on a stopped instance (resume via deploy.sh).
restart_vms() {
  log "1. Rebooting every EC2 instance in $LAB"
  local ids
  ids="$(aws ec2 describe-instances \
          --filters "Name=tag:lab,Values=$LAB" "Name=instance-state-name,Values=running" \
          --query 'Reservations[].Instances[].InstanceId' --output text 2>/dev/null || true)"
  [ -z "$ids" ] && die "no running instances tagged lab=$LAB — stopped? resume with 'forge deploy {{ spec_rel }}' (nothing to reboot)"
  echo "  rebooting: $ids"
  aws ec2 reboot-instances --instance-ids $ids >/dev/null 2>&1 || warn "reboot-instances failed — reboot them manually"
}

preflight
restart_vms
log "RESTART complete — $LAB instances rebooted. Give WinRM/SSH ~1-2 min to come back."
