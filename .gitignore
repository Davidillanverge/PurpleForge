# PurpleForge — generated lab artifacts are the RESULT of running the harness,
# not part of it: everything under generated/<lab>/ is derived and fully
# reproducible from specs/<lab>.yml via `forge.py generate`. It is never
# versioned — regenerate it, don't commit it.
generated/

# A top-level specs/<lab>.yml is usage output too — what you get from using the
# harness (write by hand or via /new-lab), reproducible and disposable. Only the
# schema (specs/schema/) and the two committed smoke-test specs are versioned.
specs/*.yml
!specs/winrm-validate-lab.yml
!specs/mssql-weak-sa-lab.yml

# Terraform
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ansible
*.retry
.ansible/

# Secrets / credentials the harness may emit
lab-manifest.json
*.pem
*.ppk
*key*.json
!specs/**/*.json
.env
.env.*

# Python
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local settings (personal overrides, not shared config)
.claude/settings.local.json
