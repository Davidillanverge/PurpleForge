# PurpleForge — plantilla de credenciales deploy-time. Copia a `.env` y rellena:
#   cp .env.example .env && $EDITOR .env
# Cargar antes de desplegar:  set -a; source .env; set +a; unset AWS_PROFILE
# `.env` está gitignored (NUNCA se commitea); esta plantilla sí se versiona.

# --- AWS (Terraform apply + backend S3/DynamoDB) ---
# Opción A: perfil del AWS CLI/SDK.  OJO: déjalo SIN definir (no AWS_PROFILE= vacío)
# si usas claves explícitas — un string vacío rompe el CLI con
# "config profile () could not be found" (de ahí el `unset AWS_PROFILE`).
#AWS_PROFILE=
AWS_REGION=eu-west-1
# Opción B: claves explícitas
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=

# --- Elastic (telemetría DETECT: Agent EDR + SIEM, enrolamiento vía Fleet) ---
# Ver TELEMETRY-DEPLOY-RUNBOOK.md §2-3.
PF_FLEET_URL=
PF_FLEET_ENROLLMENT_TOKEN=
PF_ELASTIC_AGENT_VERSION=9.5.4
#PF_FLEET_INSECURE=true          # solo si el Fleet es self-hosted con CA self-signed

# --- Cloudflare WARP (telemetría DETECT: SWG, service-token enroll) ---
PF_CLOUDFLARE_TEAM=
PF_CLOUDFLARE_ENROLL_CLIENT_ID=
PF_CLOUDFLARE_ENROLL_CLIENT_SECRET=

# --- Microsoft Defender for Endpoint (telemetría DETECT: edr microsoft-defender) ---
# Ruta EN ESTA MÁQUINA al script de onboarding local de Windows de TU tenant,
# descargado del portal de Defender (Settings > Endpoints > Onboarding >
# OS Windows Server > Local Script > Download package, descomprimir el .zip).
# deploy.sh lo copia a generated/<lab>/ansible/files/mde/ (gitignored) y el rol
# pf_mde lo ejecuta en cada host Windows. OJO: contiene un blob específico de tu
# tenant (une los equipos a TU organización real de Defender) — trátalo como un
# secreto. Ver TELEMETRY-DEPLOY-RUNBOOK.md §3c.
MDE_WIN_ONBOARDING_PATH=

# --- MITRE Caldera (BAS: sandcat beacon) — ver BAS-DEPLOY-RUNBOOK.md ---
# Cloud Caldera: URL pública/enrutable. Kali local: la IP del túnel WireGuard
# (`ip -4 addr show pf-lab`), p.ej. http://10.11.0.2:8888  — NO 127.0.0.1.
PF_CALDERA_SERVER=
PF_CALDERA_GROUP=red
#PF_CALDERA_API_KEY=             # solo si el endpoint de descarga está autenticado
