# PurpleForge — plantilla de configuración. Copia a `.env` y rellena:
#   cp .env.example .env && $EDITOR .env
# `.env` está gitignored (NUNCA se commitea); esta plantilla sí se versiona.
#
# Dos usos del mismo fichero:
#   1) Servicio de agentes (API + UI + agentes):  docker compose up -d --build
#      compose lo carga en el contenedor `app` (env_file) e interpola las variables de compose.
#   2) Harness determinista desde tu shell (forge deploy, runbooks):
#      set -a; source .env; set +a; unset AWS_PROFILE
#
# Los secretos de despliegue (bloque B) sólo llegan a herramientas del agente
# deploy-operator: el resto de agentes los recibe filtrados (agents/tools.py scrub_env).

# =============================================================================
# A) SERVICIO DE AGENTES
# =============================================================================

# --- Obligatorios ------------------------------------------------------------
# Contraseña de Postgres (compose crea la BD y construye PF_DATABASE_URL con ella).
POSTGRES_PASSWORD=
# Cifra en reposo las API keys de proveedores guardadas en BD (>= 32 chars aleatorios).
# Si la cambias, las keys ya guardadas dejan de poder descifrarse (vuelve a introducirlas).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PF_SECRET_KEY=
# Tokens de acceso (JSON token -> usuario). El usuario es el actor "user:<id>" que firma
# aprobaciones de despliegue. Tokens >= 24 chars; genera uno por persona:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vacío = nadie puede entrar (401). Ejemplo: PF_API_TOKENS={"<token>": "david", "<otro>": "ana"}
PF_API_TOKENS=

# --- Compose -----------------------------------------------------------------
#PF_PORT=8000                       # publicado SOLO en 127.0.0.1 (pon un proxy TLS delante para exponerlo)
#PF_WORKERS=2                       # workers de uvicorn (>1 exige Redis: compose ya lo trae)
#PF_UID=10001                       # uid/gid del usuario del contenedor; en Linux pon los tuyos
#PF_GID=10001                       #   para que pueda escribir en ./generated y ./specs

# --- Proveedores LLM (src/llm/) — valores por defecto si el tenant no configura los suyos en la UI
# Orden de failover (anthropic | gemini | ollama). Un proveedor con key sin configurar se omite.
PF_LLM_PROVIDERS=anthropic,ollama
ANTHROPIC_API_KEY=
#PF_LLM_ANTHROPIC_MODEL=claude-sonnet-5-5   # acepta alias: opus | sonnet | haiku
#PF_LLM_ANTHROPIC_BASE_URL=
#PF_LLM_ANTHROPIC_TIMEOUT=120
# Google Gemini (añade "gemini" a PF_LLM_PROVIDERS). También acepta GOOGLE_API_KEY / PF_LLM_GEMINI_API_KEY.
#GEMINI_API_KEY=
#PF_LLM_GEMINI_MODEL=gemini-flash-latest
#PF_LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
#PF_LLM_GEMINI_TIMEOUT=600
# En compose apunta por defecto al Ollama del host (host.docker.internal:11434).
#PF_LLM_OLLAMA_BASE_URL=http://localhost:11434
#PF_LLM_OLLAMA_MODEL=qwen3:8b
#PF_LLM_OLLAMA_TIMEOUT=300
#PF_LLM_OLLAMA_NUM_CTX=32768        # ventana de contexto: el default de Ollama es pequeño y TRUNCA en silencio
#PF_LLM_MAX_RETRIES=2               # reintentos por proveedor ante errores transitorios
#PF_LLM_BACKOFF_BASE=1.0            # backoff exponencial: base * 2^intento (s)
#PF_LLM_BACKOFF_MAX=20.0
#PF_LLM_COOLDOWN_SECONDS=60         # un proveedor caído se salta durante este tiempo
#PF_LLM_MAX_RETRY_AFTER=120         # espera máx. que se respeta de un 429/503 (Retry-After); más → failover

# --- Base de datos (src/db/) — compose la fija; esto es para ejecutar fuera de Docker
#PF_DATABASE_URL=postgresql+asyncpg://purpleforge:<password>@localhost:5432/purpleforge
#PF_DATABASE_ECHO=false
#PF_DATABASE_POOL_SIZE=5
#PF_DATABASE_MAX_OVERFLOW=10

# --- API / runtime (src/api/) --------------------------------------------------
#PF_AUTO_MIGRATE=true               # alembic upgrade head al arrancar (con advisory lock)
#PF_AUTH_DISABLED=false             # SOLO dev local: todas las peticiones son el usuario "dev"
#PF_DEFAULT_TENANT=default
#PF_REPO_ROOT=/app                  # árbol del harness que usan forge y los agentes
#PF_APPROVAL_TIMEOUT_SECONDS=3600   # una aprobación pendiente caduca (= denegada)
#PF_FORGE_TIMEOUT_SECONDS=600       # timeout de compile/guardrail lanzados desde la API
#PF_SSE_HEARTBEAT_SECONDS=15
#PF_DB_WAIT_SECONDS=60              # al arrancar, espera a que BD/Redis acepten conexiones
#PF_REDIS_URL=                      # compose la fija; vacío = broker en memoria (1 worker)
#PF_WORKER_HEARTBEAT_SECONDS=10     # un worker se da por muerto tras 3 latidos perdidos
#PF_ORPHAN_GRACE_SECONDS=60         # el barrido nunca falla runs más jóvenes que esto
#PF_LOG_LEVEL=INFO

# =============================================================================
# B) CREDENCIALES DE DESPLIEGUE (deploy-time; ver runbooks)
# =============================================================================

# --- AWS (Terraform apply + backend S3/DynamoDB) ---
# Opción A: perfil del AWS CLI/SDK.  OJO: déjalo SIN definir (no AWS_PROFILE= vacío)
# si usas claves explícitas — un string vacío rompe el CLI con
# "config profile () could not be found" (de ahí el `unset AWS_PROFILE`).
#AWS_PROFILE=
AWS_REGION=eu-west-1
# Opción B: claves explícitas
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=

# --- Elastic (telemetría DETECT: Agent EDR + SIEM, enrolamiento vía Fleet) ---
# Ver TELEMETRY-DEPLOY-RUNBOOK.md §2-3.
PF_FLEET_URL=
PF_FLEET_ENROLLMENT_TOKEN=
PF_ELASTIC_AGENT_VERSION=9.5.4
#PF_FLEET_INSECURE=true          # solo si el Fleet es self-hosted con CA self-signed

# --- Cloudflare WARP (telemetría DETECT: SWG, service-token enroll) ---
PF_CLOUDFLARE_TEAM=
PF_CLOUDFLARE_ENROLL_CLIENT_ID=
PF_CLOUDFLARE_ENROLL_CLIENT_SECRET=

# --- Microsoft Defender for Endpoint (telemetría DETECT: edr microsoft-defender) ---
# Ruta EN ESTA MÁQUINA al script de onboarding local de Windows de TU tenant,
# descargado del portal de Defender (Settings > Endpoints > Onboarding >
# OS Windows Server > Local Script > Download package, descomprimir el .zip).
# deploy.sh lo copia a generated/<lab>/ansible/files/mde/ (gitignored) y el rol
# pf_mde lo ejecuta en cada host Windows. OJO: contiene un blob específico de tu
# tenant (une los equipos a TU organización real de Defender) — trátalo como un
# secreto. Ver TELEMETRY-DEPLOY-RUNBOOK.md §3c.
MDE_WIN_ONBOARDING_PATH=

# --- MITRE Caldera (BAS: sandcat beacon) — ver BAS-DEPLOY-RUNBOOK.md ---
# Cloud Caldera: URL pública/enrutable. Kali local: la IP del túnel WireGuard
# (`ip -4 addr show pf-lab`), p.ej. http://10.11.0.2:8888  — NO 127.0.0.1.
PF_CALDERA_SERVER=
PF_CALDERA_GROUP=red
#PF_CALDERA_API_KEY=             # solo si el endpoint de descarga está autenticado
